[Unit]
Description=Claw OS — Agent Bridge (HTTP+SSE → system clawd)
Documentation=https://github.com/xiaoyu-work/claw-os
# Bridge belongs to the graphical session: it serves the desktop Agent
# app (com.clawos.Agent) and the Super+A overlay, both of which are
# only meaningful while the user is logged in graphically.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cos-agent-bridge
Restart=on-failure
RestartSec=3
# Default port = 0 (kernel-assigned). The authenticated endpoint is
# published inside a private runtime directory for launchers to discover.
# Override via drop-in if a fixed port is required.
Environment=COS_BIN=/usr/local/bin/cos
Environment=CLAWD_SOCKET=/run/cos/clawd.sock
RuntimeDirectory=cos-agent-bridge
RuntimeDirectoryMode=0700
UMask=0077
# Hardening: bridge is local-only. Voice transcription executes `cos`
# with the user's configured STT provider, so configuration/credentials
# are readable while mutable Agent data is limited to its own data/cache
# directories.
RestrictAddressFamilies=AF_UNIX AF_INET
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
# Discovery/audio staging plus the audit/provider state written by
# `cos model transcribe`. A leading `-` keeps first boot working before
# the optional data/cache directories exist.
ReadWritePaths=%t/cos-agent-bridge -%h/.local/share/cos -%h/.cache/cos

[Install]
WantedBy=graphical-session.target
