[Desktop Entry]
Type=Application
Version=1.5
Name=Yu OS Agent
GenericName=AI Assistant
Comment=Chat with the Yu OS system Agent
Exec=/usr/local/bin/cos-agent-ui
Icon=clawos-agent
Terminal=false
Categories=Utility;Office;Network;
StartupNotify=true
StartupWMClass=ClawOS-Agent
Keywords=ai;agent;chat;assistant;copilot;
X-GNOME-UsesNotifications=true
Actions=Nearby;

[Desktop Action Nearby]
Name=Nearby Sharing
Exec=/usr/local/bin/cos-agent-ui --nearby
Icon=network-transmit-receive
