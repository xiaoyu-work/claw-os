# /etc/xdg/mimeapps.list — system-wide default application bindings.
#
# Per XDG MIME-Apps spec, the [Default Applications] group binds a MIME
# type (or x-scheme-handler/<scheme>) to a .desktop AppID. Entries here
# are the **vendor defaults**; user choices in cosmic-settings →
# Default Applications override these by writing to
# $XDG_CONFIG_HOME/mimeapps.list, which takes priority.
#
# This file is dropped by rootfs/features/desktop (overlay) so that a
# freshly-installed ClawOS has sane vendor defaults for the common
# MIME types — web, mail, text, images, PDFs, archives, media — without
# the user having to "Open With → Always" the first time they
# encounter each file type.

[Default Applications]

# --- Web (Chromium) ---
x-scheme-handler/http=chromium.desktop
x-scheme-handler/https=chromium.desktop
x-scheme-handler/about=chromium.desktop
x-scheme-handler/unknown=chromium.desktop
text/html=chromium.desktop
application/xhtml+xml=chromium.desktop

# --- Mail (Thunderbird) ---
x-scheme-handler/mailto=thunderbird.desktop

# --- Text (cosmic-edit) ---
text/plain=com.clawos.Edit.desktop
text/markdown=com.clawos.Edit.desktop
text/x-markdown=com.clawos.Edit.desktop
application/json=com.clawos.Edit.desktop
application/x-yaml=com.clawos.Edit.desktop
text/x-yaml=com.clawos.Edit.desktop
text/x-shellscript=com.clawos.Edit.desktop
text/x-python=com.clawos.Edit.desktop
text/x-rust=com.clawos.Edit.desktop
text/x-c=com.clawos.Edit.desktop
text/x-c++src=com.clawos.Edit.desktop
text/x-java=com.clawos.Edit.desktop
text/x-go=com.clawos.Edit.desktop
text/css=com.clawos.Edit.desktop
text/javascript=com.clawos.Edit.desktop
application/javascript=com.clawos.Edit.desktop
application/xml=com.clawos.Edit.desktop
text/xml=com.clawos.Edit.desktop
application/toml=com.clawos.Edit.desktop

