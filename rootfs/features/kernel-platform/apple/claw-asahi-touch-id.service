[Unit]
Description=Activate owner-enabled Apple Touch ID
ConditionPathExists=/etc/claw-asahi/touch-id
After=systemd-udev-trigger.service
Before=fprintd.service

[Service]
Type=oneshot
RuntimeDirectory=claw-asahi-touch-id
RuntimeDirectoryMode=0700
ExecCondition=/usr/lib/cos/asahi/claw-asahi-touch-id check
ExecStart=/usr/sbin/modprobe apple_sep
ExecStartPost=/usr/lib/cos/asahi/claw-asahi-touch-id activate
RemainAfterExit=yes
TimeoutStartSec=90s
