[Unit]
Description=Claw OS — System Agent Daemon (clawd)
Documentation=https://github.com/xiaoyu-work/claw-os
After=basic.target

[Service]
Type=simple
Group=sudo
UMask=0077
ExecStart=/usr/local/bin/clawd --socket /run/cos/clawd.sock
Restart=on-failure
RestartSec=3
KillMode=control-group
Environment=COS_BIN=/usr/local/bin/cos
Environment=COS_DATA_DIR=/var/lib/cos
Environment=COS_RUNTIME_DIR=/run/cos
Environment=COS_LOG_DIR=/var/log/cos
Environment=CLAWD_SOCKET=/run/cos/clawd.sock
Environment=CLAWD_SOCKET_MODE=0660
# Agent runtime isolation: the model/tool loop never runs in this
# process. clawd spawns /usr/local/bin/claw-agentd per task, dropped to
# the task owner with supplementary groups cleared, NoNewPrivs set, its
# own session/process group, and only a private job channel on fd 3.
# Dynamic App and MCP code runs one boundary farther out in
# /usr/local/bin/claw-extension-host. The host uses an exclusive unmapped uid
# and receives only per-task control and route-filtered proxy sockets.
# Tasks owned by root are refused: the runtime has no account to drop
# to. Set CLAWD_AGENTD=off to stop running agent tasks; every other
# clawd primitive keeps working.
Environment=CLAWD_AGENTD=on
Environment=COS_AGENTD_BIN=/usr/local/bin/claw-agentd
Environment=COS_EXTENSION_HOST_BIN=/usr/local/bin/claw-extension-host
Environment=COS_EXTENSION_EXEC_GROUP=cos-extension
EnvironmentFile=-/etc/cos/extension-uids.conf
Environment=CLAWD_EXTENSION_HOST_NAMESPACES=on
Environment=CLAWD_AGENTD_MAX_WORKERS=4
Environment=CLAWD_AGENTD_LEASE_SECS=900
# System-vitals heartbeat: cheap reflex loop that samples kernel vitals,
# emits context.events on threshold crossings (the trigger engine turns
# matching ones into agent jobs), and drives cron/triggers ticks so no
# external systemd .timer is needed. Set CLAWD_HEARTBEAT=off to disable.
Environment=CLAWD_HEARTBEAT=on
Environment=CLAWD_HEARTBEAT_INTERVAL_SECS=60
RuntimeDirectory=cos
RuntimeDirectoryMode=0751
StateDirectory=cos
# 0711: traversable, never listable. An unprivileged claw-agentd worker
# walks through /var/lib/cos to its own /var/lib/cos/users/<uid> agent
# state, which clawd creates owned by that account with mode 0700. Every
# other subtree below stays 0700 root.
StateDirectoryMode=0711
LogsDirectory=cos
LogsDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
NoNewPrivileges=true
PrivateTmp=true
# Required for per-task cgroup-v2 CPU/memory/pids limits and cgroup.kill.
# clawd fails agent tasks closed if the delegated subtree is unavailable.
Delegate=yes

[Install]
WantedBy=multi-user.target
