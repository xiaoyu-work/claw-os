[Unit]
Description=Claw OS — set up agent-home OverlayFS
Documentation=https://github.com/xiaoyu-work/claw-os
DefaultDependencies=no
After=local-fs.target
Before=multi-user.target shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Reads an explicit admin/first-boot target from /etc/default/cos-home.
# When unset, the helper resolves an existing human user's passwd home;
# if no such user exists yet it defers without creating /home/cos.
EnvironmentFile=-/etc/default/cos-home
ExecStart=/usr/lib/cos/init/setup-home.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
