<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Claw OS</vendor>
  <vendor_url>https://github.com/xiaoyu-work/claw-os</vendor_url>

  <!--
    Lets the desktop driver wizard (cosmic-initial-setup) install the
    proprietary NVIDIA driver without itself running as root. The GUI runs
    `pkexec /usr/lib/cos/hw/gpu-setup install`; this action governs that
    elevation. Detection (`gpu-setup detect`) is read-only and needs no
    policy. auth_admin_keep so a single authentication covers the whole
    apt/DKMS run rather than re-prompting.
  -->
  <action id="org.clawos.gpu-setup.install">
    <description>Install GPU drivers</description>
    <message>Authentication is required to install GPU drivers</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/cos/hw/gpu-setup</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
