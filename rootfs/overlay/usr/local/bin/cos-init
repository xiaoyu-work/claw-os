#!/bin/bash
# cos-init — compatibility helper for non-systemd shells.
# Normal Claw OS images boot systemd, which starts clawd.service and
# cos-home-setup.service. This helper is kept for recovery/debug shells that
# intentionally bypass system boot.

set -e

# Source COS profile
[ -f /etc/cos/profile.sh ] && . /etc/cos/profile.sh

# Agent-home OverlayFS setup. Shared with cos-home-setup.service on normal
# system targets; the helper is idempotent and always exits 0
# (overlay failure is non-fatal — see the helper for details). The
# script resolves its target from $HOME (set by Docker for the running
# user — typically /root).
/usr/lib/cos/init/setup-home.sh

# Execute the requested command (default: bash --login)
exec "${@:-/bin/bash --login}"
