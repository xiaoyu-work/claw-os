{
  "schema": "claw.agent-api/v1",
  "id": "org.rclone",
  "name": "cloud",
  "title": {
    "en": "rclone cloud storage",
    "zh-CN": "rclone 云存储"
  },
  "summary": {
    "en": "List, size and copy between configured rclone remotes (Drive, S3, Dropbox, OneDrive, WebDAV, ...).",
    "zh-CN": "列出 / 计算大小 / 复制已配置的 rclone 远端（Drive、S3、Dropbox、OneDrive、WebDAV 等）。"
  },
  "vendor": "claw-adapter",
  "license": "MIT",
  "homepage": "https://rclone.org/",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 120,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": false,
    "safety": "elevated",
    "origins": ["external-content"]
  }
}
