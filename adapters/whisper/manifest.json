{
  "schema": "claw.agent-api/v1",
  "id": "org.ggerganov.whisper",
  "name": "whisper",
  "title": {
    "en": "whisper.cpp speech-to-text",
    "zh-CN": "whisper.cpp 语音转文字"
  },
  "summary": {
    "en": "Transcribe audio files locally with the whisper.cpp ggml port.",
    "zh-CN": "用 whisper.cpp 在本地把音频转成文字。"
  },
  "vendor": "claw-adapter",
  "license": "MIT",
  "homepage": "https://github.com/ggerganov/whisper.cpp",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 600,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": true,
    "safety": "standard",
    "origins": ["external-content"]
  }
}
