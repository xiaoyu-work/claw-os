{
  "schema": "claw.agent-api/v1",
  "id": "org.syncthing",
  "name": "sync",
  "title": {
    "en": "Syncthing peer-to-peer sync",
    "zh-CN": "Syncthing 点对点同步"
  },
  "summary": {
    "en": "Inspect Syncthing folders / devices and trigger rescans via the bundled CLI.",
    "zh-CN": "通过 Syncthing 内置 CLI 查看共享目录 / 设备并触发重新扫描。"
  },
  "vendor": "claw-adapter",
  "license": "MPL-2.0",
  "homepage": "https://syncthing.net/",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 60,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": false,
    "safety": "standard",
    "origins": ["external-content"]
  }
}
