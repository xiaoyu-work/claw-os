{
  "schema": "claw.agent-api/v1",
  "id": "org.libarchive.bsdtar",
  "name": "archive",
  "title": {
    "en": "libarchive (bsdtar) archive toolkit",
    "zh-CN": "libarchive (bsdtar) 归档工具"
  },
  "summary": {
    "en": "List, extract and create tar/zip/7z archives via bsdtar (libarchive).",
    "zh-CN": "用 bsdtar (libarchive) 查看、解压、打包 tar/zip/7z 归档。"
  },
  "vendor": "claw-adapter",
  "license": "BSD-2-Clause",
  "homepage": "https://www.libarchive.org/",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 600,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": false,
    "safety": "standard",
    "origins": ["external-content"]
  }
