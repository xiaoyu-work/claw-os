{
  "schema": "claw.agent-api/v1",
  "id": "org.libreoffice.headless",
  "name": "libreoffice",
  "title": {
    "en": "LibreOffice headless converter",
    "zh-CN": "LibreOffice 无头转换"
  },
  "summary": {
    "en": "Convert office documents (docx/xlsx/odt/pptx/etc.) using LibreOffice in headless mode.",
    "zh-CN": "用 LibreOffice 无头模式把 docx/xlsx/odt/pptx 等转换为别的格式。"
  },
  "vendor": "claw-adapter",
  "license": "MPL-2.0",
  "homepage": "https://www.libreoffice.org/",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 600,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": false,
    "safety": "standard",
    "origins": ["external-content"]
  }
}
