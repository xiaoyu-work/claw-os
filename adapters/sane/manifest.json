{
  "schema": "claw.agent-api/v1",
  "id": "org.sane",
  "name": "scan",
  "title": {
    "en": "SANE scanner toolkit",
    "zh-CN": "SANE 扫描仪工具"
  },
  "summary": {
    "en": "List SANE-compatible scanners and capture images via scanimage.",
    "zh-CN": "列出 SANE 兼容扫描仪，并通过 scanimage 采集图像。"
  },
  "vendor": "claw-adapter",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.sane-project.org/",
  "transport": "mcp+stdio",
  "command": "python3",
  "args": ["${manifest_dir}/main.py"],
  "env": {},
  "timeout_secs": 600,
  "enabled": true,
  "ai": {
    "callable_by_ai": true,
    "uses_ai_internally": false,
    "safety": "elevated",
    "origins": ["external-content"]
  }
}
