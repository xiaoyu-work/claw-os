FROM ghcr.io/xiaoyu-work/claw-os:latest

USER root

# Pre-install OpenClaw, then drop to cos so plugin/skill data lands under
# /home/cos with cos ownership (the runtime user reads from $HOME).
RUN npm install -g openclaw@latest
USER cos
RUN openclaw plugin install /usr/lib/cos/plugins/openclaw \
    && openclaw skill install /usr/lib/cos/skills/claw-os

ENTRYPOINT ["/usr/local/bin/cos-init"]
CMD ["openclaw", "gateway"]
