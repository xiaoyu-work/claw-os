#!/usr/bin/python3
"""Present existing OS reviews in the authenticated desktop, not on a VT."""

import json
import re
import signal
import subprocess

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk


COS = "/usr/local/bin/cos"
APPROVAL_HELPER = "/usr/local/bin/claw-approval-helper"
REVIEW_ID = re.compile(r"(?:rv-[a-f0-9]{32}|ap-[a-f0-9]{12}|pg-[a-f0-9]{32})")
LABELS = {
    "confirm_activation": "Open App",
    "confirm_install": "Confirm installation",
    "confirm_update": "Confirm update",
    "confirm_global_app_stop": "Confirm stopping Apps",
    "apply_choices": "Apply choice",
    "allow_once": "Allow once",
    "allow_session": "Allow for this session",
    "allow_forever": "Allow reusable access",
    "deny": "Deny",
    "restore": "Restore permission",
    "ask": "Ask",
}


class Reviews:
    def __init__(self):
        self.pending = None
        self.deferred = {}
        self.busy = False
        self.window = Gtk.Window(title="Claw OS permission review")
        self.window.set_default_size(580, 420)
        self.window.connect("delete-event", self.dismiss)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, border_width=16)
        self.window.add(box)
        self.title = Gtk.Label(xalign=0, wrap=True)
        box.pack_start(self.title, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.text = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll.add(self.text)
        box.pack_start(scroll, True, True, 0)
        self.status = Gtk.Label(xalign=0, wrap=True)
        box.pack_start(self.status, False, False, 0)
        self.choices = Gtk.ComboBoxText()
        self.choices.connect("changed", self.buttons)
        box.pack_start(self.choices, False, False, 0)
        buttons = Gtk.Box(spacing=10)
        box.pack_start(buttons, False, False, 0)
        self.later = Gtk.Button(label="Not now")
        self.later.connect("clicked", self.dismiss)
        buttons.pack_start(self.later, True, True, 0)
        self.deny = Gtk.Button(label="Deny")
        self.deny.connect("clicked", lambda *_: self.decide("cancel"))
        buttons.pack_start(self.deny, True, True, 0)
        self.confirm = Gtk.Button()
        self.confirm.get_style_context().add_class("suggested-action")
        self.confirm.connect("clicked", lambda *_: self.decide(self.action))
        buttons.pack_start(self.confirm, True, True, 0)

    def run(self, args, handler, data=None):
        self.busy = True
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
        if data is not None:
            flags |= Gio.SubprocessFlags.STDIN_PIPE
        try:
            child = Gio.Subprocess.new(args, flags)
        except GLib.Error:
            self.busy = False
            handler(None, "")
            return

        def finish(process, result):
            self.busy = False
            try:
                _, stdout, stderr = process.communicate_utf8_finish(result)
                handler(stdout if process.get_successful() else None, stderr)
            except GLib.Error:
                handler(None, "")

        child.communicate_utf8_async(data, None, finish)

    def poll(self):
        if not self.busy and self.pending is None:
            self.run([COS, "--json", "review", "pending"], self.inventory)
        return GLib.SOURCE_CONTINUE

    def inventory(self, output, _):
        if output is None:
            return
        rows = json.loads(output)["reviews"]
        now = GLib.get_monotonic_time()
        self.deferred = {key: when for key, when in self.deferred.items() if when > now}
        for item in rows:
            key = item["id"], item["revision"]
            if (item["status"] == "pending" and REVIEW_ID.fullmatch(key[0])
                    and key not in self.deferred and any(a != "cancel" for a in item["actions"])):
                self.run([COS, "--json", "review", "show", key[0]], self.present)
                break

    def present(self, output, disclosure):
        if output is None:
            return
        review = json.loads(output)
        actions = [action for action in review["actions"] if action != "cancel"]
        if review["status"] != "pending" or len(actions) != 1 or actions[0] not in LABELS:
            return
        self.action = actions[0]
        self.permission = None
        if self.action == "apply_choices":
            # The existing Root capability decision accepts exactly one selection.
            permissions = review["permissions"]
            if len(permissions) != 1 or not permissions[0]["supported_choices"]:
                return
            self.permission = permissions[0]
        self.pending = review
        self.status.set_text("")
        self.title.set_text(review["subject"]["name"])
        self.text.get_buffer().set_text(disclosure)
        self.choices.remove_all()
        if self.permission:
            for value in self.permission["supported_choices"]:
                if value in LABELS and not (value == "deny" and "cancel" in review["actions"]):
                    self.choices.append(value, LABELS[value])
        self.confirm.set_label(LABELS[self.action])
        self.window.show_all()
        self.choices.set_visible(self.permission is not None)
        self.buttons()
        self.later.grab_focus()

    def buttons(self, *_):
        ready = self.pending is not None and not self.busy
        self.later.set_sensitive(ready)
        self.deny.set_sensitive(ready and "cancel" in self.pending["actions"])
        self.choices.set_sensitive(ready)
        self.confirm.set_sensitive(ready and (self.permission is None or self.choices.get_active_id() is not None))

    def dismiss(self, *_):
        if self.pending is not None and not self.busy:
            key = self.pending["id"], self.pending["revision"]
            self.deferred[key] = GLib.get_monotonic_time() + 15 * GLib.USEC_PER_SEC
            self.pending = None
            self.window.hide()
        return True

    def decide(self, action):
        if self.busy or self.pending is None or action not in self.pending["actions"]:
            return
        choices = []
        if action == "apply_choices":
            choice = self.choices.get_active_id()
            if choice not in self.permission["supported_choices"]:
                return
            choices.append({"permission_id": self.permission["id"], "choice": choice})
        review_id = self.pending["id"]
        decision = {"id": review_id, "revision": self.pending["revision"], "action": action, "choices": choices}

        def refresh(output, _):
            self.run([COS, "--json", "review", "show", review_id],
                     lambda latest, text: self.settle(output is not None, latest, text))

        if action == "cancel":
            self.status.set_text("Cancelling the displayed request.")
            self.run([COS, "--json", "review", "deny", review_id, str(decision["revision"])], refresh)
        else:
            self.status.set_text("Authenticate to submit this decision.")
            self.run(["/usr/bin/pkexec", "--disable-internal-agent", APPROVAL_HELPER,
                      "--system-review-json"], refresh, json.dumps(decision))
        self.buttons()

    def settle(self, submitted, latest, disclosure):
        if latest is not None and json.loads(latest)["status"] != "pending":
            self.pending = None
            self.window.hide()
            return
        if latest is not None:
            self.present(latest, disclosure)
        self.status.set_text("The review is still pending." if submitted
                             else "The decision was not confirmed. Inspect the current request.")
        self.buttons()


def main():
    auth = subprocess.Popen(["/usr/libexec/polkit-mate-authentication-agent-1"])
    try:
        reviews = Reviews()

        def stop():
            Gtk.main_quit()
            return GLib.SOURCE_REMOVE

        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, stop)
        GLib.timeout_add_seconds(1, reviews.poll)
        Gtk.main()
    finally:
        auth.terminate()
        auth.wait(timeout=5)


if __name__ == "__main__":
    main()
