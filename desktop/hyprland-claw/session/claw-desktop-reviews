GLib.set_prgname("claw-desktop-reviews")
from gi.repository import Gdk, Gtk, Pango


COS = "/usr/local/bin/yu"
APPROVAL_HELPER = "/usr/local/bin/claw-approval-helper"
REVIEW_ID = re.compile(r"(?:rv-[a-f0-9]{32}|ap-[a-f0-9]{12}|pg-[a-f0-9]{32})")
CONFIRMATIONS = {
    "confirm_activation": (
        "Open {name}?", "Open app",
        "This lets the app start without granting any new access to your data or devices.",
    ),
    "confirm_install": (
        "Install {name}?", "Install app",
        "This lets Yu OS install the app. It does not grant the app permissions.",
    ),
    "confirm_update": (
        "Update {name}?", "Update app",
        "This lets Yu OS update the app. It does not grant new permissions.",
    ),
    "confirm_global_app_stop": (
        "Close all apps?", "Close all apps",
        "This system change needs to close apps for every user. Unsaved work may be lost.",
    ),
}
CHOICES = {
    "allow_once": "Allow once",
    "allow_session": "Allow for this session",
    "allow_forever": "Allow repeated use",
    "restore": "Remove block",
}
LIMIT_LABELS = {
    "allow_session": "Session grant ceiling",
    "allow_forever": "Reusable grant ceiling",
}
RESOURCE_COPY = {
    ("ui.panel", "All resources"): (
        "Show a desktop panel?",
        "This lets the requester show a panel above other windows. It does not grant access to your typing, clipboard, or screen.",
    ),
    ("ipc.invoke", "desktop.session.lock"): (
        "Lock this desktop?", "This lets the requester lock the desktop, but not unlock it.",
    ),
    ("ipc.subscribe", "notifications.presentation"): (
        "Read your notifications?", "This lets the requester see notifications shown on your desktop.",
    ),
    ("ipc.invoke", "notifications.presentation"): (
        "Manage desktop notifications?",
        "This lets the requester dismiss notifications, use their buttons, and change popup settings.",
    ),
}
