<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Yu OS</vendor>
  <action id="org.yuos.desktop.automatic-login">
    <description>Change automatic login</description>
    <message>Administrator authentication is required to change automatic login</message>
    <message xml:lang="zh-CN">更改开机自动登录需要管理员验证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.yuos.desktop.system-updates">
    <description>Manage Yu OS updates</description>
    <message>Administrator authentication is required to manage Yu OS updates</message>
    <message xml:lang="zh-CN">管理 Yu OS 系统更新需要管理员验证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.yuos.desktop.accounts">
    <description>Manage local user passwords and accounts</description>
    <message>Administrator authentication is required to change local user accounts</message>
    <message xml:lang="zh-CN">更改本地用户账号需要管理员验证</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
