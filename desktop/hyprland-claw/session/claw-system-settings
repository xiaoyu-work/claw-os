#!/usr/bin/python3 -I
"""Administrator authentication for closed actions from the system Settings GUI."""

import grp
import json
import os
from pathlib import Path
import pwd
import re
import subprocess
import sys

from gi.repository import Gio, GLib


LOGIN = "/usr/libexec/claw-desktop-login"
UPDATES = "/usr/libexec/claw-os-updates"
SERVICE = "org.freedesktop.login1"
ACCOUNT_ACTIONS = {"create-user", "set-user-password"}


def run(*command):
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True,
                            text=True, timeout=12, check=False)
    if result.returncode:
        raise ValueError(result.stderr.strip()[:1024] or "The system did not confirm the action")
    return result.stdout


def call(bus, name, path, interface, method, arguments, timeout=3000):
    return bus.call_sync(name, path, interface, method, arguments, None,
                         Gio.DBusCallFlags.NONE, timeout, None).unpack()


def properties(bus, path, interface):
    return call(bus, SERVICE, path, "org.freedesktop.DBus.Properties", "GetAll",
                GLib.Variant("(s)", (interface,)))[0]


def active_session(bus, uid):
    seat = properties(bus, "/org/freedesktop/login1/seat/seat0", SERVICE + ".Seat")
    session, path = seat["ActiveSession"]
    info = properties(bus, path, SERVICE + ".Session")
    if (info["User"][0] != uid or not info["Active"] or info["Remote"]
            or info["Service"] != "claw-desktop" or info["LockedHint"]):
        raise PermissionError("An active, unlocked local desktop is required")
    return session


def authorize(uid, session, action):
    # The sandbox lives outside the logind scope. Authenticate against the
    # installed session subscriber, never an App-supplied PID or a root leader.
    scope = Path(f"/sys/fs/cgroup/user.slice/user-{uid}.slice/session-{session}.scope")
    subscriber = Path("/usr/local/bin/claw-display-session")
    for pid in (pid for leaf in scope.glob("claw-login-*/cgroup.procs")
                for pid in leaf.read_text().split()):
        process = Path("/proc") / pid
        try:
            if not (process / "exe").samefile(subscriber):
                continue
            start = (process / "stat").read_text().rsplit(") ", 1)[1].split()[19]
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        result = subprocess.run(
            ("/usr/bin/pkcheck", "--action-id", "org.yuos.desktop." + action,
             "--process", f"{pid},{start},{uid}", "--allow-user-interaction"),
            stdin=subprocess.DEVNULL, timeout=75, check=False,
        )
        if result.returncode == 0:
            return
        raise PermissionError("Administrator authentication is required")
    raise PermissionError("The authenticated desktop session subscriber is unavailable")


def status(uid, queued=False):
    state = json.loads(run(LOGIN, "status"))
    state.update(json.loads(run(UPDATES, "status")))
    if queued:
        state["updates"]["busy"] = True
    state["current_user"] = pwd.getpwuid(uid).pw_name
    print(json.dumps(state))


def account_request(action):
    raw = sys.stdin.buffer.read(4097)
    if len(raw) > 4096:
        raise ValueError("Invalid account request")
    try:
        data = json.loads(raw)
    except (ValueError, UnicodeError):
        raise ValueError("Invalid account request") from None
    if not isinstance(data, dict) or set(data) != {"user", "full_name", "administrator", "uid", "password"}:
        raise ValueError("Invalid account request")
    name, password = data["user"], data["password"]
    if not isinstance(name, str) or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", name):
        raise ValueError("Invalid username")
    if (not isinstance(password, str) or not 0 < len(password.encode()) <= 256
            or any(ord(char) < 32 or 127 <= ord(char) <= 159 for char in password)):
        raise ValueError("Enter a non-empty password of up to 256 bytes")
    uid, full_name, admin = data["uid"], data["full_name"], data["administrator"]
    if action == "create-user":
        if (uid is not None or type(admin) is not bool or not isinstance(full_name, str)
                or len(full_name) > 128
                or any(char in ":," or ord(char) < 32 or 127 <= ord(char) <= 159 for char in full_name)):
            raise ValueError("Invalid new user details")
    elif type(uid) is not int or not 1000 <= uid < 60000 or full_name is not None or admin is not None:
        raise ValueError("Invalid password reset target")
    return data


def local_account(name):
    return next((int(fields[2]) for line in Path("/etc/passwd").read_text().splitlines()
                 if (fields := line.split(":"))[0] == name), None)


def manage_account(action, data):
    name = data["user"]
    if action == "create-user":
        home = f"/home/{name}"
        if os.path.lexists(home) or any(row.pw_name == name for row in pwd.getpwall()):
            raise ValueError("That username or home directory already exists")
        groups = ["claw-desktop-users"]
        if data["administrator"]:
            groups.append("sudo")
        for group in groups:
            grp.getgrnam(group)
        run("/usr/sbin/useradd", "--create-home", "--user-group", "--home-dir", home,
            "--shell", "/bin/bash", "--comment", data["full_name"],
            "--groups", ",".join(groups), "-K", "HOME_MODE=0700",
            "-K", "UID_MIN=1000", "-K", "UID_MAX=59999", "--", name)
        uid = local_account(name)
        if uid is None or not 1000 <= uid < 60000 or pwd.getpwnam(name).pw_dir != home:
            raise ValueError("Account was created but could not be verified; refresh Users")
    else:
        uid = data["uid"]
        if local_account(name) != uid:
            raise ValueError("The selected local account changed; refresh Users")
    # PAM receives only the new user's password; the admin password is handled by polkit.
    try:
        subprocess.run(
            ["/usr/sbin/chpasswd"], input=f"{name}:{data.pop('password')}\n".encode(),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15, check=True,
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        message = ("The account was created but its password was not confirmed. Refresh Users."
                   if action == "create-user" else "The password was not confirmed. Check the password policy.")
        raise ValueError(message) from None
    if local_account(name) != uid:
        raise ValueError("The password outcome could not be verified; refresh Users")
    print(json.dumps({"action": action, "status": "applied", "user": name, "uid": uid}))


def main(action, uid):
    jobs = {"check-updates": "check", "prepare-updates": "prepare"}
    update_actions = {
        "enable-automatic-updates": "automatic-on",
        "disable-automatic-updates": "automatic-off",
        "enable-automatic-restart": "restart-on",
        "disable-automatic-restart": "restart-off",
        "cancel-updates": "cancel",
    }
    if os.getuid() != 0 or not 1000 <= uid < 60000:
        raise PermissionError("Machine settings require the local desktop")
    if action == "status":
        status(uid)
        return
    if action not in {*jobs, *update_actions, *ACCOUNT_ACTIONS, "restart-for-updates", "enable-automatic-login",
                       "disable-automatic-login"}:
        raise ValueError("Invalid system settings action")
    account = account_request(action) if action in ACCOUNT_ACTIONS else None
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    session = active_session(bus, uid)
    if action != "check-updates":
        policy = ("accounts" if account is not None else
                  "automatic-login" if action.endswith("-automatic-login") else "system-updates")
        authorize(uid, session, policy)
        if active_session(bus, uid) != session:
            raise PermissionError("The desktop session changed")
    if account is not None:
        manage_account(action, account)
        return
    elif action in jobs:
        run("/usr/bin/systemctl", "start", "--no-block",
            f"claw-os-update-{jobs[action]}.service")
    elif action in update_actions:
        run(UPDATES, update_actions[action])
    elif action == "restart-for-updates":
        run(UPDATES, "reboot", session)
    elif action == "enable-automatic-login":
        run(LOGIN, "enable", str(uid))
    elif action == "disable-automatic-login":
        run(LOGIN, "disable")
    status(uid, queued=action in jobs)


if __name__ == "__main__":
    try:
        main(sys.argv[1], int(sys.argv[2]))
    except PermissionError as error:
        print(error, file=sys.stderr)
        sys.exit(3)
    except (OSError, GLib.Error, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
