#!/usr/bin/python3
"""Yu OS first-run setup and local sign-in account list."""

import json
import os
from pathlib import Path
import pwd
import re
import signal
import subprocess
import sys
import tempfile
import time
from zoneinfo import available_timezones


SHELL = "/usr/bin/quickshell"
CONFIG = "/usr/share/claw-os/oobe/shell.qml"
COS = "/usr/local/bin/yu"
DRIVERS = Path("/var/lib/cos/driver-setup/status.json")


def backend(completed, staging=None):
    import gi

    gi.require_version("NM", "1.0")
    from gi.repository import Gio, GLib, NM

    def send(**state):
        print(json.dumps(state), flush=True)

    class Setup:
        def __init__(self):
            self.loop = GLib.MainLoop()
            self.input = Gio.DataInputStream.new(Gio.UnixInputStream.new(0, False))
            self.nm = None
            self.wifi_signals = []
            self.networks = {}
            self.connecting = None
            self.connection = None
            self.child = None
            self.providers = {}
            self.oauth = None
            self.oauth_timer = 0
            self.signed_in = False

        def run(self):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop)
            self.watch_drivers()
            NM.Client.new_async(None, self.network_ready)
            if staging is not None:
                locales = subprocess.check_output(["/usr/bin/locale", "-a"], text=True).splitlines()
                send(languages=[item for item in locales if "_" in item and item.endswith(".utf8")],
                     zones=sorted(available_timezones()))
            self.read_request()
            try:
                self.loop.run()
            finally:
                if self.child is not None:
                    self.child.force_exit()

        def stop(self):
            self.loop.quit()
            return GLib.SOURCE_REMOVE

        def read_request(self):
            self.input.read_line_async(GLib.PRIORITY_DEFAULT, None, self.request)

        def request(self, stream, result):
            line, _ = stream.read_line_finish(result)
            if not line:
                self.stop()
                return
            self.read_request()
            try:
                message = json.loads(line)
                action = message.pop("action")
            except (ValueError, KeyError, TypeError, AttributeError):
                return
            if action == "scan":
                self.scan()
            elif action == "wifi":
                self.connect_wifi(message["network"], message["password"])
            elif action == "models":
                self.load_models()
            elif action == "signIn":
                self.sign_in()
            elif action == "cancelSignIn":
                self.end_sign_in()
            elif action == "saveModel":
                self.save_model(message)
            elif action == "finish":
                self.finish(message)

        def finish(self, message):
            if self.child is not None:
                send(finishError="busy")
                return
            if staging is None:
                try:
                    completed.parent.mkdir(parents=True, exist_ok=True)
                    completed.touch(mode=0o600)
                except OSError:
                    send(finishError="home")
                else:
                    send(finished=True)
                return

            try:
                profile = staging / "config/config.json"
                if profile.is_file():
                    records = (staging / "data/credentials/agent").glob("*.json")
                    message["agent"] = {
                        "config": json.loads(profile.read_bytes()),
                        "credentials": {file.name: json.loads(file.read_bytes()) for file in records},
                    }
                else:
                    message["agent"] = None
                flags = Gio.SubprocessFlags
                launcher = Gio.SubprocessLauncher.new(flags.STDIN_PIPE | flags.STDOUT_PIPE)
                # The greeter is a service account, not an interactive shell.
                launcher.unsetenv("SHELL")
                self.child = launcher.spawnv([
                    "/usr/bin/pkexec", "--disable-internal-agent", "/usr/libexec/claw-create-local-owner",
                ])
            except (OSError, ValueError, GLib.Error):
                send(finishError="setupFailed")
                return

            def finish_result(response):
                if response.get("finished") is True:
                    send(finished=True)
                else:
                    send(finishError=response.get("error", "setupFailed"))

            self.child.communicate_utf8_async(json.dumps(message), None, self.cos_result, finish_result)

        def watch_drivers(self):
            self.driver_monitor = None
            if DRIVERS.parent.is_dir():
                self.driver_monitor = Gio.File.new_for_path(str(DRIVERS.parent)).monitor_directory(
                    Gio.FileMonitorFlags.WATCH_MOVES, None
                )
                self.driver_monitor.connect("changed", lambda *_: self.update_drivers())
            self.update_drivers()

        def update_drivers(self):
            try:
                status = json.loads(DRIVERS.read_text())
            except (OSError, ValueError):
                status = {}
            send(driverState=status.get("state", "ready"), packages=status.get("packages", []))

        def network_ready(self, _source, result):
            try:
                self.nm = NM.Client.new_finish(result)
            except GLib.Error:
                send(networkState="unavailable")
                return
            self.nm.connect("notify::nm-running", lambda *_: self.update_connectivity())
            self.nm.connect("notify::connectivity", lambda *_: self.update_connectivity())
            self.nm.connect("notify::state", lambda *_: self.update_connectivity())
            self.nm.connect("notify::active-connections", lambda *_: self.update_connectivity())
            self.nm.connect("device-added", lambda *_: self.watch_wifi())
            self.nm.connect("device-removed", lambda *_: self.watch_wifi())
            self.update_connectivity()
            self.watch_wifi()

        def update_connectivity(self):
            states = {NM.ConnectivityState.FULL: "online", NM.ConnectivityState.PORTAL: "portal"}
            state = states.get(self.nm.get_connectivity(), "offline")
            if not self.nm.get_nm_running():
                state = "unavailable"
            elif state == "offline" and any(
                connection.get_connection_type() == "802-3-ethernet"
                and connection.get_state() == NM.ActiveConnectionState.ACTIVATED
                for connection in self.nm.get_active_connections()
            ):
                state = "wired"
            send(networkState=state)

        def wifi_devices(self):
            devices = self.nm.get_devices() if self.nm is not None else []
            return [device for device in devices if isinstance(device, NM.DeviceWifi)]

        def watch_wifi(self):
            for device, handler in self.wifi_signals:
                device.disconnect(handler)
            self.wifi_signals = [
                (device, device.connect("notify::last-scan", lambda *_: self.update_wifi()))
                for device in self.wifi_devices()
            ]
            self.scan()

        def scan(self):
            for device in self.wifi_devices():
                device.request_scan_async(None, self.scan_done)
            self.update_wifi()

        def scan_done(self, device, result):
            try:
                device.request_scan_finish(result)
            except GLib.Error:
                pass  # NetworkManager can reject a scan already in progress.
            self.update_wifi()

        def update_wifi(self):
            rows = {}
            devices = self.wifi_devices()
            for device in devices:
                for access_point in device.get_access_points():
                    ssid = access_point.get_ssid()
                    if ssid is None:
                        continue
                    name = NM.utils_ssid_to_utf8(ssid.get_data())
                    strength = access_point.get_strength()
                    if not name or (name in rows and rows[name]["strength"] >= strength):
                        continue
                    rows[name] = {
                        "name": name, "strength": strength,
                        "secure": "privacy" in access_point.get_flags().value_nicks,
                    }
                    self.networks[name] = (device, access_point)
            self.networks = {name: self.networks[name] for name in rows}
            send(hasWifi=bool(devices), networks=sorted(rows.values(), key=lambda row: -row["strength"]))

        def connect_wifi(self, name, password):
            if self.connecting is not None or name not in self.networks:
                return
            device, access_point = self.networks[name]
            profile = next((profile for profile in device.get_available_connections()
                            if access_point.connection_valid(profile)), None)
            if profile is not None and not password:
                self.connecting = (name, None)
                send(wifiState="connecting", wifiName=name)
                self.nm.activate_connection_async(profile, device, access_point.get_path(),
                                                  None, self.wifi_connected, False)
                return
            connection = NM.SimpleConnection.new()
            identity = NM.SettingConnection.new()
            identity.props.id = name
            identity.props.uuid = GLib.uuid_string_random()
            identity.props.type = "802-11-wireless"
            if staging is None:
                identity.add_permission("user", GLib.get_user_name(), None)
            connection.add_setting(identity)
            wireless = NM.SettingWireless.new()
            wireless.props.ssid = access_point.get_ssid()
            connection.add_setting(wireless)
            if "privacy" in access_point.get_flags().value_nicks:
                methods = set(access_point.get_rsn_flags().value_nicks + access_point.get_wpa_flags().value_nicks)
                mode = "wpa-psk" if "key-mgmt-psk" in methods else "sae" if "key-mgmt-sae" in methods else None
                if not mode or not password:
                    send(wifiState="passwordRequired")
                    return
                security = NM.SettingWirelessSecurity.new()
                security.props.key_mgmt = mode
                security.props.psk = password
                connection.add_setting(security)
            try:
                connection.verify()
            except GLib.Error:
                send(wifiState="failed")
                return
            self.connecting = (name, identity.props.uuid)
            send(wifiState="connecting", wifiName=name)
            self.nm.add_and_activate_connection_async(connection, device, access_point.get_path(),
                                                      None, self.wifi_connected, True)

        def wifi_connected(self, client, result, new_profile):
            try:
                active = (client.add_and_activate_connection_finish(result) if new_profile
                          else client.activate_connection_finish(result))
            except GLib.Error:
                self.connecting = None
                send(wifiState="failed")
                return
            handler = active.connect("notify::state", self.connection_changed)
            self.connection = (active, handler)
            self.connection_changed(active)

        def connection_changed(self, active, *_):
            state = active.get_state()
            if state not in (NM.ActiveConnectionState.ACTIVATED, NM.ActiveConnectionState.DEACTIVATED):
                return
            _, new_uuid = self.connecting
            _, handler = self.connection
            active.disconnect(handler)
            self.connection = None
            self.connecting = None
            if state == NM.ActiveConnectionState.DEACTIVATED and new_uuid is not None:
                failed_profile = self.nm.get_connection_by_uuid(new_uuid)
                if failed_profile is not None:
                    failed_profile.delete_async(None, None)
            send(wifiState="idle" if state == NM.ActiveConnectionState.ACTIVATED else "failed")

        def cos(self, args, callback, stdin=""):
            flags = Gio.SubprocessFlags
            try:
                launcher = Gio.SubprocessLauncher.new(
                    flags.STDIN_PIPE | flags.STDOUT_PIPE | flags.STDERR_SILENCE
                )
                if staging is not None:
                    launcher.setenv("COS_USER_CONFIG_DIR", str(staging / "config"), True)
                    launcher.setenv("COS_USER_DATA_DIR", str(staging / "data"), True)
                self.child = launcher.spawnv([COS, "agent", "setup", "text", *args])
            except GLib.Error:
                callback({})
                return
            self.child.communicate_utf8_async(stdin, None, self.cos_result, callback)

        def cos_result(self, child, result, callback):
            self.child = None
            try:
                _, stdout, _ = child.communicate_utf8_finish(result)
                response = json.loads(stdout) if child.get_successful() else {}
            except (GLib.Error, ValueError):
                response = {}
            callback(response)

        def load_models(self):
            if self.child is not None or self.providers:
                return
            send(agentState="loading")

            def catalogue(response):
                if response.get("ready"):
                    send(savedModel=response["model"])
                self.cos(["providers"], providers)

            def providers(response):
                entries = response.get("providers", [])
                self.providers = {entry["name"]: entry for entry in entries}
                send(providers=entries, agentState="idle" if entries else "unavailable")

            self.cos(["--status"], catalogue)

        def sign_in(self):
            if self.child is not None or self.oauth is not None:
                return
            flow = {}
            self.oauth = flow
            send(agentState="signingIn")

            def started(response):
                if self.oauth is not flow:
                    return
                if (not response.get("device_code") or not response.get("user_code")
                        or response.get("verification_uri") != "https://github.com/login/device"):
                    self.end_sign_in("signInFailed")
                    return
                flow.update(code=response["device_code"], expires=time.monotonic() + response["expires_in"],
                            interval=max(5, response["interval"]))
                send(userCode=response["user_code"], agentState="authorizing")
                self.schedule_poll()

            self.cos(["oauth-start", "--provider", "copilot"], started)

        def schedule_poll(self):
            self.oauth_timer = GLib.timeout_add_seconds(self.oauth["interval"], self.poll_sign_in)

        def poll_sign_in(self):
            self.oauth_timer = 0
            flow = self.oauth
            if time.monotonic() >= flow["expires"]:
                self.end_sign_in("signInFailed")
                return GLib.SOURCE_REMOVE

            def polled(response):
                if self.oauth is not flow:
                    return
                status = response.get("status")
                if status in ("pending", "slow_down"):
                    if status == "slow_down":
                        flow["interval"] = max(flow["interval"] + 5, response.get("interval") or 0)
                    self.schedule_poll()
                elif status == "ok":
                    self.signed_in = True
                    self.end_sign_in("loadingModels")
                    self.cos(["models", "--provider", "copilot"], self.copilot_models)
                else:
                    self.end_sign_in("signInFailed")

            self.cos(["oauth-poll", "--provider", "copilot", "--device-code-stdin"],
                     polled, flow["code"] + "\n")
            return GLib.SOURCE_REMOVE

        def end_sign_in(self, state="idle"):
            if self.oauth_timer:
                GLib.source_remove(self.oauth_timer)
                self.oauth_timer = 0
            if self.oauth is not None and self.child is not None:
                self.child.force_exit()
            self.oauth = None
            send(userCode="", agentState=state)

        def copilot_models(self, response):
            send(copilotModels=[model["name"] for model in response.get("models", [])],
                 signedIn=True, agentState="idle")

        def save_model(self, message):
            if self.child is not None or self.oauth is not None:
                return
            provider = self.providers.get(message["provider"])
            model = message["model"].strip()
            if provider is None or not model:
                return
            if provider.get("auth_kind") == "oauth_device" and not self.signed_in:
                return
            args = ["apply", "--provider", provider["name"], "--model", model]
            if message["endpoint"].strip():
                args += ["--base-url", message["endpoint"].strip()]
            if message["apiVersion"].strip():
                args += ["--api-version", message["apiVersion"].strip()]
            secret = message["apiKey"]
            if secret:
                args += ["--api-key-stdin"]
            send(agentState="saving")

            def saved(response):
                if response.get("ok"):
                    send(savedModel=response["model"], agentState="saved")
                else:
                    send(agentState="saveFailed")

            self.cos(args, saved, secret)

    Setup().run()


def sign_in_accounts():
    from gi.repository import Gio, GLib

    users = [
        row for row in pwd.getpwall()
        if 1000 <= row.pw_uid < 60000 and Path(row.pw_shell).name not in ("nologin", "false", "")
    ]
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except GLib.Error:
        bus = None

    deadline = time.monotonic() + 1
    rows = []
    for row in users:
        avatar = ""
        remaining = int((deadline - time.monotonic()) * 1000)
        if bus is not None and remaining > 0:
            try:
                reply = bus.call_sync(
                    "org.freedesktop.Accounts", f"/org/freedesktop/Accounts/User{row.pw_uid}",
                    "org.freedesktop.DBus.Properties", "Get",
                    GLib.Variant("(ss)", ("org.freedesktop.Accounts.User", "IconFile")),
                    GLib.VariantType.new("(v)"), Gio.DBusCallFlags.NONE, remaining, None,
                )
                match = re.fullmatch(r"/usr/share/claw-os/avatars/([a-z]{1,24})\.png", reply.unpack()[0])
                if match:
                    avatar = match[1]
            except GLib.Error:
                pass
        rows.append({"username": row.pw_name, "name": row.pw_gecos.split(",", 1)[0] or row.pw_name,
                     "avatar": avatar})
    return sorted(rows, key=lambda row: row["name"].casefold())


def main():
    config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    completed = config / "cos/first-run-complete"
    args = sys.argv[1:]
    if args == ["--accounts"]:
        print(json.dumps(sign_in_accounts()))
        return 0
    if args == ["--check-complete"]:
        return int(not completed.is_file())
    if args == ["--backend"]:
        if os.environ.get("CLAW_LOCAL_DESKTOP_SETUP") == "1":
            with tempfile.TemporaryDirectory(prefix="claw-oobe-", dir=os.environ["XDG_RUNTIME_DIR"]) as stage:
                backend(completed, Path(stage))
        else:
            backend(completed)
    elif args == ["--local"]:
        os.environ["CLAW_LOCAL_DESKTOP_SETUP"] = "1"
        os.environ["QS_NO_RELOAD_POPUP"] = "1"
        os.execv(SHELL, [SHELL, "--path", CONFIG])
    elif args:
        return 2
    elif not completed.is_file():
        os.environ["QS_NO_RELOAD_POPUP"] = "1"
        os.execv(SHELL, [SHELL, "--path", CONFIG])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
