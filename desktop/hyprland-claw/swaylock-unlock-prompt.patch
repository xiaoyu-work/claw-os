diff --git a/render.c b/render.c
--- a/render.c
+++ b/render.c
@@ -51,0 +52,26 @@ static bool render_frame(struct swaylock_surface *surface);
+static void centered_text(cairo_t *cairo, const char *text, double x, double y) {
+	cairo_text_extents_t extents;
+	cairo_text_extents(cairo, text, &extents);
+	cairo_move_to(cairo, x - extents.width / 2 - extents.x_bearing, y);
+	cairo_show_text(cairo, text);
+}
+
+static void render_unlock_prompt(cairo_t *cairo, const struct swaylock_surface *surface) {
+	double scale = surface->scale;
+	double x = surface->width * scale / 2;
+	double y = surface->height * scale / 2;
+	double ring = (surface->state->args.radius + surface->state->args.thickness) * scale;
+
+	cairo_set_operator(cairo, CAIRO_OPERATOR_OVER);
+	cairo_select_font_face(cairo, "sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_BOLD);
+	cairo_set_source_u32(cairo, 0xf1f5ffff);
+	cairo_set_font_size(cairo, 27 * scale);
+	centered_text(cairo, "Screen locked", x, y - ring - 24 * scale);
+
+	cairo_select_font_face(cairo, "sans", CAIRO_FONT_SLANT_NORMAL, CAIRO_FONT_WEIGHT_NORMAL);
+	cairo_set_source_u32(cairo, 0xccd8ecff);
+	cairo_set_font_size(cairo, 16 * scale);
+	centered_text(cairo, "Type your sign-in password.", x, y + ring + 30 * scale);
+	centered_text(cairo, "Press Enter to unlock.", x, y + ring + 54 * scale);
+}
+
@@ -90,0 +117 @@ void render(struct swaylock_surface *surface) {
+		render_unlock_prompt(cairo, surface);
