Dark (
    (
        name: "cosmic-dark",
        // Claw brand blue (#005CFE) — the single accent across the whole
        // "Claw Glass" design language (from the logo claw-dot). Replaces the
        // macOS Aqua dark-mode blue so light and dark share one brand accent.
        blue: (
            c: "#005CFE",
        ),
        red: (
            c: "#FF453A",
        ),
        green: (
            c: "#32D74B",
        ),
        yellow: (
            c: "#FFD60A",
        ),
        // Claw Glass: dark variant is DEEP BLUE glass, not neutral charcoal.
        // Surface seeds carry a navy-blue cast at the original luminance so
        // dark frosted surfaces read as blue glass (per "不要灰暗").
        gray_1: (
            c: "#161B2B",
        ),
        gray_2: (
            c: "#1F2538",
        ),
        gray_3: (
            c: "#242B40",
        ),
