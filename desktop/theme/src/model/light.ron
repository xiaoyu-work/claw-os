Light (
    (
        name: "cosmic-light",
        // Claw brand blue (#005CFE) — the single accent across the whole
        // "Claw Glass" design language (from the logo claw-dot). Replaces the
        // macOS Aqua system blue; the sibling semantic colors
        // (red/green/yellow) follow the macOS system palette so destructive /
        // success / warning surfaces feel native.
        blue: (
            c: "#005CFE",
        ),
        red: (
            c: "#FF3B30",
        ),
        green: (
            c: "#34C759",
        ),
        yellow: (
            c: "#FFCC00",
        ),
        // Claw Glass: surface seeds carry a faint cool-blue cast (not flat
        // gray) at the original luminance so bright frosted surfaces read as
        // blue glass while preserving text contrast.
        gray_1: (
            c: "#DCE1EE",
        ),
        gray_2: (
            c: "#E6EAF4",
        ),
        gray_3: (
            c: "#F1F4FB",
        ),
        neutral_1: (
            c: "#FCFDFF",
        ),
        neutral_2: (
            c: "#E1E5EF",
        ),
        neutral_3: (
            c: "#C9C9C9",
        ),
        neutral_4: (
            c: "#AEAEAE",
        ),
        neutral_5: (
            c: "#939393",
        ),
        neutral_6: (
            c: "#787878",
        ),
        neutral_7: (
            c: "#5D5D5D",
        ),
        neutral_8: (
            c: "#424242",
        ),
        neutral_9: (
            c: "#272727",
        ),
        neutral_10: (
            c: "#000",
        ),
        ext_warm_grey: (
            c: "#9B8E8A",
        ),
        ext_orange: (
            c: "#FBB86C",
        ),
        ext_yellow: (
            c: "#F7E062",
        ),
        ext_blue: (
            c: "#5B8DEF",
        ),
        ext_purple: (
            c: "#D58CFF",
        ),
        ext_pink: (
            c: "#FF9CDD",
        ),
        ext_indigo: (
            c: "#95C4FC",
        ),
        accent_warm_grey: (
            c: "#ADA29E",
        ),
        accent_orange: (
            c: "#FFD7A1",
        ),
        accent_yellow: (
            c: "#FFF19E",
        ),
        accent_purple: (
            c: "#D58CFF",
        ),
        accent_pink: (
            c: "#FF9CDD",
        ),
        accent_indigo: (
            c: "#95C4FC",
        ),
    )
)