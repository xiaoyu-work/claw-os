set export

# Wraps upstream WhiteSur-icon-theme install.sh into our packaging layout.
# Source tree lives at ../icons-whitesur (vendored copy of
# vinceliuice/WhiteSur-icon-theme; exact SHA in ../icons-whitesur/UPSTREAM_COMMIT).
# We install only the default blue variant in light+dark to keep the package
# under ~120 MB. Folder icons + symbolic actions get inherited by `cosmic-icons`
# via `Inherits=WhiteSur,...` in ../icons/index.theme.

rootdir := ''
prefix := '/usr'
base-dir := absolute_path(clean(rootdir / prefix))
icons-dir := base-dir / 'share' / 'icons'
src-dir := justfile_directory() / '..' / 'icons-whitesur'

default:
    @just --list

# Install default + light + dark variants of the blue theme.
install:
    @test -f "{{src-dir}}/install.sh" || { \
        echo "error: vendored sources missing at {{src-dir}}."; \
        echo "       the desktop/icons-whitesur/ directory should contain"; \
        echo "       the WhiteSur source tree — was it deleted by accident?"; \
        exit 1; \
    }
    install -d {{icons-dir}}
    bash {{src-dir}}/install.sh --dest {{icons-dir}} --name WhiteSur

uninstall:
    rm -rf {{icons-dir}}/WhiteSur \
           {{icons-dir}}/WhiteSur-light \
           {{icons-dir}}/WhiteSur-dark
