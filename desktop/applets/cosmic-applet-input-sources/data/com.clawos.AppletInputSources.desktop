[Desktop Entry]
Name=Input Sources
Comment=Switch between input sources
Type=Application
Exec=cosmic-applet-input-sources
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Input;Source;
Icon=com.clawos.AppletInputSources-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
