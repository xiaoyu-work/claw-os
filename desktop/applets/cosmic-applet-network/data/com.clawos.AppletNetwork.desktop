[Desktop Entry]
Name=Network
Comment=Manage network connections
Type=Application
Exec=cosmic-applet-network
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Network;
Icon=com.clawos.AppletNetwork-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
