[Desktop Entry]
# Presentation source for the top-panel calendar shortcut.
Name=Calendar
Comment=Ask Claw for today's calendar
Type=Application
Exec=cos app agent overlay --query "Show my calendar for today"
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Calendar;Schedule;
Icon=com.clawos.PanelCalendarButton-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicAppletPresentation=Icon
