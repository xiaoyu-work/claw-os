[Desktop Entry]
Name=Tiling
Comment=Manage the active hint, current & per-workspace auto-tiling
Type=Application
Exec=cosmic-applet-tiling
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Tiling;Hint;Workspace;
Icon=com.clawos.AppletTiling-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
