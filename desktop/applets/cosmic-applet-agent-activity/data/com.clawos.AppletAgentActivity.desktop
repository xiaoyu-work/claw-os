[Desktop Entry]
Name=Agent Activity
Comment=Live timeline of running and paused Claw OS agent tasks
Type=Application
Exec=cosmic-applet-agent-activity
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Agent;Tasks;Sessions;
Icon=system-run-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
