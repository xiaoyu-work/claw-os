[Desktop Entry]
Name=Notifications Tray
Comment=Application indicators which may export menus to the panel
Type=Application
Exec=cosmic-applet-status-area
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;App;Indicator;Notification;Tray;Status;
Icon=com.clawos.AppletStatusArea
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=99
X-OverflowMinSize=2
