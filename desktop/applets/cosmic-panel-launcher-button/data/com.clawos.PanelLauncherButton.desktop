[Desktop Entry]
Name=Launcher Button
Comment=Open the launcher to search applications and run commands
Type=Application
Exec=cosmic-panel-button com.clawos.Launcher
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Launcher;Runner;
Icon=com.clawos.PanelLauncherButton
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-OverflowPriority=10
