[Desktop Entry]
Name=App Library Button
Comment=Open the application library for launching installed applications
Type=Application
Exec=cosmic-panel-button com.clawos.AppLibraryButton
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;App;Library;Tray;
Icon=com.clawos.PanelAppButton
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-OverflowPriority=10
