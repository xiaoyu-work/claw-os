[Desktop Entry]
Name=Power & Battery
Comment=Power modes and power saving options
Type=Application
Exec=cosmic-applet-battery
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Power;Battery;
Icon=com.clawos.AppletBattery-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Start
X-OverflowPriority=10
