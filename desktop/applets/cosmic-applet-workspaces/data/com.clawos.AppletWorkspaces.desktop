[Desktop Entry]
Name=Numbered Workspaces
Comment=Switch between numbered workspaces in the panel
Type=Application
Exec=cosmic-applet-workspaces
Terminal=false
Categories=ClawOS;
Keywords=ClawOS;Applet;Workspace;
Icon=com.clawos.AppletWorkspaces
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-OverflowPriority=5
X-OverflowMinSize=8
