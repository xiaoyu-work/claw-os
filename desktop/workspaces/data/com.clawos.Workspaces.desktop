[Desktop Entry]
Name=Workspaces
Name[ar]=مَسَاحَاتُ العَمَل
Name[bg]=Пространства
Name[cs]=Pracovní plochy
Name[zh_CN]=工作区
Name[hu]=Munkaterületek
Name[pl]=Obszary robocze
Name[pt]=Áreas de Trabalho
Name[ru]=Обзор
Name[sk]=Pracovné plochy
Name[sv]=Arbetsytor
Name[it]=Spazi di lavoro
Name[uk]=Простори
Comment=
Type=Application
Exec=cosmic-workspaces
Terminal=false
Categories=ClawOS;
# Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
Keywords=ClawOS;ICED;
Keywords[ar]=كوزمِك;آيسِد;
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=com.clawos.Workspaces-symbolic
StartupNotify=true
NoDisplay=true
# The panel ships at size XS, where `cosmic-panel-button` falls back to a text
# label unless the entry asks for an icon. Without this the workspaces button
# renders the word "Workspaces" in the top bar instead of its glyph.
X-CosmicAppletPresentation=Icon
