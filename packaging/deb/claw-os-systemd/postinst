#!/bin/sh
# claw-os-systemd postinst — enable the Claw OS boot units via the standard
# deb-systemd-helper so it works in a chroot (no dbus required) and on a
# running system alike. clawd.service is the required system agent path.

set -e

case "$1" in
    configure)
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper unmask cos-home-setup.service >/dev/null || true
            deb-systemd-helper --quiet was-enabled cos-home-setup.service \
                || deb-systemd-helper enable cos-home-setup.service >/dev/null || true
            deb-systemd-helper unmask clawd.service >/dev/null || true
            deb-systemd-helper --quiet was-enabled clawd.service \
                || deb-systemd-helper enable clawd.service >/dev/null || true
            deb-systemd-helper unmask cos-browser.service >/dev/null || true

            # Enable systemd-timesyncd (NTP) — shipped disabled by the
            # systemd package on Debian. Wall clock matters for HTTPS,
            # sudo timestamps, mail, sshd, …
            if [ -f /lib/systemd/system/systemd-timesyncd.service ]; then
                deb-systemd-helper unmask systemd-timesyncd.service >/dev/null || true
                deb-systemd-helper --quiet was-enabled systemd-timesyncd.service \
                    || deb-systemd-helper enable systemd-timesyncd.service >/dev/null || true
            fi

            # Enable ydotoold — the AI agent's universal GUI input
            # driver depends on this daemon.
            if [ -f /lib/systemd/system/ydotoold.service ]; then
                deb-systemd-helper unmask ydotoold.service >/dev/null || true
                deb-systemd-helper --quiet was-enabled ydotoold.service \
                    || deb-systemd-helper enable ydotoold.service >/dev/null || true
            fi

            # Enable fwupd-refresh.timer — weekly LVFS firmware
            # metadata refresh. Firmware *install* stays user-driven.
            if [ -f /lib/systemd/system/fwupd-refresh.timer ]; then
                deb-systemd-helper unmask fwupd-refresh.timer >/dev/null || true
                deb-systemd-helper --quiet was-enabled fwupd-refresh.timer \
                    || deb-systemd-helper enable fwupd-refresh.timer >/dev/null || true
            fi
        fi

        # User units. The desktop bridge stays per-graphical-session
        # and connects to the boot-time system clawd socket.
        # deb-systemd-helper does not handle
        # user units, so do the symlinks directly (this is what
        # `systemctl --global enable` does internally and is safe in a
        # chroot — no systemd needs to be running).
        rm -f /etc/systemd/user/default.target.wants/clawd.service

        # Remove only the known legacy image-overlay copies. Files under
        # /etc override the new vendor units, so leaving these old
        # graphical-session-bound definitions would defeat headless startup.
        for legacy in claw-recoll-index.service claw-semantic.service; do
            path="/etc/systemd/user/$legacy"
            if [ -f "$path" ] \
                    && grep -q '^Description=ClawOS:' "$path" \
                    && grep -q '^PartOf=graphical-session.target$' "$path"; then
                rm -f "$path"
            fi
        done

        mkdir -p /etc/systemd/user/graphical-session.target.wants
        ln -sf /usr/lib/systemd/user/cos-agent-bridge.service \
            /etc/systemd/user/graphical-session.target.wants/cos-agent-bridge.service

        # Indexing belongs to the user session, not specifically to a
        # graphical login. Global default.target links make it available
        # under SSH/headless user managers as well; unit Conditions skip
        # cleanly when an optional indexer binary is not installed.
        mkdir -p /etc/systemd/user/default.target.wants
        ln -sf /usr/lib/systemd/user/claw-recoll-index.service \
            /etc/systemd/user/default.target.wants/claw-recoll-index.service
        ln -sf /usr/lib/systemd/user/claw-semantic.service \
            /etc/systemd/user/default.target.wants/claw-semantic.service

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            systemctl --global daemon-reload >/dev/null 2>&1 || true
            if [ -n "$2" ]; then
                deb-systemd-invoke try-restart cos-home-setup.service >/dev/null || true
                deb-systemd-invoke try-restart clawd.service >/dev/null || true
            else
                deb-systemd-invoke start clawd.service >/dev/null || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
