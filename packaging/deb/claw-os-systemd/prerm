#!/bin/sh
# claw-os-systemd prerm — stop and disable units on remove (but not upgrade).

set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop cos-den-setup.service >/dev/null || true
            deb-systemd-invoke stop cos-browser.service >/dev/null || true
        fi
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper disable cos-den-setup.service >/dev/null || true
            deb-systemd-helper disable cos-browser.service >/dev/null || true
        fi
        # User unit: remove the global enable symlink we created in
        # postinst. We can't reach into individual user sessions, but
        # this prevents new logins from starting the bridge.
        rm -f /etc/systemd/user/graphical-session.target.wants/cos-agent-bridge.service
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
