#!/bin/sh
# claw-os-systemd prerm — stop and disable units on remove (but not upgrade).

set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop clawd.service >/dev/null || true
            deb-systemd-invoke stop cos-home-setup.service >/dev/null || true
            deb-systemd-invoke stop cos-browser.service >/dev/null || true
        fi
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper disable clawd.service >/dev/null || true
            deb-systemd-helper disable cos-home-setup.service >/dev/null || true
            deb-systemd-helper disable cos-browser.service >/dev/null || true
        fi
        # Remove both the current bridge symlink and the legacy
        # user-scoped clawd symlink from older package versions.
        rm -f /etc/systemd/user/default.target.wants/clawd.service
        rm -f /etc/systemd/user/graphical-session.target.wants/cos-agent-bridge.service
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
