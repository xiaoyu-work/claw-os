#!/bin/sh
set -e

ensure_line() {
    file="$1"
    line="$2"
    mkdir -p "$(dirname "$file")"
    touch "$file"
    grep -qxF "$line" "$file" || echo "$line" >> "$file"
}

ensure_initial_setup_user() {
    if id cosmic-initial-setup >/dev/null 2>&1; then
        return 0
    fi
    adduser --system --force-badname --quiet \
        --home /var/lib/cosmic-initial-setup \
        --shell /bin/bash \
        cosmic-initial-setup
    install -d -o cosmic-initial-setup -g nogroup -m 0755 \
        /var/lib/cosmic-initial-setup
}

enable_desktop_links() {
    mkdir -p /etc/systemd/system/graphical.target.wants
    mkdir -p /etc/systemd/system/multi-user.target.wants
    ln -sf /lib/systemd/system/cosmic-greeter.service \
        /etc/systemd/system/graphical.target.wants/cosmic-greeter.service
    ln -sf /lib/systemd/system/cosmic-greeter.service \
        /etc/systemd/system/display-manager.service
    ln -sf /lib/systemd/system/cosmic-greeter-daemon.service \
        /etc/systemd/system/multi-user.target.wants/cosmic-greeter-daemon.service
    ln -sf /lib/systemd/system/graphical.target \
        /etc/systemd/system/default.target

    mkdir -p /etc/systemd/user/sockets.target.wants
    mkdir -p /etc/systemd/user/default.target.wants
    for unit in pipewire.socket pipewire-pulse.socket; do
        [ -e "/usr/lib/systemd/user/$unit" ] && \
            ln -sf "/usr/lib/systemd/user/$unit" \
                "/etc/systemd/user/sockets.target.wants/$unit"
    done
    for unit in pipewire.service wireplumber.service; do
        [ -e "/usr/lib/systemd/user/$unit" ] && \
            ln -sf "/usr/lib/systemd/user/$unit" \
                "/etc/systemd/user/default.target.wants/$unit"
    done

    mkdir -p /etc/systemd/user/graphical-session.target.wants
    [ -e /usr/lib/systemd/user/cos-agent-bridge.service ] && \
        ln -sf /usr/lib/systemd/user/cos-agent-bridge.service \
            /etc/systemd/user/graphical-session.target.wants/cos-agent-bridge.service
}

enable_desktop_services() {
    if command -v systemctl >/dev/null 2>&1; then
        systemctl enable NetworkManager.service >/dev/null
        systemctl enable bluetooth.service >/dev/null 2>&1 || true
        systemctl enable polkit.service >/dev/null 2>&1 || true
        systemctl enable power-profiles-daemon.service >/dev/null 2>&1 || true
        systemctl enable upower.service >/dev/null 2>&1 || true
        systemctl enable accounts-daemon.service >/dev/null 2>&1 || true
        # Real-hardware basics (Phase 3 hardening).
        systemctl enable udisks2.service >/dev/null 2>&1 || true
        systemctl enable avahi-daemon.service >/dev/null 2>&1 || true
        systemctl enable cups.service >/dev/null 2>&1 || true
        systemctl enable cups-browsed.service >/dev/null 2>&1 || true
        systemctl enable thermald.service >/dev/null 2>&1 || true
            # ModemManager handles cellular modems. On machines without one
            # the service starts and exits idle, costing nothing.
            systemctl enable ModemManager.service >/dev/null 2>&1 || true
            # systemd-coredump is socket-activated by systemd; the package
            # also drops a sysctl that points kernel.core_pattern at it
            # — no enable needed. Keep this comment so future hands don't
            # add a redundant systemctl enable here.
            # geoclue is dbus-activated; no enable needed.
            # xdg-desktop-portal is dbus-activated; no enable needed.
            # colord is dbus-activated; no enable needed.
            # at-spi2-core is dbus-activated; no enable needed.
    fi
}

enable_fingerprint_auth() {
    # Wire fprintd into the PAM auth stack via the standard
    # pam-auth-update mechanism. The libpam-fprintd package ships
    # /usr/share/pam-configs/fprintd; pam-auth-update merges it into
    # /etc/pam.d/common-auth. On machines without a reader, pam_fprintd
    # returns PAM_IGNORE so password auth still works.
    if [ -f /usr/share/pam-configs/fprintd ] && command -v pam-auth-update >/dev/null 2>&1; then
        DEBIAN_FRONTEND=noninteractive pam-auth-update --enable fprintd \
            >/dev/null 2>&1 || true
    fi
}

generate_default_locales() {
    [ -f /etc/locale.gen ] || return 0
    for entry in \
        "en_US.UTF-8 UTF-8" \
        "zh_CN.UTF-8 UTF-8" \
        "zh_TW.UTF-8 UTF-8" \
        "ja_JP.UTF-8 UTF-8"; do
        if grep -q "^# $entry$" /etc/locale.gen; then
            sed -i "s|^# $entry$|$entry|" /etc/locale.gen
        elif ! grep -q "^$entry$" /etc/locale.gen; then
            echo "$entry" >> /etc/locale.gen
        fi
    done
    if command -v locale-gen >/dev/null 2>&1; then
        locale-gen
    fi
    echo "LANG=en_US.UTF-8" > /etc/default/locale
}

if [ "$1" = "configure" ]; then
    ensure_line /etc/environment "XCURSOR_THEME=Bibata-Modern-Classic"
    ensure_line /etc/environment "XCURSOR_SIZE=24"
    ensure_line /etc/environment "GTK_IM_MODULE=fcitx"
    ensure_line /etc/environment "QT_IM_MODULE=fcitx"
    ensure_line /etc/environment "XMODIFIERS=@im=fcitx"
    ensure_line /etc/environment "SDL_IM_MODULE=fcitx"
    ensure_line /etc/environment "GLFW_IM_MODULE=ibus"
    ensure_initial_setup_user
    enable_desktop_links
    enable_desktop_services
    enable_fingerprint_auth
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers
    fi
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create
    fi
    generate_default_locales
    command -v plymouth-set-default-theme >/dev/null 2>&1 && \
        plymouth-set-default-theme claw || true
fi

exit 0
