[Unit]
Description=Claw OS Nearby Sharing radio
Documentation=https://github.com/xiaoyu-work/claw-os/blob/main/docs/nearby-sharing.md
After=dbus.service NetworkManager.service clawd.service
PartOf=clawd.service
Wants=sys-kernel-debug.mount
After=sys-kernel-debug.mount

[Service]
Type=dbus
BusName=io.github.t4t5.Owly
ExecStartPre=/usr/lib/cos/bin/claw-security-floor service-gate --package claw-os-agent --manifest /usr/lib/cos/release-security/claw-os-agent/manifest.json
ExecStart=/usr/lib/cos/bin/claw-nearby-radio
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
RuntimeDirectory=owly
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
InaccessiblePaths=-/var/lib/cos -/var/log/cos -/etc/shadow -/etc/gshadow -/etc/ssh
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
