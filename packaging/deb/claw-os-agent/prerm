#!/bin/sh
# claw-os-agent prerm -- stop agent services on removal, but not upgrade.

set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop clawd.service >/dev/null || true
            deb-systemd-invoke stop cos-browser.service >/dev/null || true
        fi
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper disable clawd.service >/dev/null || true
            deb-systemd-helper disable cos-browser.service >/dev/null || true
        fi
        rm -f /etc/systemd/user/default.target.wants/clawd.service
        rm -f /etc/systemd/user/default.target.wants/claw-recoll-index.service
        rm -f /etc/systemd/user/default.target.wants/claw-semantic.service
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
