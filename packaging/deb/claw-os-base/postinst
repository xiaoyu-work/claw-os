#!/bin/sh
# claw-os-base postinst -- enable Claw OS distribution-level services.

set -e

enable_if_previously_enabled() {
    unit="$1"
    deb-systemd-helper unmask "$unit" >/dev/null || true
    if deb-systemd-helper --quiet was-enabled "$unit"; then
        deb-systemd-helper enable "$unit" >/dev/null || true
    else
        deb-systemd-helper update-state "$unit" >/dev/null || true
    fi
}

case "$1" in
    configure)
        if [ -x /usr/bin/deb-systemd-helper ]; then
            enable_if_previously_enabled cos-home-setup.service

            # These policies belong to the Claw OS distribution, not to a
            # reusable agent installed on an existing Debian/Ubuntu host.
            if [ -f /lib/systemd/system/systemd-timesyncd.service ]; then
                enable_if_previously_enabled systemd-timesyncd.service
            fi
            if [ -f /lib/systemd/system/ydotoold.service ]; then
                enable_if_previously_enabled ydotoold.service
            fi
            if [ -f /lib/systemd/system/fwupd-refresh.timer ]; then
                enable_if_previously_enabled fwupd-refresh.timer
            fi
        fi

        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            if [ -n "$2" ]; then
                deb-systemd-invoke try-restart cos-home-setup.service >/dev/null || true
            else
                deb-systemd-invoke start cos-home-setup.service >/dev/null || true
            fi
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
