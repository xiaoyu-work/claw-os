SDK_FILES = ("libc.so", "libgcc.so")


def is_romulus():
    if not (DT / "compatible").is_file():
        return False
    names = (DT / "compatible").read_bytes().split(b"\0")
    return b"qcom,x1e80100" in names and bool(ROMULUS.intersection(names))


def firmware_requests():
    if not (DT / "compatible").is_file():
        raise ValueError("the running kernel does not expose a supported Snapdragon device tree")
    compatible = set((DT / "compatible").read_bytes().split(b"\0"))
    if not any(
        re.match(rb"qcom,(?:x1|glymur|mahua|kalambo)", entry)
        for entry in compatible
    ):
        raise ValueError("the running kernel does not expose a supported Snapdragon device tree")
    names = set()
    for prop in DT.rglob("firmware-name"):
        for name in prop.read_bytes().decode("ascii").split("\0"):
            path = PurePosixPath(name)
            if name.startswith("qcom/") and re.fullmatch(r"[A-Za-z0-9._/-]+", name) and ".." not in path.parts:
                names.add(name)
    if not names:
        raise ValueError("the running device tree declares no Qualcomm firmware paths")
    if is_romulus():
        names.update(ROMULUS_FILES)
    return sorted(names)


def destination(name):
    return DSP / name if name in CDSP_LIBS else FIRMWARE / "updates" / name


def existing(name):
    if name in CDSP_LIBS:
        return destination(name).exists()
    return any(
        (root / f"{name}{suffix}").is_file()
        for root in (FIRMWARE, FIRMWARE / "updates")
        for suffix in ("", ".zst", ".xz")
    )


def open_firmware(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    stream = os.fdopen(fd, "rb")
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
        stream.close()
        raise ValueError(f"{path}: expected a nonempty regular file")
    return stream


def candidates(source, requests, missing):
    by_name = {}
    for file in source.rglob("*"):
        if not file.is_symlink() and file.is_file():
            by_name.setdefault(file.name.lower(), []).append(file)
    counts = Counter(PurePosixPath(name).name.lower() for name in requests)
    for name in missing:
        basename = PurePosixPath(name).name
        exact = source / name
        if exact.is_file() and not exact.is_symlink():
            files = [exact]
        elif counts[basename.lower()] == 1:
            files = by_name.get(basename.lower(), [])
        else:
            continue
        if not files and basename.endswith("_dtb.mbn"):
            files = by_name.get(basename.removesuffix("_dtb.mbn").lower() + "_dtbs.elf", [])
        if not files:
            continue
        hashes = set()
        for file in files:
            with open_firmware(file) as stream:
                hashes.add(hashlib.file_digest(stream, "sha256").digest())
        if len(hashes) != 1:
            raise ValueError(f"{name}: multiple different files; supply only the matching OEM driver")
        checksum = hashes.pop()
        if is_romulus() and name in ROMULUS_FILES and checksum.hex() != ROMULUS_FILES[name]:
            raise ValueError(f"{name}: expected the exact verified Microsoft release")
        yield name, files[0], checksum


def install(name, source, expected):
    target = destination(name)
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent) as staged, open_firmware(source) as payload:
        shutil.copyfileobj(payload, staged)
        staged.flush()
        staged.seek(0)
        if hashlib.file_digest(staged, "sha256").digest() != expected:
            raise ValueError(f"{source}: changed during import")
        os.chmod(staged.name, 0o644)
        os.link(staged.name, target)


def verified(path, checksum):
    if not path.is_file():
        return False
    with open_firmware(path) as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest() == checksum


def ready(names):
    return all(verified(destination(name), ROMULUS_FILES[name]) for name in names)


def refresh_initramfs(romulus):
    subprocess.run(["/usr/sbin/update-initramfs", "-u", "-k", "all"], check=True)
    if romulus and Path("/etc/default/grub.d/60-claw-os-qualcomm.cfg").is_file():
        subprocess.run(["/usr/sbin/update-grub"], check=True)


def download(path, url, size, checksum, local=None):
    if local:
        with open_firmware(Path(local)) as stream, path.open("wb") as target:
            if os.fstat(stream.fileno()).st_size != size:
                raise ValueError(f"{local}: unexpected archive size")
            shutil.copyfileobj(stream, target)
    else:
        subprocess.run([
            "/usr/bin/curl", "--proto", "=https", "--proto-redir", "=https", "--location",
            "--fail", "--silent", "--show-error", "--connect-timeout", "30", "--max-time", "1200",
            "--max-filesize", str(size), "--output", str(path), url,
        ], check=True)
    if path.stat().st_size != size or not verified(path, checksum):
        raise ValueError(f"{url}: unexpected archive checksum")


def surface_firmware(sources):
    if not is_romulus():
        raise ValueError("the Microsoft firmware mapping is for Snapdragon Surface Laptop 7 only")
    changed = False
    try:
        for label, local in sources.items():
            url, size, checksum, files = ARCHIVES[label]
            pending = [name for name in files if not ready((name,))]
            for name in pending:
                if existing(name):
                    raise ValueError(f"{name}: refusing to replace existing OEM firmware")
            if not pending:
                continue
            with tempfile.TemporaryDirectory(prefix="claw-surface-firmware-", dir="/var/tmp") as tmp:
                work = Path(tmp)
                archive = work / f"{label}.msi"
                download(archive, url, size, checksum, local)
                subprocess.run(["/usr/bin/msiextract", "-C", str(work), str(archive)],
                               stdout=subprocess.DEVNULL, check=True)
                drivers = work / "SurfaceUpdate"
                for name in pending:
                    member, digest = files[name]
                    if not verified(drivers / member, digest):
                        raise ValueError(f"{name}: matching firmware not found in {label}")
                for name in pending:
                    member, digest = files[name]
                    install(name, drivers / member, bytes.fromhex(digest))
                    changed = True
                    print(f"Installed {name}")
    finally:
        if changed:
            refresh_initramfs(romulus=True)
    if not changed:
        refresh_initramfs(romulus=True)


def copy_hexagon_library(source, target):
    with open_firmware(source) as stream:
        header = stream.read(20)
        if header[:6] != b"\x7fELF\x01\x01" or header[16:20] != b"\x03\x00\xa4\x00":
            raise ValueError(f"{source}: expected a Hexagon SDK shared library")
        stream.seek(0)
        with target.open("xb") as out:
            shutil.copyfileobj(stream, out)


def install_qnn(sdk_libs, local_archive):
    if not is_romulus() or not ready(ROMULUS_COMPUTE):
        raise ValueError("install the verified Snapdragon Surface Laptop 7 compute firmware first")
    if not Path("/usr/lib/aarch64-linux-gnu/libcdsprpc.so").is_file():
        raise ValueError("install the Claw OS Surface FastRPC driver pack first")
    if QNN_RUNTIME.exists():
        print(f"QNN is already installed in {QNN_RUNTIME}")
        return
    QNN_RUNTIME.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="qnn-", dir=QNN_RUNTIME.parent) as tmp:
        work = Path(tmp)
        result = work / "runtime"
        dsp = result / "dsp"
        dsp.mkdir(parents=True)
        for name in SDK_FILES:
            copy_hexagon_library(sdk_libs / name, dsp / name)
        archive = work / "qnn.tgz"
        download(archive, *QNN_ARCHIVE, local=local_archive)
        with tarfile.open(archive, "r:gz") as payload:
            for name in QNN_FILES:
                member = payload.getmember(name)
                if not member.isfile():
                    raise ValueError(f"{name}: expected a regular file in the pinned QNN release")
                payload.extract(member, dsp if name == "libQnnHtpV73Skel.so" else result, filter="data")
        result.replace(QNN_RUNTIME)
    print(f"Installed QNN 2.8.0 in {QNN_RUNTIME}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, nargs="?", help="local directory of OEM driver files")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--list-missing", action="store_true")
    mode.add_argument("--romulus-audio-ready", action="store_true")
    mode.add_argument("--romulus-firmware-ready", action="store_true")
    mode.add_argument("--romulus-compute-ready", action="store_true")
    mode.add_argument("--surface-laptop-7", metavar="MSI", nargs="?", const="",
                      help="provision Romulus OEM firmware; use without a path to download both Microsoft archives")
    mode.add_argument("--install-qnn", metavar="HEXAGON_V73_LIBDIR", type=Path,
                      help="install the optional Qualcomm HTP provider using a directory with the official v73 libc.so and libgcc.so")
    parser.add_argument("--surface-pro-11", metavar="MSI", help="use this verified second MSI together with a local Laptop 7 MSI")
    parser.add_argument("--accept-qnn-license", action="store_true",
                        help="confirm that the owner accepts the Qualcomm license distributed with the QNN release")
    parser.add_argument("--qnn-archive", metavar="TGZ", help="use a local copy of the exact official QNN release")
    args = parser.parse_args()
    if args.surface_pro_11 and not args.surface_laptop_7:
        parser.error("--surface-pro-11 requires a local --surface-laptop-7 MSI")
    if (args.accept_qnn_license or args.qnn_archive) and args.install_qnn is None:
        parser.error("--accept-qnn-license and --qnn-archive require --install-qnn")
    if args.source is not None and any((args.list_missing, args.romulus_audio_ready, args.romulus_firmware_ready,
                                       args.romulus_compute_ready, args.surface_laptop_7 is not None, args.install_qnn)):
        parser.error("do not specify a source directory with another operation")
    if args.romulus_audio_ready:
        return 0 if ready(ROMULUS_PATH + name for name in ADSP) else 1
    if args.romulus_firmware_ready:
        return 0 if is_romulus() and ready(ROMULUS_FILES) else 1
    if args.romulus_compute_ready:
        return 0 if ready(ROMULUS_COMPUTE) else 1
    if args.install_qnn is not None:
        if os.geteuid() != 0:
            raise ValueError("QNN installation requires root")
        if not args.accept_qnn_license:
            parser.error("review the Qualcomm license in the official QNN 2.8.0 release and pass --accept-qnn-license")
        install_qnn(args.install_qnn, args.qnn_archive)
        return
    if args.surface_laptop_7 is not None:
        if os.geteuid() != 0:
            raise ValueError("import requires root")
        if args.surface_laptop_7:
            sources = {"surface-laptop-7": args.surface_laptop_7}
            if args.surface_pro_11:
                sources["surface-pro-11"] = args.surface_pro_11
        else:
            sources = dict.fromkeys(ARCHIVES)
        surface_firmware(sources)
        return
    if not args.list_missing and args.source is None:
        parser.error("use --list-missing, --surface-laptop-7, or specify an OEM directory")
    requests = firmware_requests()
    missing = [name for name in requests if not existing(name)]
    if args.list_missing:
        for name in missing:
            print(name)
        return
    if os.geteuid() != 0:
        raise ValueError("import requires root")
    if not args.source.is_dir():
        raise ValueError("the OEM driver directory does not exist")
    matches = list(candidates(args.source, requests, missing))
    for name, file, expected in matches:
        install(name, file, expected)
        print(f"Installed {name}")
    if any(destination(name).is_file() for name in requests):
        refresh_initramfs(romulus=is_romulus())
    for name in missing:
        if not existing(name):
            print(f"Still missing: {name}")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, tarfile.TarError, subprocess.SubprocessError) as error:
        raise SystemExit(f"claw-import-board-firmware: {error}") from error
