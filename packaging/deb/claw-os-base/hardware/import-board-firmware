    "libonnxruntime_providers_qnn.so", "libQnnHtp.so", "libQnnHtpPrepare.so", "libQnnSystem.so",
    "libQnnHtpV73Stub.so", "libQnnHtpV73Skel.so", "libQnnHtpNetRunExtensions.so", "libQnnIr.so",
    "LICENSE", "Qualcomm_LICENSE.pdf", "ThirdPartyNotices.txt", "Privacy.md",
