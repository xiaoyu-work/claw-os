#!/usr/bin/python3
"""Install matching Qualcomm firmware from an OEM driver."""

import argparse
from collections import Counter
import hashlib
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import subprocess
import tempfile


DT = Path("/sys/firmware/devicetree/base")
FIRMWARE = Path("/usr/lib/firmware")
ROMULUS = {b"microsoft,romulus13", b"microsoft,romulus15"}
SURFACE_MSI = (
    "https://download.microsoft.com/download/b7ca2c3f-d320-4795-be0f-529a0117abb4/"
    "SurfaceLaptop7_ARM_Win11_26100_26.101.6391.0.msi"
)
SURFACE_MSI_SIZE = 530989056
SURFACE_MSI_SHA256 = "4c4640205fa181cc7ac9bc14c35903d3147537cbe2ae8940ba2ade8e7ae25305"
# SHA-256 values recorded for the OEM files in omarchy-pkgs at 2082b74a.
ROMULUS_ADSP = {
    "qcadsp8380.mbn": "3a0240f9a1c0c43b657959b1bf10433a1a9793eb5c4af9f6beff8644c174f5a0",
    "adsp_dtbs.elf": "b03f066e2645dbe35a33a08a91312842f5cee3676cac3e111f1f3dabd1cf4e9e",
    "adspua.jsn": "d65dc1aedce2c1131da8ffaed7dcffc05cc9c58da491e0c39acb2ac5b3f4bc1d",
    "adspr.jsn": "e9ba7199626b0c03f2ec02822d744f678ad567fe0625a28fe5f5908b7281e9db",
    "adsps.jsn": "19b1396b5e2c0d14fb8a4eb8e47181df7f62989f4af519b439cf0ee45a46f76e",
    "battmgr.jsn": "b8aad1d149128f414eb1fd6fcbb6e0a5b7dabcd2cba001599e1ce9a0e2e291a4",
}
ROMULUS_ADSP = {"qcom/x1e80100/microsoft/Romulus/" + name: checksum for name, checksum in ROMULUS_ADSP.items()}


def firmware_requests():
    if not (DT / "compatible").is_file():
        raise ValueError("the running kernel does not expose a supported Snapdragon device tree")
    compatible = set((DT / "compatible").read_bytes().split(b"\0"))
    if not any(
        re.match(rb"qcom,(?:x1|glymur|mahua|kalambo)", entry)
        for entry in compatible
    ):
        raise ValueError("the running kernel does not expose a supported Snapdragon device tree")
    names = set()
    for prop in DT.rglob("firmware-name"):
        for name in prop.read_bytes().decode("ascii").split("\0"):
            path = PurePosixPath(name)
            if name.startswith("qcom/") and re.fullmatch(r"[A-Za-z0-9._/-]+", name) and ".." not in path.parts:
                names.add(name)
    if not names:
        raise ValueError("the running device tree declares no Qualcomm firmware paths")
    if ROMULUS.intersection(compatible):
        names.update(ROMULUS_ADSP)
    return sorted(names)


def existing(name):
    return any(
        (root / f"{name}{suffix}").is_file()
        for root in (FIRMWARE, FIRMWARE / "updates")
        for suffix in ("", ".zst", ".xz")
    )


def open_firmware(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    stream = os.fdopen(fd, "rb")
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size == 0:
        stream.close()
        raise ValueError(f"{path}: expected a nonempty regular file")
    return stream


def candidates(source, requests, missing):
    by_name = {}
    for file in source.rglob("*"):
        if not file.is_symlink() and file.is_file():
            by_name.setdefault(file.name.lower(), []).append(file)
    counts = Counter(PurePosixPath(name).name.lower() for name in requests)
    for name in missing:
        basename = PurePosixPath(name).name
        exact = source / name
        if exact.is_file() and not exact.is_symlink():
            files = [exact]
        elif counts[basename.lower()] == 1:
            files = by_name.get(basename.lower(), [])
        else:
            continue
        if not files and basename.endswith("_dtb.mbn"):
            files = by_name.get(basename.removesuffix("_dtb.mbn").lower() + "_dtbs.elf", [])
        if not files:
            continue
        hashes = set()
        for file in files:
            with open_firmware(file) as stream:
                hashes.add(hashlib.file_digest(stream, "sha256").digest())
        if len(hashes) != 1:
            raise ValueError(f"{name}: multiple different files; supply only the matching OEM driver")
        checksum = hashes.pop()
        if name in ROMULUS_ADSP and checksum.hex() != ROMULUS_ADSP[name]:
            raise ValueError(f"{name}: expected the firmware from the verified Surface Laptop 7 driver")
        yield name, files[0], checksum


def install(name, source, expected):
    target = FIRMWARE / "updates" / name
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent) as staged, open_firmware(source) as payload:
        shutil.copyfileobj(payload, staged)
        staged.flush()
        staged.seek(0)
        if hashlib.file_digest(staged, "sha256").digest() != expected:
            raise ValueError(f"{source}: changed during import")
        os.chmod(staged.name, 0o644)
        os.link(staged.name, target)


def verified(path, checksum):
    if not path.is_file():
        return False
    with open_firmware(path) as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest() == checksum


def audio_ready():
    return all(verified(FIRMWARE / "updates" / name, checksum) for name, checksum in ROMULUS_ADSP.items())


def refresh_initramfs(romulus):
    subprocess.run(["/usr/sbin/update-initramfs", "-u", "-k", "all"], check=True)
    if romulus and Path("/etc/default/grub.d/60-claw-os-qualcomm.cfg").is_file():
        subprocess.run(["/usr/sbin/update-grub"], check=True)


def surface_audio(msi):
    requests = firmware_requests()
    if not ROMULUS_ADSP.keys() <= set(requests):
        raise ValueError("the official Surface Laptop 7 driver is for Snapdragon Romulus only")
    pending = []
    for name, checksum in ROMULUS_ADSP.items():
        if verified(FIRMWARE / "updates" / name, checksum):
            continue
        if existing(name):
            raise ValueError(f"{name}: refusing to replace existing OEM firmware")
        pending.append(name)

    if pending:
        with tempfile.TemporaryDirectory(prefix="claw-surface-firmware-", dir="/var/tmp") as tmp:
            work = Path(tmp)
            archive = work / "surface-laptop-7.msi"
            if msi:
                with open_firmware(Path(msi)) as stream, archive.open("wb") as target:
                    if os.fstat(stream.fileno()).st_size != SURFACE_MSI_SIZE:
                        raise ValueError("unexpected Surface Laptop 7 MSI size")
                    shutil.copyfileobj(stream, target)
            else:
                subprocess.run([
                    "/usr/bin/curl", "--proto", "=https", "--proto-redir", "=https", "--location",
                    "--fail", "--silent", "--show-error", "--connect-timeout", "30",
                    "--max-time", "1200", "--max-filesize", str(SURFACE_MSI_SIZE),
                    "--output", str(archive), SURFACE_MSI,
                ], check=True)
            if not verified(archive, SURFACE_MSI_SHA256):
                raise ValueError("the Microsoft Surface Laptop 7 MSI checksum does not match")
            subprocess.run(["/usr/bin/msiextract", "-C", str(work), str(archive)],
                           stdout=subprocess.DEVNULL, check=True)
            drivers = work / "SurfaceUpdate/proextadsp8380"
            for name in pending:
                if not verified(drivers / PurePosixPath(name).name, ROMULUS_ADSP[name]):
                    raise ValueError(f"{name}: matching firmware missing from the Microsoft MSI")
            for name in pending:
                install(name, drivers / PurePosixPath(name).name, bytes.fromhex(ROMULUS_ADSP[name]))
                print(f"Installed {name}")
    refresh_initramfs(romulus=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, nargs="?", help="local directory of OEM driver files")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--list-missing", action="store_true")
    mode.add_argument("--romulus-audio-ready", action="store_true")
    mode.add_argument("--surface-laptop-7", metavar="MSI", nargs="?", const="",
                      help="import Surface Laptop 7 audio firmware from the official MSI, downloading it if not supplied")
    args = parser.parse_args()
    if args.source is not None and (args.list_missing or args.romulus_audio_ready or args.surface_laptop_7 is not None):
        parser.error("do not specify a source directory with another operation")
    if args.romulus_audio_ready:
        return 0 if audio_ready() else 1
    if args.surface_laptop_7 is not None:
        if os.geteuid() != 0:
            raise ValueError("import requires root")
        surface_audio(args.surface_laptop_7)
        return
    if not args.list_missing and args.source is None:
        parser.error("use --list-missing, --surface-laptop-7, or specify an OEM directory")
    requests = firmware_requests()
    missing = [name for name in requests if not existing(name)]
    if args.list_missing:
        for name in missing:
            print(name)
        return
    if os.geteuid() != 0:
        raise ValueError("import requires root")
    if not args.source.is_dir():
        raise ValueError("the OEM driver directory does not exist")
    matches = list(candidates(args.source, requests, missing))
    for name, file, expected in matches:
        install(name, file, expected)
        print(f"Installed {name}")
    if any((FIRMWARE / "updates" / name).is_file() for name in requests):
        refresh_initramfs(romulus=ROMULUS_ADSP.keys() <= set(requests))
    for name in missing:
        if not existing(name):
            print(f"Still missing: {name}")


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        raise SystemExit(f"claw-import-board-firmware: {error}") from error
