#!/bin/sh
set -e

[ -n "${CLAW_QCOM_DTB:-}" ] || exit 0
[ "$(dpkg --print-architecture)" = arm64 ] || exit 0
. /usr/lib/cos/hw/qualcomm-boot.sh
. /usr/share/grub/grub-mkconfig_lib

board_menu_entry() {
    cat <<MENU
menuentry 'Claw OS - $model ($version)' --id '$id' {
$(prepare_grub_to_access_device "$dtb_device" | grub_add_tab)
    set claw_dtb_root="\$root"
$(prepare_grub_to_access_device "$GRUB_DEVICE_BOOT" | grub_add_tab)
    if devicetree "(\$claw_dtb_root)$(make_system_path_relative_to_its_root "$dtb")"; then
        linux '$(make_system_path_relative_to_its_root "$kernel" | grub_quote)' root=$root_device ro $1 ${GRUB_CMDLINE_LINUX:-} ${GRUB_CMDLINE_LINUX_DEFAULT:-}
        initrd '$(make_system_path_relative_to_its_root "$initrd" | grub_quote)'
    fi
}
MENU
}

root_device=${GRUB_DEVICE:?}
if [ -n "${GRUB_DEVICE_UUID:-}" ] && [ "${GRUB_DISABLE_LINUX_UUID:-false}" != true ]; then
    root_device=UUID=$GRUB_DEVICE_UUID
fi
args=$claw_qcom_args
if [ "${GRUB_FS:-}" = btrfs ]; then
    subvolume=$(make_system_path_relative_to_its_root /)
    [ "$subvolume" = / ] || args="$args rootflags=subvol=${subvolume#/}"
fi
found=no
for kernel in $(printf '%s\n' /boot/vmlinuz-* | LC_ALL=C sort -Vr); do
    [ -s "$kernel" ] || continue
    version=${kernel#/boot/vmlinuz-}
    initrd=/boot/initrd.img-$version
    [ -s "$initrd" ] || continue
    board=$(claw_qcom_board "$CLAW_QCOM_DTB" "$version") || continue
    model=${board##*|}
    dtb=$(claw_qcom_tree '' "$version" "$CLAW_QCOM_DTB") || continue
    dtb_device=$("$grub_probe" --target=device "$dtb")
    if [ "$found" = no ]; then
        id=claw-qcom
        found=yes
    else
        id=claw-qcom-$version
    fi
    board_menu_entry "$args $claw_qcom_no_dsp"
    case "$CLAW_QCOM_DTB" in
        x1e80100-microsoft-romulus13.dtb|x1e80100-microsoft-romulus15.dtb)
            # Keep the no-DSP entry as the default even after importing firmware.
            if [ "${version%-omarchy}" != "$version" ] &&
                [ -f "${dtb%/*}/claw-boards.list" ] &&
                [ -f /usr/share/alsa/ucm2/Qualcomm/x1e80100/SurfaceLaptop7-HiFi.conf ] &&
                claw_qcom_nvme_boot "$GRUB_DEVICE" "$GRUB_DEVICE_BOOT" "$dtb_device" &&
                /usr/sbin/claw-import-board-firmware --romulus-audio-ready; then
                id=claw-qcom-oem-audio-$version
                model="$model, OEM audio (experimental)"
                board_menu_entry "$args"
            fi
            ;;
    esac
done

if [ "$found" = no ]; then
    echo "Claw OS Snapdragon boot: no installed kernel has both an initramfs and $CLAW_QCOM_DTB" >&2
    exit 1
fi
