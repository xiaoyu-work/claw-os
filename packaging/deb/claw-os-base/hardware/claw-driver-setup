#!/usr/bin/python3
"""Install optional hardware packages selected from the installed machine."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tempfile


CACHE = Path("/usr/share/cos/driver-cache")
STATE = Path("/var/lib/cos/driver-setup")
PENDING = STATE / "pending"
STATUS = STATE / "status.json"
OOBE = Path("/usr/libexec/claw-oobe")
APT = [
    "/usr/bin/apt-get", "-o", "Dpkg::Use-Pty=0", "-o", "DPkg::Lock::Timeout=30",
    "-o", "Acquire::http::Timeout=20", "-o", "Acquire::https::Timeout=20",
    "-o", "APT::Get::AllowUnauthenticated=false",
]
BACKPORTS = "trixie-backports"
AUDIO = ("alsa-ucm-conf", "1.2.16.1-1~bpo13+1")
CAMERA = (
    ("libcamera-ipa", "0.7.1-1~bpo13+1"),
    ("libcamera-tools", "0.7.1-1~bpo13+1"),
    ("libspa-0.2-libcamera", "1.6.9-2~bpo13+1"),
    ("gstreamer1.0-libcamera", "0.7.1-1~bpo13+1"),
)
SNAPDRAGON = "surface-laptop-7-snapdragon"
BROADCOM = "broadcom-sta-wifi"
BROADCOM_DRIVER = "broadcom-sta-dkms"
BROADCOM_BACKPORT = "6.30.223.271-30~bpo13+1"
BROADCOM_FIXED = f"{BROADCOM_BACKPORT}+clawos1"
DEBIAN_AMD64_ABI = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+\+deb13(?:\+[0-9]+)?-amd64")
FIRMWARE_HELPER = "/usr/sbin/claw-import-board-firmware"
OEM_INDEX = Path("/usr/share/cos/qualcomm/firmware.json")
SURFACE_FIRMWARE = "Microsoft Surface audio, graphics, video and compute firmware"
QCOM_FIRMWARE = "Snapdragon OEM firmware"
PACKS = {
    "surface-laptop-7-intel": (AUDIO, *CAMERA),
    SNAPDRAGON: (AUDIO, *CAMERA),
    "lenovo-yoga-pro-7-14iah10": (AUDIO,),
    BROADCOM: ((BROADCOM_DRIVER, BROADCOM_FIXED),),
}
LOCAL_PACKAGES = {
    "surface-laptop-7-intel": "claw-os-surface-laptop-7",
    SNAPDRAGON: "claw-os-surface-snapdragon-touchpad",
    BROADCOM: BROADCOM_DRIVER,
}


def detect_board(sysfs, arch):
    if arch == "arm64":
        try:
            compatible = (sysfs / "firmware/devicetree/base/compatible").read_bytes().split(b"\0")
        except FileNotFoundError:
            return None
        if b"qcom,x1e80100" in compatible and {b"microsoft,romulus13", b"microsoft,romulus15"}.intersection(compatible):
            return SNAPDRAGON
        return None
    if arch != "amd64":
        return None
    if (sysfs / "bus/acpi/devices/MSHW0551:00").exists():
        return "surface-laptop-7-intel"
    dmi = sysfs / "class/dmi/id"
    try:
        vendor = (dmi / "sys_vendor").read_text().strip()
        family = (dmi / "product_family").read_text().strip()
        model = (dmi / "product_name").read_text().strip()
    except FileNotFoundError:
        return None
    if vendor == "LENOVO" and "Yoga Pro 7 14IAH10" in (model, family):
        return "lenovo-yoga-pro-7-14iah10"
    return None


def broadcom_headers():
    releases = sorted(path.name.removeprefix("vmlinuz-") for path in Path("/boot").glob("vmlinuz-*")
                      if DEBIAN_AMD64_ABI.fullmatch(path.name.removeprefix("vmlinuz-")))
    return [(f"linux-headers-{release}", None) for release in releases]


def has_broadcom_sta_wifi(sysfs):
    for pci in (sysfs / "bus/pci/devices").glob("*"):
        try:
            if (pci / "vendor").read_text().strip() == "0x14e4" and (pci / "device").read_text().strip() in {
                "0x4331", "0x43a0",
            }:
                return True
        except FileNotFoundError:
            continue
    return False


def detect(sysfs=Path("/sys")):
    arch = subprocess.check_output(["/usr/bin/dpkg", "--print-architecture"], text=True).strip()
    board = detect_board(sysfs, arch)
    packs = [board] if board else []
    if arch == "amd64" and broadcom_headers() and has_broadcom_sta_wifi(sysfs):
        packs.append(BROADCOM)
    return packs


def missing(packs):
    requirements = dict(spec for pack in packs for spec in PACKS[pack])
    if BROADCOM in packs:
        requirements.update(broadcom_headers())
    packages = []
    for package, minimum in requirements.items():
        query = subprocess.run(
            ["/usr/bin/dpkg-query", "-W", "-f=${db:Status-Status} ${Version}", package],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, check=False,
        )
        state, _, version = query.stdout.partition(" ")
        if state != "installed" or not version or (minimum and subprocess.run(
            ["/usr/bin/dpkg", "--compare-versions", version, "lt", minimum], check=False,
        ).returncode == 0):
            packages.append(package)
    return packages


def publish(state, pack, packages):
    STATE.mkdir(parents=True, exist_ok=True)
    STATE.chmod(0o755)
    with tempfile.NamedTemporaryFile(mode="w", dir=STATE, delete=False) as out:
        json.dump({"state": state, "pack": pack, "packages": packages}, out)
        out.write("\n")
        os.fchmod(out.fileno(), 0o644)
    os.replace(out.name, STATUS)


def apt(*args, cwd=None):
    subprocess.run(
        [*APT, *args], cwd=cwd, stdin=subprocess.DEVNULL, check=True,
        env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"),
    )


def from_archive(packages):
    return [name if name.startswith("linux-headers-") else f"{name}/{BACKPORTS}" for name in packages]


def fix_broadcom_package(archive):
    if archive.name != f"{BROADCOM_DRIVER}_{BROADCOM_BACKPORT}_amd64.deb":
        return archive
    with tempfile.TemporaryDirectory(dir=archive.parent) as tmp:
        work = Path(tmp)
        stage = work / "package"
        subprocess.run(["/usr/bin/dpkg-deb", "--raw-extract", archive, stage], check=True)
        source = stage / "usr/src/broadcom-sta-6.30.223.271/src"
        # Linux 7.2 removed strncpy. Keep Debian's signed input and vendor blob intact.
        changes = {
            "shared/linux_osl.c": (
                ("strncpy(p->file, basename, BCM_MEM_FILENAME_LEN)", "strscpy(p->file, basename, BCM_MEM_FILENAME_LEN)"),
                ("return (strncpy(d, s, n));", "strscpy_pad(d, s, n);\n\treturn d;"),
            ),
            "wl/sys/wl_linux.c": (
                ("strncpy(dev->name, intf_name, IFNAMSIZ-1)", "strscpy(dev->name, intf_name, IFNAMSIZ)"),
                ("strncpy(info->version, EPI_VERSION_STR, sizeof(info->version))",
                 "strscpy(info->version, EPI_VERSION_STR, sizeof(info->version))"),
                ("strncpy(wlif->dev->name, wlif->name, strlen(wlif->name))",
                 "strscpy(wlif->dev->name, wlif->name, sizeof(wlif->dev->name))"),
            ),
        }
        for name, replacements in changes.items():
            path = source / name
            text = path.read_text()
            for old, new in replacements:
                if text.count(old) != 1:
                    raise ValueError(f"{archive.name}: unexpected Broadcom source in {name}")
                text = text.replace(old, new)
            path.write_text(text)
        metadata = stage / "DEBIAN"
        control = metadata / "control"
        control.write_text(control.read_text().replace(f"\nVersion: {BROADCOM_BACKPORT}\n",
                                                      f"\nVersion: {BROADCOM_FIXED}\n", 1))
        checksums = []
        for line in (metadata / "md5sums").read_text().splitlines():
            _, filename = line.split("  ", 1)
            digest = hashlib.md5((stage / filename).read_bytes(), usedforsecurity=False).hexdigest()
            checksums.append(f"{digest}  {filename}\n")
        (metadata / "md5sums").write_text("".join(checksums))
        result = archive.with_name(f"{BROADCOM_DRIVER}_{BROADCOM_FIXED}_amd64.deb")
        subprocess.run(["/usr/bin/dpkg-deb", "--root-owner-group", "--build", stage, work / result.name], check=True)
        (work / result.name).replace(result)
    archive.unlink()
    return result


def firmware_job(packs):
    if SNAPDRAGON in packs:
        return SURFACE_FIRMWARE, "--romulus-firmware-ready", "--surface-laptop-7"
    if OEM_INDEX.is_file():
        return QCOM_FIRMWARE, "--qualcomm-oem-ready", "--qualcomm-oem"
    return None


def needs_firmware(job):
    return job is not None and subprocess.run([FIRMWARE_HELPER, job[1]], check=False).returncode != 0


def stage_offline():
    apt("update", "-qq", "-o", "APT::Update::Error-Mode=any")
    arch = subprocess.check_output(["/usr/bin/dpkg", "--print-architecture"], text=True).strip()
    packs = [SNAPDRAGON] if arch == "arm64" else ["surface-laptop-7-intel", "lenovo-yoga-pro-7-14iah10"]
    if arch == "amd64" and broadcom_headers():
        packs.append(BROADCOM)
    for pack in packs:
        directory = CACHE / pack
        local = sorted(directory.glob("*.deb"))
        local_names = {file.name.split("_", 1)[0] for file in local}
        stock = [name for name in missing((pack,)) if name not in local_names]
        if not stock and not local:
            continue
        directory.mkdir(parents=True, exist_ok=True)
        apt("-o", f"Dir::Cache::archives={directory}", "install", "-t", BACKPORTS,
            "--download-only", "--no-install-recommends", "--no-remove", "-y",
            *map(str, local), *from_archive(stock))
        if pack == BROADCOM:
            for archive in directory.glob(f"{BROADCOM_DRIVER}_*.deb"):
                fix_broadcom_package(archive)


def remove_media_keyboard(packs):
    directory = CACHE / "surface-laptop-7-intel"
    release_file = directory / "kernel-release"
    if not release_file.is_file():
        return
    release = release_file.read_text().strip()
    if not DEBIAN_AMD64_ABI.fullmatch(release):
        raise ValueError(f"{release_file}: invalid Debian kernel ABI")
    Path("/etc/modprobe.d/60-claw-surface-media.conf").unlink(missing_ok=True)
    if "surface-laptop-7-intel" not in packs:
        registry = Path(f"/usr/lib/modules/{release}/updates/claw-surface/surface_aggregator_registry.ko")
        registry.unlink(missing_ok=True)
        subprocess.run(["/usr/sbin/depmod", "-a", release], check=True)
        subprocess.run(["/usr/sbin/update-initramfs", "-u", "-k", release], check=True)


def install_offline():
    packs = detect()
    remove_media_keyboard(packs)
    if SNAPDRAGON not in packs and Path(
        "/var/lib/dpkg/info/claw-os-surface-snapdragon-radio.list"
    ).is_file():
        subprocess.run(["/usr/bin/dpkg", "--purge", "claw-os-surface-snapdragon-radio"], check=True)
    for pack in packs:
        payload = sorted((CACHE / pack).glob("*.deb"))
        if not payload:
            continue
        try:
            apt("-o", "Dir::Etc::sourcelist=/dev/null", "-o", "Dir::Etc::sourceparts=-",
                "install", "--no-install-recommends", "--no-remove", "-y", *map(str, payload))
        except subprocess.CalledProcessError:
            local_package = LOCAL_PACKAGES.get(pack)
            if local_package and any(path.name.startswith(local_package + "_") for path in payload):
                raise
            print("Offline driver installation failed; remaining packages will be retried online.", flush=True)
    if CACHE.is_dir():
        shutil.rmtree(CACHE)
    packages = missing(packs)
    job = firmware_job(packs)
    if needs_firmware(job):
        packages.append(job[0])
    publish("pending" if packages else "ready", packs[0] if packs else None, packages)
    if packages:
        PENDING.touch()
    else:
        PENDING.unlink(missing_ok=True)


def online():
    if not PENDING.is_file():
        return
    packs = detect()
    pack = packs[0] if packs else None
    packages = missing(packs)
    job = firmware_job(packs)
    firmware = needs_firmware(job)
    if job and not firmware and STATUS.is_file():
        firmware = job[0] in json.loads(STATUS.read_text()).get("packages", [])
    pending = packages + ([job[0]] if firmware else [])
    if not pending:
        publish("ready", pack, [])
        PENDING.unlink(missing_ok=True)
        return
    connectivity = subprocess.check_output(
        ["/usr/bin/nmcli", "-g", "CONNECTIVITY", "general"], text=True,
        env=dict(os.environ, LC_ALL="C"),
    ).strip()
    if connectivity != "full":
        publish("pending", pack, pending)
        return

    publish("installing", pack, pending)
    try:
        if packages:
            apt("update", "-qq", "-o", "APT::Update::Error-Mode=any")
            with tempfile.TemporaryDirectory(prefix="claw-driver-setup-") as tmp:
                targets = from_archive(packages)
                if BROADCOM_DRIVER in packages:
                    request = f"{BROADCOM_DRIVER}/{BACKPORTS}"
                    apt("download", request, cwd=tmp)
                    archive, = Path(tmp).glob(f"{BROADCOM_DRIVER}_*.deb")
                    targets[targets.index(request)] = str(fix_broadcom_package(archive))
                apt("install", "-t", BACKPORTS, "--no-install-recommends", "--no-remove", "-y", *targets)
        if firmware:
            subprocess.run([FIRMWARE_HELPER, job[2]], check=True)
    except subprocess.CalledProcessError:
        publish("failed", pack, missing(packs) + ([job[0]] if firmware else []))
        raise
    packages = missing(packs)
    if needs_firmware(job):
        packages.append(job[0])
    publish("failed" if packages else "ready", pack, packages)
    if not packages:
        PENDING.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--stage-offline", action="store_true")
    mode.add_argument("--install-offline", action="store_true")
    mode.add_argument("--online", action="store_true")
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("driver package setup requires root")
    if OOBE.is_file():
        if args.stage_offline:
            stage_offline()
        elif args.install_offline:
            install_offline()
        else:
            online()


if __name__ == "__main__":
    main()
