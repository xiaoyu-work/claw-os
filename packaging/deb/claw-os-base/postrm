#!/bin/sh
# claw-os-base postrm -- purge distribution-level systemd state.

set -e

case "$1" in
    purge)
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper purge cos-home-setup.service >/dev/null || true
        fi
        ;;
    remove|upgrade|abort-install|abort-upgrade|disappear|failed-upgrade)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
