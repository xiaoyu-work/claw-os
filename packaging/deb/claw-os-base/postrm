#!/bin/sh
# claw-os-base postrm -- purge distribution-level systemd state.
#
# The update-security floor under /var/lib/cos/security is never
# removed here: it must survive package removal so a later install of a
# superseded release still has something to be measured against.

set -e

case "$1" in
    purge)
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper purge cos-home-setup.service >/dev/null || true
        fi
        ;;
    remove|upgrade|abort-install|abort-upgrade|disappear|failed-upgrade)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
