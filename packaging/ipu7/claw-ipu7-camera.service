[Unit]
Description=Serve the Intel IPU7 processed camera stream
ConditionPathExistsGlob=/sys/bus/acpi/devices/OVTI08F4:*
ConditionKernelVersion=7.2.*+deb13*-amd64
BindsTo=dev-ipu7\x2dpsys0.device
Requires=claw-ipu7-init.service
After=claw-ipu7-init.service dev-ipu7\x2dpsys0.device

[Service]
ExecCondition=/usr/lib/cos/ipu7/claw-ipu7-camera supported
ExecStart=/usr/lib/cos/ipu7/claw-ipu7-camera relay
Environment=LD_LIBRARY_PATH=/usr/lib/cos/ipu7
Environment=GST_PLUGIN_PATH=/usr/lib/cos/ipu7/gstreamer-1.0
Environment=GST_REGISTRY=/run/claw-ipu7/registry.bin
RuntimeDirectory=claw-ipu7
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=2
PrivateNetwork=yes
PrivateTmp=yes
TemporaryFileSystem=/dev/shm:rw,nosuid,nodev,noexec,mode=0700
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=-/run/camera
NoNewPrivileges=yes
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/ipu7-psys0 rw
DeviceAllow=char-media rw
DeviceAllow=char-video4linux rw
DeviceAllow=char-drm rw
