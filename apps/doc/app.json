{
  "id": "doc",
  "version": "0.1.0",
  "name": {
    "en": "Documents"
  },
  "summary": {
    "en": "Universal document reader — any format in, structured text out"
  },
  "icon": "📄",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 200000,
      "monthly_usd": 2.00
    },
    "models": ["claude-*", "gpt-4o*", "mock-model"],
    "safety": "strict",
    "origins": ["external-content"]
  },
  "operations": {
    "read": {
      "label": { "en": "Read document content (PDF, DOCX, XLSX, PPTX, CSV, etc.)" },
      "args": [
        { "name": "path", "kind": "path", "required": true }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": { "kind": "from-arg", "arg": "path" },
          "why": { "en": "Read the contents of the file you asked to open." }
        }
      ]
    },
    "info": {
      "label": { "en": "Get document metadata without reading full content" },
      "args": [
        { "name": "path", "kind": "path", "required": true }
      ],
      "needs": [
        {
          "verb": "fs.meta",
          "scope": { "kind": "from-arg", "arg": "path" },
          "why": { "en": "Inspect the file's metadata (size, format) without reading its content." }
        }
      ]
    },
    "convert": {
      "label": { "en": "Convert document to another format" },
      "args": [
        { "name": "path", "kind": "path", "required": true },
        { "name": "to",   "kind": "name", "required": true }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": { "kind": "from-arg", "arg": "path" },
          "why": { "en": "Read the source document so it can be converted." }
        },
        {
          "verb": "fs.write",
          "scope": { "kind": "wild" },
          "why": { "en": "Write the converted document to disk." }
        }
      ]
    },
    "summarize": {
      "label": { "en": "Summarize a document into 5 short bullet lines via the AI gate" },
      "args": [
        { "name": "file", "kind": "path", "required": false }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": { "kind": "from-arg", "arg": "file" },
          "why": { "en": "Read the document so its contents can be summarised." }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "fixed",
            "scope": { "kind": "name", "value": "claude-*" }
          },
          "why": { "en": "Send the document text to a model so it can be summarised for you." }
        }
      ]
    },
    "explain": {
      "label": { "en": "Explain the supplied content in plain prose via the AI gate" },
      "args": [
        { "name": "file", "kind": "path", "required": false }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": { "kind": "from-arg", "arg": "file" },
          "why": { "en": "Read the document so it can be explained." }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "fixed",
            "scope": { "kind": "name", "value": "claude-*" }
          },
          "why": { "en": "Send the content to a model so it can be explained for you." }
        }
      ]
    },
    "rewrite": {
      "label": { "en": "Rewrite the supplied content following an instruction" },
      "args": [
        { "name": "file", "kind": "path", "required": false },
        { "name": "instruction", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": { "kind": "from-arg", "arg": "file" },
          "why": { "en": "Read the document so it can be rewritten." }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "fixed",
            "scope": { "kind": "name", "value": "claude-*" }
          },
          "why": { "en": "Send the content to a model to be rewritten per your instruction." }
        }
      ]
    }
  },
  "dependencies": {
    "python": [
      "pymupdf",
      "python-docx",
      "openpyxl",
      "python-pptx"
    ]
  }
}
