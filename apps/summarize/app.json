{
  "id": "summarize",
  "version": "0.1.0",
  "name": {
    "en": "Summarize"
  },
  "summary": {
    "en": "Summarize a block of text using a language model."
  },
  "icon": "📝",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 100000
    },
    "safety": "strict",
    "origins": [
      "external-content"
    ]
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "summarize.run",
        "summary": {
          "en": "Summarize explicitly provided text into three short lines."
        },
        "args": [
          {
            "name": "text",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the text to a model so it can be condensed for you."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "summarize"
              }
            },
            "why": {
              "en": "Remember the summary so the agent can recall it later."
            }
          }
        ]
      }
    ]
  }
}
