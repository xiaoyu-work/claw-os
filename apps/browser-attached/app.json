{
  "id": "browser-attached",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Browser (attached)"
  },
  "summary": {
    "en": "Drive the user's logged-in Chromium tabs through a daemon-authorized Native Messaging bridge"
  },
  "icon": "🦾",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 0
    },
    "safety": "strict",
    "origins": [
      "external-content"
    ]
  },
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
    "tools": [
      {
        "name": "browser-attached.tabs.list",
        "summary": {
          "en": "List open tabs with their ids, titles, URLs, and active state."
        },
        "needs": [
          {
            "verb": "browser.tabs.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Read which tabs are open in your browser."
            }
          }
        ]
      },
      {
        "name": "browser-attached.tabs.activate",
        "summary": {
          "en": "Bring an open tab to the foreground."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "browser.tabs.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Switch focus between tabs you already have open."
            }
          }
        ]
      },
      {
        "name": "browser-attached.nav.go",
        "summary": {
          "en": "Navigate a tab to an HTTP or HTTPS URL."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "url",
            "kind": "text",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "browser.nav",
            "scope": {
              "kind": "from-arg",
              "arg": "url",
              "transform": "url-host"
            },
            "why": {
              "en": "Load only the URL host you specified in the chosen tab."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "browser-attached"
              }
            },
            "why": {
              "en": "Remember the completed navigation for later recall."
            }
          }
        ]
      },
      {
        "name": "browser-attached.dom.query",
        "summary": {
          "en": "Find page elements by CSS selector after binding the request to the tab's current URL."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "selector",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.dom.read",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Read the rendered DOM only while the target tab remains on the declared host."
            }
          }
        ]
      },
      {
        "name": "browser-attached.dom.click",
        "summary": {
          "en": "Click an element returned by dom.query on the declared page host."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "reference",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.dom.write",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Click a page element only while the target tab remains on the declared host."
            }
          }
        ]
      },
      {
        "name": "browser-attached.dom.fill",
        "summary": {
          "en": "Fill a non-secret page field on the declared page host."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "reference",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "value",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.dom.write",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Type into a non-secret field only while the target tab remains on the declared host."
            }
          }
        ]
      },
      {
        "name": "browser-attached.dom.fill_secret",
        "summary": {
          "en": "Fill a password, payment, or OTP field on the declared page host after explicit approval."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "reference",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "value",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.input.secret",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Enter a credential or other secret only while the target tab remains on the declared host."
            }
          }
        ]
      },
      {
        "name": "browser-attached.page.snapshot",
        "summary": {
          "en": "Return a bounded accessibility or text snapshot from the declared page host."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "kind",
            "kind": "name",
            "required": false,
            "binding": "flag",
            "default": "ax",
            "choices": [
              "ax",
              "text"
            ]
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.dom.read",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Read page content only while the target tab remains on the declared host."
            }
          }
        ]
      },
      {
        "name": "browser-attached.page.screenshot",
        "summary": {
          "en": "Capture the visible portion of a tab on the declared page host and atomically create a new PNG."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "output",
            "kind": "path",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.dom.read",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Capture the tab only while it remains on the declared host."
            }
          },
          {
            "verb": "fs.write",
            "scope": {
              "kind": "from-arg",
              "arg": "output"
            },
            "why": {
              "en": "Create the screenshot at the new path you specified without replacing an existing file."
            }
          }
        ]
      },
      {
        "name": "browser-attached.eval",
        "summary": {
          "en": "Run JavaScript in the declared page host after admin approval."
        },
        "args": [
          {
            "name": "tab_id",
            "kind": "integer",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "expr",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "page_url",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "browser.eval",
            "scope": {
              "kind": "from-arg",
              "arg": "page_url",
              "transform": "url-host"
            },
            "why": {
              "en": "Run JavaScript only while the target tab remains on the declared host."
            }
          }
        ]
      }
    ]
  }
}
