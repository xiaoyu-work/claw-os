{
  "id": "calendar",
  "version": "0.1.0",
  "name": {
    "en": "Calendar"
  },
  "summary": {
    "en": "Calendar — local events with optional Google/Outlook sync"
  },
  "icon": "📅",
  "runtime": "python",
  "operations": {
    "list": {
      "label": { "en": "List events in a time range (--from, --to, --provider local|google|outlook)" },
      "args": [
        { "name": "provider", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "data.db.read",
          "scope": { "kind": "fixed", "scope": { "kind": "name", "value": "calendar" } },
          "why": { "en": "Read events from the local calendar database." }
        },
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "When using Google or Outlook, call the provider's API to list events." }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "google": { "kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN" },
              "outlook": { "kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN" }
            }
          },
          "why": { "en": "Load only the selected calendar provider's access token." }
        }
      ]
    },
    "create": {
      "label": { "en": "Create an event (--title, --start, --end, --description, --provider)" },
      "args": [
        { "name": "provider", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "data.db.write",
          "scope": { "kind": "fixed", "scope": { "kind": "name", "value": "calendar" } },
          "why": { "en": "Write the new event into the local calendar database." }
        },
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "When using Google or Outlook, call the provider's API to create the event." }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "google": { "kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN" },
              "outlook": { "kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN" }
            }
          },
          "why": { "en": "Load only the selected calendar provider's access token." }
        },
        {
          "verb": "memory.write",
          "scope": { "kind": "fixed", "scope": { "kind": "self-ref", "value": "calendar" } },
          "why": { "en": "Remember the new event so the agent can recall it later." }
        }
      ]
    },
    "update": {
      "label": { "en": "Update an event (--id, --title, --start, --end, --description, --provider)" },
      "args": [
        { "name": "provider", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "data.db.write",
          "scope": { "kind": "fixed", "scope": { "kind": "name", "value": "calendar" } },
          "why": { "en": "Update the existing event in the local calendar database." }
        },
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "When using Google or Outlook, call the provider's API to update the event." }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "google": { "kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN" },
              "outlook": { "kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN" }
            }
          },
          "why": { "en": "Load only the selected calendar provider's access token." }
        },
        {
          "verb": "memory.write",
          "scope": { "kind": "fixed", "scope": { "kind": "self-ref", "value": "calendar" } },
          "why": { "en": "Remember the change so the agent can recall what was updated." }
        }
      ]
    },
    "delete": {
      "label": { "en": "Delete an event (--id, --provider)" },
      "args": [
        { "name": "provider", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "data.db.write",
          "scope": { "kind": "fixed", "scope": { "kind": "name", "value": "calendar" } },
          "why": { "en": "Remove the event from the local calendar database." }
        },
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "When using Google or Outlook, call the provider's API to delete the event." }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "google": { "kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN" },
              "outlook": { "kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN" }
            }
          },
          "why": { "en": "Load only the selected calendar provider's access token." }
        },
        {
          "verb": "memory.write",
          "scope": { "kind": "fixed", "scope": { "kind": "self-ref", "value": "calendar" } },
          "why": { "en": "Remember the deletion so the agent can recall the change later." }
        }
      ]
    },
    "today": {
      "label": { "en": "Show today's events (shortcut for list --from today --to tomorrow)" },
      "args": [
        { "name": "provider", "kind": "name", "required": false }
      ],
      "needs": [
        {
          "verb": "data.db.read",
          "scope": { "kind": "fixed", "scope": { "kind": "name", "value": "calendar" } },
          "why": { "en": "Read today's events from the local calendar database." }
        },
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "When using Google or Outlook, call the provider's API to list today's events." }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "google": { "kind": "name", "value": "default/GOOGLE_ACCESS_TOKEN" },
              "outlook": { "kind": "name", "value": "default/MICROSOFT_ACCESS_TOKEN" }
            }
          },
          "why": { "en": "Load only the selected calendar provider's access token." }
        }
      ]
    }
  }
}
