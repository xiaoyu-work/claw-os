  "operations": {
    "list": {
      "label": {
        "en": "List events in a time range (--from, --to, --provider local|google|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "local",
            "google",
            "outlook"
          ]
        },
        {
          "name": "from",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "to",
          "kind": "text",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "data.db.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "calendar"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "local"
          },
          "why": {
            "en": "Read events from the local calendar database."
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "www.googleapis.com"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "google"
          },
          "why": {
            "en": "Call the Google calendar API only when selected."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/GOOGLE_ACCESS_TOKEN"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "google"
          },
          "why": {
            "en": "Read only the Google calendar credential when selected."
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          },
          "why": {
            "en": "Call the Outlook calendar API only when selected."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/MICROSOFT_ACCESS_TOKEN"
            }
