{
  "id": "launcher",
  "version": "0.1.0",
  "name": {
    "en": "Launcher",
    "zh_CN": "启动器"
  },
  "summary": {
    "en": "Find and launch installed desktop (GUI) applications by name or AppID.",
    "zh_CN": "按名字或 AppID 查找并启动已安装的图形界面应用。"
  },
  "icon": "🪟",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "launcher.list",
        "summary": {
          "en": "Enumerate every `.desktop` entry installed under the standard XDG application directories. Returns AppID, localized name, comment, categories, keywords, and icon."
        },
        "args": [
          {
            "name": "include_no_display",
            "kind": "bool",
            "required": false,
            "binding": "flag",
            "default": false
          },
          {
            "name": "include_hidden",
            "kind": "bool",
            "required": false,
            "binding": "flag",
            "default": false
          }
        ],
        "needs": [
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries shipped by system packages."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed locally as admin."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "~/.local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed in your home directory."
            }
          }
        ]
      },
      {
        "name": "launcher.find",
        "summary": {
          "en": "Fuzzy-search installed apps by localized name, generic name, comment, or keywords. Returns the top matches ranked by relevance."
        },
        "args": [
          {
            "name": "query",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 10
          }
        ],
        "needs": [
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries shipped by system packages."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed locally as admin."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "~/.local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed in your home directory."
            }
          }
        ]
      },
      {
        "name": "launcher.open",
        "summary": {
          "en": "Launch an installed graphical app. `app_id` is the AppID — the `.desktop` filename without extension (e.g. `com.clawos.Files`, `org.mozilla.firefox`). Repeat `--uri` for absolute non-file URIs and `--path` for exact local files the app should open."
        },
        "args": [
          {
            "name": "app_id",
            "kind": "name",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "uri",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "repeatable": true
          },
          {
            "name": "path",
            "kind": "path",
            "required": false,
            "binding": "flag",
            "repeatable": true
          }
        ],
        "needs": [
          {
            "verb": "desktop.launch",
            "scope": {
              "kind": "from-arg",
              "arg": "app_id"
            },
            "why": {
              "en": "Open the graphical application you asked to launch."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "from-arg",
              "arg": "path"
            },
            "when": {
              "kind": "arg-present",
              "arg": "path"
            },
            "why": {
              "en": "Allow the launched application to read each exact local file you asked it to open."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries shipped by system packages."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed locally as admin."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "~/.local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed in your home directory."
            }
          }
        ]
      },
      {
        "name": "launcher.recent",
        "summary": {
          "en": "Show desktop apps the agent has launched recently, newest first. Useful for re-opening the last app the user worked with."
        },
        "args": [
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 20
          }
        ]
      },
      {
        "name": "launcher.is-running",
        "summary": {
          "en": "Look for live processes whose executable matches the AppID's `Exec=` binary. Returns the list of matching PIDs (empty if the app is not running)."
        },
        "args": [
          {
            "name": "app_id",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "proc.observe",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Scan the process list for the app you asked about."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries shipped by system packages."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "/usr/local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed locally as admin."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "path",
                "value": "~/.local/share/applications/**"
              }
            },
            "why": {
              "en": "Read `.desktop` entries installed in your home directory."
            }
          }
        ]
      }
    ]
  }
}
