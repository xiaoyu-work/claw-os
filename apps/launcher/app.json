{
  "id": "launcher",
  "version": "0.1.0",
  "name": {
    "en": "Launcher",
    "zh_CN": "启动器"
  },
  "summary": {
    "en": "Find and launch installed desktop (GUI) applications by name or AppID.",
    "zh_CN": "按名字或 AppID 查找并启动已安装的图形界面应用。"
  },
  "icon": "🪟",
  "runtime": "python",
  "operations": {
    "list": {
      "label": {
        "en": "List installed desktop apps"
      },
      "summary": {
        "en": "Enumerate every `.desktop` entry installed under the standard XDG application directories. Returns AppID, localized name, comment, categories, keywords, and icon."
      },
      "args": [
        {
          "name": "include-no-display",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        },
        {
          "name": "include-hidden",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries shipped by system packages."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/local/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed locally as admin."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$XDG_DATA_HOME/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed in your home directory."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$HOME/.local/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed under ~/.local/share/applications."
          }
        }
      ]
    },
    "find": {
      "label": {
        "en": "Find a desktop app by name or keyword"
      },
      "summary": {
        "en": "Fuzzy-search installed apps by localized name, generic name, comment, or keywords. Returns the top matches ranked by relevance."
      },
      "args": [
        {
          "name": "query",
          "kind": "name",
          "required": true
        },
        {
          "name": "limit",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 10
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries shipped by system packages."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/local/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed locally as admin."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$XDG_DATA_HOME/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed in your home directory."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$HOME/.local/share/applications/**"
            }
          },
          "why": {
            "en": "Read `.desktop` entries installed under ~/.local/share/applications."
          }
        }
      ]
    },
    "open": {
      "label": {
        "en": "Launch a desktop app by AppID"
      },
      "summary": {
        "en": "Launch an installed graphical app. `app_id` is the AppID — the `.desktop` filename without extension (e.g. `com.clawos.Files`, `org.mozilla.firefox`). Extra positional arguments are passed as URIs/paths the app should open."
      },
      "args": [
        {
          "name": "app_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "uri_or_path",
          "kind": "text",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "desktop.launch",
          "scope": {
            "kind": "from-arg",
            "arg": "app_id"
          },
          "why": {
            "en": "Open the graphical application you asked to launch."
          }
        }
      ]
    },
    "recent": {
      "label": {
        "en": "List recently launched apps"
      },
      "summary": {
        "en": "Show desktop apps the agent has launched recently, newest first. Useful for re-opening the last app the user worked with."
      },
      "args": [
        {
          "name": "limit",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 20
        }
      ],
      "needs": []
    },
    "is-running": {
      "label": {
        "en": "Check if a desktop app is running"
      },
      "summary": {
        "en": "Look for live processes whose executable matches the AppID's `Exec=` binary. Returns the list of matching PIDs (empty if the app is not running)."
      },
      "args": [
        {
          "name": "app_id",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "proc.observe",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Scan the process list for the app you asked about."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/share/applications/**"
            }
          },
          "why": {
            "en": "Resolve the AppID to its `.desktop` entry so we know which binary to look for."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/usr/local/share/applications/**"
            }
          },
          "why": {
            "en": "Same, for admin-installed entries."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$XDG_DATA_HOME/applications/**"
            }
          },
          "why": {
            "en": "Same, for entries under $XDG_DATA_HOME."
          }
        },
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "$HOME/.local/share/applications/**"
            }
          },
          "why": {
            "en": "Same, for entries under ~/.local/share/applications."
          }
        }
      ]
    }
  },
  "dependencies": {
    "binaries": [],
    "optional_binaries": [
      "gtk-launch",
      "gio"
    ]
  }
}
