{
  "id": "fs",
  "version": "0.1.0",
  "name": {
    "en": "Files",
    "zh-CN": "文件"
  },
  "summary": {
    "en": "Agent-native file system with metadata and search."
  },
  "icon": "📁",
  "runtime": "python",
  "entry": "main.py",
  "objects": {
    "file": {
      "label": { "en": "File", "zh-CN": "文件" },
      "summary": { "en": "Metadata for the filesystem object at an absolute path. Renames require updating the reference." },
      "resolve": { "operation": "stat", "id_arg": "path" }
    },
    "change-plan": {
      "label": { "en": "File change plan" },
      "summary": { "en": "An App-owned write proposal for an absolute path. Its revision selects a plan, not write authority." },
      "resolve": { "operation": "plan_show", "id_arg": "path", "revision_arg": "plan" }
    }
  },
  "operations": {
    "plan_write": {
      "label": { "en": "Prepare a bounded UTF-8 file write plan without changing the target" },
      "stdin": true,
      "args": [
        {"name": "path", "kind": "path", "required": true},
        {"name": "content", "kind": "text", "binding": "flag"},
        {"name": "ttl_seconds", "kind": "integer", "binding": "flag", "default": 3600}
      ],
      "needs": [
        {"verb": "fs.read", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Read the target baseline to compute a real diff."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Persist the private App-owned proposal and review fingerprint."}}
      ],
      "effects": [
        {"kind": "read", "label": {"en": "Read the requested file baseline"}, "target_arg": "path", "recovery": "not_applicable"},
        {"kind": "create", "label": {"en": "Save App-owned plan data; the target file is not changed"}, "recovery": "unknown"}
      ]
    },
    "plan_show": {
      "label": { "en": "Read a stored file plan; omit --plan to select the newest for this path" },
      "args": [
        {"name": "path", "kind": "path", "required": true},
        {"name": "plan", "kind": "name", "binding": "flag"}
      ],
      "needs": [
        {"verb": "fs.read", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Require current read authority before disclosing cached content for this target."}},
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Read the App-owned proposal data."}}
      ],
      "effects": [
        {"kind": "read", "label": {"en": "Read a cached proposal for the requested target, not its current contents"}, "target_arg": "path", "recovery": "not_applicable"}
      ]
    },
    "plan_apply": {
      "label": { "en": "Apply a reviewed plan through the file broker after conflict checks" },
      "args": [
        {"name": "path", "kind": "path", "required": true},
        {"name": "plan", "kind": "name", "binding": "flag", "required": true},
        {"name": "review", "kind": "name", "binding": "flag", "required": true},
        {"name": "confirm", "kind": "bool", "binding": "flag", "required": true, "choices": [true]}
      ],
      "needs": [
        {"verb": "fs.read", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Check that the reviewed file baseline still matches."}},
        {"verb": "fs.write", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Apply the reviewed bytes only to the explicitly authorized target."}},
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Read the proposal and its review fingerprint."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Durably bracket apply and record its reported outcome."}}
      ],
      "effects": [
        {"kind": "update", "label": {"en": "Apply reviewed content only if the file state still matches"}, "target_arg": "path", "recovery": "unknown"},
        {"kind": "update", "label": {"en": "Record the plan lifecycle; uncertain outcomes cannot be replayed"}, "recovery": "unknown"}
      ]
    },
    "plan_prune": {
      "label": { "en": "Explicitly prune consumed or expired plans without changing target files" },
      "args": [
        {"name": "path", "kind": "path", "required": true},
        {"name": "keep", "kind": "integer", "binding": "flag", "default": 10},
        {"name": "confirm", "kind": "bool", "binding": "flag", "required": true, "choices": [true]}
      ],
      "needs": [
        {"verb": "fs.read", "scope": {"kind": "from-arg", "arg": "path"}, "why": {"en": "Require target read authority before inspecting its cached plan records."}},
        {"verb": "data.db.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Inspect only this target's plan lifecycle records."}},
        {"verb": "data.db.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "fs-change-plans"}}, "why": {"en": "Remove only consumed or expired App-owned plan records."}}
      ],
      "effects": [
        {"kind": "delete", "label": {"en": "Delete retired App-owned plan records, never the target file"}, "recovery": "unknown"}
      ]
    },
    "ls": {
      "label": {
        "en": "List files",
        "zh-CN": "列出文件"
      },
      "summary": {
        "en": "Show the names of files inside a folder."
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": false,
          "default": "."
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read the contents of the folder you asked to list."
          }
        }
      ]
    },
    "read": {
      "label": {
        "en": "Read a file",
        "zh-CN": "读取文件"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "offset",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 0
        },
        {
          "name": "limit",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 1000000
        },
        {
          "name": "start",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "end",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read the file you asked to open."
          }
        }
      ]
    },
    "write": {
      "effects": [
        {"kind": "update", "label": {"en": "Write the requested file contents"}, "target_arg": "path", "recovery": "unknown"}
      ],
      "label": {
        "en": "Write to a file",
        "zh-CN": "写入文件"
      },
      "stdin": true,
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "content",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Write the content you provided to that file."
          }
        }
      ]
    },
    "rm": {
      "effects": [
        {"kind": "delete", "label": {"en": "Remove the requested filesystem object"}, "target_arg": "path", "recovery": "unknown"}
      ],
      "label": {
        "en": "Delete a file",
        "zh-CN": "删除文件"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.delete",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Remove the file you specified."
          }
        }
      ]
    },
    "mkdir": {
      "label": {
        "en": "Create a folder",
        "zh-CN": "创建文件夹"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Create a new folder at that path."
          }
        }
      ]
    },
    "stat": {
      "effects": [
        {"kind": "read", "label": {"en": "Inspect metadata for the requested filesystem object"}, "target_arg": "path", "recovery": "not_applicable"}
      ],
      "label": {
        "en": "Show file info",
        "zh-CN": "显示文件信息"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.meta",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read metadata (size, dates, tags) for the file you asked about."
          }
        }
      ]
    },
    "search": {
      "label": {
        "en": "Search files",
        "zh-CN": "搜索文件"
      },
      "args": [
        {
          "name": "query",
          "kind": "text",
          "required": true
        },
        {
          "name": "path",
          "kind": "path",
          "required": false,
          "default": "/workspace"
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Scan files under the path you specified for the search query."
          }
        }
      ]
    },
    "tag": {
      "label": {
        "en": "Tag a file",
        "zh-CN": "标记文件"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "tags",
          "kind": "text",
          "required": true,
          "repeatable": true
        }
      ],
      "needs": [
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "path",
            "transform": "parent"
          },
          "why": {
            "en": "Update the metadata sidecar next to the file with the new tags."
          }
        }
      ]
    },
    "recent": {
      "label": {
        "en": "Recently changed files",
        "zh-CN": "最近更改的文件"
      },
      "args": [
        {
          "name": "n",
          "kind": "integer",
          "required": false,
          "default": 10
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "path",
              "value": "/workspace/**"
            }
          },
          "why": {
            "en": "Walk the workspace to find recently modified files."
          }
        }
      ]
    },
    "rename": {
      "label": {
        "en": "Rename a file or folder"
      },
      "args": [
        {
          "name": "src",
          "kind": "path",
          "required": true
        },
        {
          "name": "dst",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.delete",
          "scope": {
            "kind": "from-arg",
            "arg": "src"
          },
          "why": {
            "en": "Remove the source path after renaming it."
          }
        },
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "dst"
          },
          "why": {
            "en": "Create the renamed item at the destination path."
          }
        }
      ]
    },
    "move": {
      "label": {
        "en": "Move a file or folder"
      },
      "args": [
        {
          "name": "src",
          "kind": "path",
          "required": true
        },
        {
          "name": "dst",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.delete",
          "scope": {
            "kind": "from-arg",
            "arg": "src"
          },
          "why": {
            "en": "Remove the item from its source path."
          }
        },
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "dst"
          },
          "why": {
            "en": "Create the moved item at the destination path."
          }
        }
      ]
    },
    "copy": {
      "label": {
        "en": "Copy a file or folder"
      },
      "args": [
        {
          "name": "src",
          "kind": "path",
          "required": true
        },
        {
          "name": "dst",
          "kind": "path",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "src"
          },
          "why": {
            "en": "Read the source item you asked to copy."
          }
        },
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "dst"
          },
          "why": {
            "en": "Create the copied item at the destination path."
          }
        }
      ]
    },
    "read_bytes": {
      "label": {
        "en": "Read binary file data"
      },
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "offset",
          "kind": "integer",
          "binding": "flag",
          "required": false,
          "default": 0
        },
        {
          "name": "limit",
          "kind": "integer",
          "binding": "flag",
          "required": false,
          "default": 8388608
        }
      ],
      "needs": [
        {
          "verb": "fs.read",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Read binary data from the file you specified."
          }
        }
      ]
    },
    "write_bytes": {
      "label": {
        "en": "Write binary file data"
      },
      "stdin": true,
      "args": [
        {
          "name": "path",
          "kind": "path",
          "required": true
        },
        {
          "name": "content",
          "kind": "text",
          "binding": "flag",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "fs.write",
          "scope": {
            "kind": "from-arg",
            "arg": "path"
          },
          "why": {
            "en": "Write binary data to the file you specified."
          }
        }
      ]
    }
  },
  "dependencies": {
    "system": [
      "coreutils",
      "ripgrep"
    ]
  }
}
