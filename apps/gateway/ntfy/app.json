{
  "id": "gateway-ntfy",
  "version": "0.1.0",
  "name": {
    "en": "ntfy Gateway"
  },
  "summary": {
    "en": "ntfy.sh push-notification gateway. POSTs plain-text bodies to a configured server and topic with optional authentication and ntfy headers."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "topic",
          "kind": "name",
          "required": false
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        },
        {
          "name": "title",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "priority",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "tags",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "click",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "markdown",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        },
        {
          "name": "server",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "bearer",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "basic",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_server"
            }
          },
          "why": {
            "en": "Read the configured ntfy_server secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_default_topic"
            }
          },
          "why": {
            "en": "Read the configured ntfy_default_topic secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_token"
            }
          },
          "why": {
            "en": "Read the configured ntfy_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-ntfy"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_server"
            }
          },
          "why": {
            "en": "Read the configured ntfy_server secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_default_topic"
            }
          },
          "why": {
            "en": "Read the configured ntfy_default_topic secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/ntfy_token"
            }
          },
          "why": {
            "en": "Read the configured ntfy_token secret required by this gateway."
          }
        }
      ]
    }
  }
}
