{
  "id": "gateway-discord",
  "version": "0.2.0",
  "name": {
    "en": "Discord Gateway"
  },
  "summary": {
    "en": "Discord gateway. send posts messages through the Bot REST API; gateway WebSocket start and stop are not implemented."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "channel_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "discord.com"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/discord_bot_token"
            }
          },
          "why": {
            "en": "Read the configured discord_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-discord"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": []
    }
  }
}
