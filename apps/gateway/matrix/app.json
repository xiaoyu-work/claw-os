{
  "id": "gateway-matrix",
  "version": "0.1.0",
  "name": {
    "en": "Matrix Gateway"
  },
  "summary": {
    "en": "Matrix gateway. send posts text messages to rooms through the Client-Server REST API; sync start and stop are not implemented."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "room_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/matrix_access_token"
            }
          },
          "why": {
            "en": "Read the configured matrix_access_token secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/matrix_homeserver"
            }
          },
          "why": {
            "en": "Read the configured matrix_homeserver secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-matrix"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/matrix_homeserver"
            }
          },
          "why": {
            "en": "Read the configured matrix_homeserver secret required by this gateway."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "gateway-matrix.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "room_id",
            "kind": "name",
            "required": true
          },
          {
            "name": "text",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/matrix_access_token"
              }
            },
            "why": {
              "en": "Read the configured matrix_access_token secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/matrix_homeserver"
              }
            },
            "why": {
              "en": "Read the configured matrix_homeserver secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-matrix"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-matrix.status",
        "summary": {
          "en": "Show gateway configuration and status"
        },
        "needs": [
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/matrix_homeserver"
              }
            },
            "why": {
              "en": "Read the configured matrix_homeserver secret required by this gateway."
            }
          }
        ]
      }
    ]
  }
}
