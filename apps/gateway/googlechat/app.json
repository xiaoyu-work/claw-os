{
  "id": "gateway-googlechat",
  "version": "0.1.0",
  "name": {
    "en": "Google Chat Gateway"
  },
  "summary": {
    "en": "Outbound-only Google Chat gateway via a space Incoming Webhook. send POSTs text or card v2 messages."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "recipient",
          "kind": "name",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "title",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "thread_key",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/googlechat_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured googlechat_webhook_url secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-googlechat"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/googlechat_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured googlechat_webhook_url secret required by this gateway."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "gateway-googlechat.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "text",
            "kind": "text",
            "required": true
          },
          {
            "name": "recipient",
            "kind": "name",
            "required": false
          },
          {
            "name": "title",
            "kind": "text",
            "required": false
          },
          {
            "name": "thread_key",
            "kind": "text",
            "required": false
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/googlechat_webhook_url"
              }
            },
            "why": {
              "en": "Read the configured googlechat_webhook_url secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-googlechat"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-googlechat.status",
        "summary": {
          "en": "Show gateway configuration and status"
        },
        "needs": [
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/googlechat_webhook_url"
              }
            },
            "why": {
              "en": "Read the configured googlechat_webhook_url secret required by this gateway."
            }
          }
        ]
      }
    ]
  }
}
