{
  "id": "gateway-googlechat",
  "version": "0.1.0",
  "name": {
    "en": "Google Chat Gateway"
  },
  "summary": {
    "en": "Outbound-only Google Chat gateway via a space Incoming Webhook. send POSTs text or card v2 messages."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "recipient",
          "kind": "name",
          "required": false
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/googlechat_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured googlechat_webhook_url secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-googlechat"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/googlechat_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured googlechat_webhook_url secret required by this gateway."
          }
        }
      ]
    }
  }
}
