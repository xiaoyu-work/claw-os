{
  "id": "gateway-pushover",
  "version": "0.1.0",
  "name": {
    "en": "Pushover Gateway"
  },
  "summary": {
    "en": "Outbound-only Pushover push-notification gateway. send POSTs notifications to a user or group through the Pushover API."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "api.pushover.net"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_app_token"
            }
          },
          "why": {
            "en": "Read the configured pushover_app_token secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_user_key"
            }
          },
          "why": {
            "en": "Read the configured pushover_user_key secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-pushover"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_app_token"
            }
          },
          "why": {
            "en": "Read the configured pushover_app_token secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_user_key"
            }
          },
          "why": {
            "en": "Read the configured pushover_user_key secret required by this gateway."
          }
        }
      ]
    }
  }
}
