{
  "id": "gateway-pushover",
  "version": "0.1.0",
  "name": {
    "en": "Pushover Gateway"
  },
  "summary": {
    "en": "Outbound-only Pushover push-notification gateway. send POSTs notifications to a user or group through the Pushover API."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "recipient",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "title",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "priority",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "sound",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "url",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "url_title",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "device",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "ttl",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "retry",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "expire",
          "kind": "integer",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "html",
          "kind": "bool",
          "required": false,
          "default": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "api.pushover.net"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_app_token"
            }
          },
          "why": {
            "en": "Read the configured pushover_app_token secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_user_key"
            }
          },
          "why": {
            "en": "Read the configured pushover_user_key secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-pushover"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_app_token"
            }
          },
          "why": {
            "en": "Read the configured pushover_app_token secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/pushover_user_key"
            }
          },
          "why": {
            "en": "Read the configured pushover_user_key secret required by this gateway."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "gateway-pushover.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "text",
            "kind": "text",
            "required": true
          },
          {
            "name": "recipient",
            "kind": "text",
            "required": false
          },
          {
            "name": "title",
            "kind": "text",
            "required": false
          },
          {
            "name": "priority",
            "kind": "integer",
            "required": false
          },
          {
            "name": "sound",
            "kind": "text",
            "required": false
          },
          {
            "name": "url",
            "kind": "text",
            "required": false
          },
          {
            "name": "url_title",
            "kind": "text",
            "required": false
          },
          {
            "name": "device",
            "kind": "text",
            "required": false
          },
          {
            "name": "ttl",
            "kind": "integer",
            "required": false
          },
          {
            "name": "retry",
            "kind": "integer",
            "required": false
          },
          {
            "name": "expire",
            "kind": "integer",
            "required": false
          },
          {
            "name": "html",
            "kind": "bool",
            "required": false,
            "default": false
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "host",
                "value": "api.pushover.net"
              }
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/pushover_app_token"
              }
            },
            "why": {
              "en": "Read the configured pushover_app_token secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/pushover_user_key"
              }
            },
            "why": {
              "en": "Read the configured pushover_user_key secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-pushover"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-pushover.status",
        "summary": {
          "en": "Show gateway configuration and status"
        },
        "needs": [
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/pushover_app_token"
              }
            },
            "why": {
              "en": "Read the configured pushover_app_token secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/pushover_user_key"
              }
            },
            "why": {
              "en": "Read the configured pushover_user_key secret required by this gateway."
            }
          }
        ]
      }
    ]
  }
}
