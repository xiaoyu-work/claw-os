{
  "id": "gateway-email",
  "version": "0.1.0",
  "name": {
    "en": "Email Gateway"
  },
  "summary": {
    "en": "Outbound-only SMTP email gateway. send delivers a one-shot text email through the configured SMTP server."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "to",
          "kind": "name",
          "required": true
        },
        {
          "name": "subject",
          "kind": "text",
          "required": true
        },
        {
          "name": "body",
          "kind": "text",
          "required": true
        },
        {
          "name": "cc",
          "kind": "text",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_host"
            }
          },
          "why": {
            "en": "Read the configured smtp_host secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_port"
            }
          },
          "why": {
            "en": "Read the configured smtp_port secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_user"
            }
          },
          "why": {
            "en": "Read the configured smtp_user secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_password"
            }
          },
          "why": {
            "en": "Read the configured smtp_password secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_from"
            }
          },
          "why": {
            "en": "Read the configured smtp_from secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-email"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_host"
            }
          },
          "why": {
            "en": "Read the configured smtp_host secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_port"
            }
          },
          "why": {
            "en": "Read the configured smtp_port secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_user"
            }
          },
          "why": {
            "en": "Read the configured smtp_user secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_password"
            }
          },
          "why": {
            "en": "Read the configured smtp_password secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/smtp_from"
            }
          },
          "why": {
            "en": "Read the configured smtp_from secret required by this gateway."
          }
        }
      ]
    }
  }
}
