{
  "id": "gateway-webex",
  "version": "0.1.0",
  "name": {
    "en": "Webex Gateway"
  },
  "summary": {
    "en": "Outbound-only Webex gateway via REST API. send POSTs Markdown or text messages to a room, person email, or person ID."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "recipient",
          "kind": "name",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "plain",
          "kind": "bool",
          "required": false,
          "default": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "webexapis.com"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webex_bot_token"
            }
          },
          "why": {
            "en": "Read the configured webex_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-webex"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webex_bot_token"
            }
          },
          "why": {
            "en": "Read the configured webex_bot_token secret required by this gateway."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
    "tools": [
      {
        "name": "gateway-webex.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "recipient",
            "kind": "name",
            "required": true
          },
          {
            "name": "text",
            "kind": "text",
            "required": true
          },
          {
            "name": "plain",
            "kind": "bool",
            "required": false,
            "default": false
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "host",
                "value": "webexapis.com"
              }
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/webex_bot_token"
              }
            },
            "why": {
              "en": "Read the configured webex_bot_token secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-webex"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-webex.status",
        "summary": {
          "en": "Show gateway configuration and status"
        },
        "needs": [
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/webex_bot_token"
              }
            },
            "why": {
              "en": "Read the configured webex_bot_token secret required by this gateway."
            }
          }
        ]
      }
    ]
  }
}
