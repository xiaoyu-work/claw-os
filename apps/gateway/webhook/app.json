{
  "id": "gateway-webhook",
  "version": "0.1.0",
  "name": {
    "en": "Generic Webhook Gateway"
  },
  "summary": {
    "en": "Generic outbound webhook gateway. POSTs JSON or text to any configured URL with optional bearer, basic, API-key, or HMAC-SHA256 authentication."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "target",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "bearer",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "basic",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "api-key",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "hmac-sha256",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "raw",
          "kind": "bool",
          "required": false,
          "default": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webhook_default_url"
            }
          },
          "why": {
            "en": "Read the configured webhook_default_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webhook_default_secret"
            }
          },
          "why": {
            "en": "Read the configured webhook_default_secret secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-webhook"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webhook_default_url"
            }
          },
          "why": {
            "en": "Read the configured webhook_default_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/webhook_default_secret"
            }
          },
          "why": {
            "en": "Read the configured webhook_default_secret secret required by this gateway."
          }
        }
      ]
    }
  }
}
