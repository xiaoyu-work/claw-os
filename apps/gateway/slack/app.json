{
  "id": "gateway-slack",
  "version": "0.2.0",
  "name": {
    "en": "Slack Gateway"
  },
  "summary": {
    "en": "Slack gateway. send posts through Web API chat.postMessage; Socket Mode and Events HTTP start and stop are not implemented."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "channel_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "slack.com"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/slack_bot_token"
            }
          },
          "why": {
            "en": "Read the configured slack_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-slack"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": []
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "gateway-slack.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "channel_id",
            "kind": "name",
            "required": true
          },
          {
            "name": "text",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "host",
                "value": "slack.com"
              }
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/slack_bot_token"
              }
            },
            "why": {
              "en": "Read the configured slack_bot_token secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-slack"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-slack.status",
        "summary": {
          "en": "Show gateway configuration and status"
        }
      }
    ]
  }
}
