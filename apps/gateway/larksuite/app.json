{
  "id": "gateway-larksuite",
  "version": "0.1.0",
  "name": {
    "en": "Lark / Feishu Gateway"
  },
  "summary": {
    "en": "Outbound-only Lark / Feishu custom-bot gateway. send POSTs text, rich-text, or interactive-card messages with optional HMAC-SHA256 signing."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "binding": "positional"
        },
        {
          "name": "title",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "card_json",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "post",
          "kind": "bool",
          "required": false,
          "default": false,
          "binding": "flag"
        },
        {
          "name": "card",
          "kind": "bool",
          "required": false,
          "default": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/lark_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured lark_webhook_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/lark_secret"
            }
          },
          "why": {
            "en": "Read the configured lark_secret secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-larksuite"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/lark_webhook_url"
            }
          },
          "why": {
            "en": "Read the configured lark_webhook_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/lark_secret"
            }
          },
          "why": {
            "en": "Read the configured lark_secret secret required by this gateway."
          }
        }
      ]
    }
  }
}
