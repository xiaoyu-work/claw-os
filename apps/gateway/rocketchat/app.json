{
  "id": "gateway-rocketchat",
  "version": "0.1.0",
  "name": {
    "en": "Rocket.Chat Gateway"
  },
  "summary": {
    "en": "Rocket.Chat gateway. POSTs messages through the chat.postMessage API using personal access-token headers."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_site"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_site secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_user_id"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_user_id secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_token"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-rocketchat"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_site"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_site secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_user_id"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_user_id secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/rocketchat_token"
            }
          },
          "why": {
            "en": "Read the configured rocketchat_token secret required by this gateway."
          }
        }
      ]
    }
  }
}
