{
  "id": "gateway-zulip",
  "version": "0.1.0",
  "name": {
    "en": "Zulip Gateway"
  },
  "summary": {
    "en": "Zulip chat gateway. POSTs messages to a Zulip realm using HTTP basic authentication with a bot email and API key."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "recipient",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_site"
            }
          },
          "why": {
            "en": "Read the configured zulip_site secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_bot_email"
            }
          },
          "why": {
            "en": "Read the configured zulip_bot_email secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_bot_api_key"
            }
          },
          "why": {
            "en": "Read the configured zulip_bot_api_key secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-zulip"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_site"
            }
          },
          "why": {
            "en": "Read the configured zulip_site secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_bot_email"
            }
          },
          "why": {
            "en": "Read the configured zulip_bot_email secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/zulip_bot_api_key"
            }
          },
          "why": {
            "en": "Read the configured zulip_bot_api_key secret required by this gateway."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
    "tools": [
      {
        "name": "gateway-zulip.send",
        "summary": {
          "en": "Send a message through this gateway"
        },
        "args": [
          {
            "name": "recipient",
            "kind": "name",
            "required": true
          },
          {
            "name": "text",
            "kind": "text",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Connect to the remote gateway service to perform the send operation."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_site"
              }
            },
            "why": {
              "en": "Read the configured zulip_site secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_bot_email"
              }
            },
            "why": {
              "en": "Read the configured zulip_bot_email secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_bot_api_key"
              }
            },
            "why": {
              "en": "Read the configured zulip_bot_api_key secret required by this gateway."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "gateway-zulip"
              }
            },
            "why": {
              "en": "Remember the successful send so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "gateway-zulip.status",
        "summary": {
          "en": "Show gateway configuration and status"
        },
        "needs": [
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_site"
              }
            },
            "why": {
              "en": "Read the configured zulip_site secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_bot_email"
              }
            },
            "why": {
              "en": "Read the configured zulip_bot_email secret required by this gateway."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "default/zulip_bot_api_key"
              }
            },
            "why": {
              "en": "Read the configured zulip_bot_api_key secret required by this gateway."
            }
          }
        ]
      }
    ]
  }
}
