{
  "id": "gateway-telegram",
  "version": "0.2.0",
  "name": {
    "en": "Telegram Gateway"
  },
  "summary": {
    "en": "Telegram bot gateway. Long-polls the Telegram Bot API, forwards inbound messages to an agent, and replies with its response."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "chat_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true,
          "repeatable": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "api.telegram.org"
            }
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/telegram_bot_token"
            }
          },
          "why": {
            "en": "Read the configured telegram_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-telegram"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "proc.observe",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Observe the Telegram gateway process to report its running state."
          }
        }
      ]
    },
    "start": {
      "label": {
        "en": "Start the Telegram long-poll gateway"
      },
      "args": [],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "api.telegram.org"
            }
          },
          "why": {
            "en": "Connect to the Telegram Bot API for long polling and replies."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/telegram_bot_token"
            }
          },
          "why": {
            "en": "Read the configured telegram_bot_token secret required by this gateway."
          }
        },
        {
          "verb": "data.inbox.write",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Store inbound Telegram messages in the data inbox."
          }
        },
        {
          "verb": "agent.spawn",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Spawn an agent to answer inbound Telegram messages."
          }
        },
        {
          "verb": "proc.observe",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Check whether an existing Telegram gateway process is already running."
          }
        }
      ]
    },
    "stop": {
      "label": {
        "en": "Stop the Telegram gateway"
      },
      "args": [],
      "needs": [
        {
          "verb": "proc.signal",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Signal the running Telegram gateway process to stop."
          }
        },
        {
          "verb": "proc.observe",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Check whether the Telegram gateway process is still running."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
    "tools": [
