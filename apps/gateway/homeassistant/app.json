{
  "id": "gateway-homeassistant",
  "version": "0.1.0",
  "name": {
    "en": "Home Assistant Gateway"
  },
  "summary": {
    "en": "Home Assistant gateway. Calls REST service endpoints using a long-lived access token."
  },
  "runtime": "python",
  "operations": {
    "send": {
      "label": {
        "en": "Send a message through this gateway"
      },
      "args": [
        {
          "name": "service",
          "kind": "name",
          "required": true
        },
        {
          "name": "text",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the send operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_url"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_token"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_token secret required by this gateway."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "gateway-homeassistant"
            }
          },
          "why": {
            "en": "Remember the successful send so the agent can recall it later."
          }
        }
      ]
    },
    "status": {
      "label": {
        "en": "Show gateway configuration and status"
      },
      "args": [],
      "needs": [
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_url"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_token"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_token secret required by this gateway."
          }
        }
      ]
    },
    "call": {
      "label": {
        "en": "Call a Home Assistant service with a raw payload"
      },
      "args": [
        {
          "name": "service",
          "kind": "name",
          "required": true
        },
        {
          "name": "json",
          "kind": "text",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Connect to the remote gateway service to perform the call operation."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_url"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_url secret required by this gateway."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "default/homeassistant_token"
            }
          },
          "why": {
            "en": "Read the configured homeassistant_token secret required by this gateway."
          }
        }
      ]
    }
  }
}
