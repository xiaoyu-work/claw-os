{
  "id": "db",
  "version": "0.1.0",
  "name": {
    "en": "Database"
  },
  "summary": {
    "en": "SQLite database — create, query, and manage databases"
  },
  "icon": "🗄️",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "db.query",
        "summary": {
          "en": "Run a SELECT query on a database"
        },
        "args": [
          {
            "name": "database",
            "kind": "name",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "sql",
            "kind": "text",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "data.db.read",
            "scope": {
              "kind": "from-arg",
              "arg": "database"
            },
            "why": {
              "en": "Read rows from the database you asked to query."
            }
          }
        ]
      },
      {
        "name": "db.exec",
        "summary": {
          "en": "Execute one SQL statement (CREATE, INSERT, UPDATE, DELETE)"
        },
        "args": [
          {
            "name": "database",
            "kind": "name",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "sql",
            "kind": "text",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "data.db.write",
            "scope": {
              "kind": "from-arg",
              "arg": "database"
            },
            "why": {
              "en": "Modify the database you asked to execute SQL on."
            }
          }
        ]
      },
      {
        "name": "db.tables",
        "summary": {
          "en": "List tables in a database"
        },
        "args": [
          {
            "name": "database",
            "kind": "name",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "data.db.read",
            "scope": {
              "kind": "from-arg",
              "arg": "database"
            },
            "why": {
              "en": "Read the schema of the database to list its tables."
            }
          }
        ]
      },
      {
        "name": "db.schema",
        "summary": {
          "en": "Show schema of a table"
        },
        "args": [
          {
            "name": "database",
            "kind": "name",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "table",
            "kind": "text",
            "required": true,
            "binding": "positional"
          }
        ],
        "needs": [
          {
            "verb": "data.db.read",
            "scope": {
              "kind": "from-arg",
              "arg": "database"
            },
            "why": {
              "en": "Read the schema of the named table from the database."
            }
          }
        ]
      },
      {
        "name": "db.databases",
        "summary": {
          "en": "List available databases"
        },
        "needs": [
          {
            "verb": "data.db.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Enumerate every database stored on this machine."
            }
          }
        ]
      }
    ]
  }
}
