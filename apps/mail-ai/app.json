{
  "id": "mail-ai",
  "version": "0.2.0",
  "name": {
    "en": "Mail AI",
    "zh_CN": "邮件 AI"
  },
  "summary": {
    "en": "AI helpers (summarize, smart-reply, smart-compose, translate, triage, chat) for the Thunderbird MailExtension `claw-mail-ai`.",
    "zh_CN": "为 Thunderbird claw-mail-ai 扩展提供的 AI 助手(摘要、智能回复、智能撰写、翻译、分类、邮箱对话)。"
  },
  "icon": "🦅",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 500000
    },
    "safety": "strict",
    "origins": [
      "external-content"
    ]
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "mail-ai.summarize",
        "summary": {
          "en": "Summarize an email body into a one-line summary, key points, and action items"
        },
        "args": [
          {
            "name": "subject",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "sender",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "body",
            "kind": "text",
            "required": true,
            "binding": "flag"
          },
          {
            "name": "lang",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "en"
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the email body to a model and get back a structured summary."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "mail-ai"
              }
            },
            "why": {
              "en": "Remember the email summary so the agent can recall it later."
            }
          }
        ]
      },
      {
        "name": "mail-ai.smart_reply",
        "summary": {
          "en": "Generate three reply suggestions (formal / casual / short) for an email thread"
        },
        "args": [
          {
            "name": "subject",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "sender",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "thread",
            "kind": "text",
            "required": true,
            "binding": "flag"
          },
          {
            "name": "intent",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "lang",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "en"
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the thread context to a model and get back three reply drafts."
            }
          }
        ]
      },
      {
        "name": "mail-ai.smart_compose",
        "summary": {
          "en": "Continue or complete a draft from a brief intent (e.g. 'decline politely')"
        },
        "args": [
          {
            "name": "subject",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "recipient",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "draft",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "intent",
            "kind": "text",
            "required": true,
            "binding": "flag"
          },
          {
            "name": "style",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "formal",
            "choices": [
              "formal",
              "casual",
              "short"
            ]
          },
          {
            "name": "lang",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "en"
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the intent and current draft to a model and get back a completion."
            }
          }
        ]
      },
      {
        "name": "mail-ai.translate",
        "summary": {
          "en": "Translate email text into a target language"
        },
        "args": [
          {
            "name": "text",
            "kind": "text",
            "required": true,
            "binding": "flag"
          },
          {
            "name": "target",
            "kind": "text",
            "required": true,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the source text and target language to a model for translation."
            }
          }
        ]
      },
      {
        "name": "mail-ai.triage",
        "summary": {
          "en": "Classify an incoming email into a category and propose tags"
        },
        "args": [
          {
            "name": "subject",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "sender",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "snippet",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": ""
          },
          {
            "name": "has_attachments",
            "kind": "bool",
            "required": false,
            "binding": "flag",
            "default": false
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the sender / subject / snippet to a model and get back a category + tags."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "mail-ai"
              }
            },
            "why": {
              "en": "Remember high-priority triage decisions so the agent can recall what mattered."
            }
          }
        ]
      },
      {
        "name": "mail-ai.chat",
        "summary": {
          "en": "Answer a question grounded in supplied email context"
        },
        "args": [
          {
            "name": "question",
            "kind": "text",
            "required": true,
            "binding": "flag"
          },
          {
            "name": "context_json",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "[]"
          },
          {
            "name": "lang",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "default": "en"
          }
        ],
        "needs": [
          {
            "verb": "ai.chat.untrusted",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send the question and surrounding messages to a model for a grounded answer."
            }
          }
        ]
      }
    ]
  }
}
