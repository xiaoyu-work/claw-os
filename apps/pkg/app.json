{
  "id": "pkg",
  "version": "0.1.0",
  "name": {
    "en": "Packages"
  },
  "summary": {
    "en": "Declarative capability management — say what you need, not how to install it"
  },
  "icon": "📦",
  "runtime": "python",
  "operations": {
    "need": {
      "label": { "en": "Ensure packages are installed" },
      "summary": { "en": "Install packages that aren't already present." },
      "needs": [
        {
          "verb": "sys.package",
          "scope": { "kind": "wild" },
          "why": { "en": "Install or upgrade system packages on this machine." }
        }
      ]
    },
    "has": {
      "label": { "en": "Check if a capability is available" },
      "args": [
        { "name": "name", "kind": "name", "required": true }
      ],
      "needs": [
        {
          "verb": "sys.package",
          "scope": { "kind": "from-arg", "arg": "name" },
          "why": { "en": "Look up whether the named package or command is installed." }
        }
      ]
    },
    "list": {
      "label": { "en": "List installed packages" },
      "needs": [
        {
          "verb": "sys.package",
          "scope": { "kind": "wild" },
          "why": { "en": "Enumerate every system package currently installed." }
        }
      ]
    }
  }
}
