{
  "id": "search",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Web Search"
  },
  "summary": {
    "en": "Web and image search through an explicitly selected Google or Brave provider"
  },
  "icon": "🔎",
  "runtime": "python",
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "search.web",
        "summary": {
          "en": "Search the web for information through the explicitly selected provider. Returns titles, URLs, and snippets."
        },
        "args": [
          {
            "name": "provider",
            "kind": "name",
            "required": true,
            "binding": "flag",
            "choices": [
              "google",
              "brave"
            ]
          },
          {
            "name": "query",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "max_results",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 5
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "host",
                  "value": "www.googleapis.com"
                },
                "brave": {
                  "kind": "host",
                  "value": "api.search.brave.com"
                }
              }
            },
            "why": {
              "en": "Call only the selected search provider's API."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "search"
              }
            },
            "why": {
              "en": "Remember the search so the agent can recall what was looked up."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "name",
                  "value": "default/GOOGLE_SEARCH_API_KEY"
                },
                "brave": {
                  "kind": "name",
                  "value": "default/BRAVE_SEARCH_API_KEY"
                }
              }
            },
            "why": {
              "en": "Load only the selected search provider's API key."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "name",
                  "value": "default/GOOGLE_SEARCH_ENGINE_ID"
                }
              }
            },
            "why": {
              "en": "Load the Google Custom Search engine id when Google is selected."
            },
            "when": {
              "kind": "arg-equals",
              "arg": "provider",
              "value": "google"
            }
          }
        ]
      },
      {
        "name": "search.image",
        "summary": {
          "en": "Search for images through the explicitly selected provider. Returns titles, URLs, thumbnails, and dimensions."
        },
        "args": [
          {
            "name": "provider",
            "kind": "name",
            "required": true,
            "binding": "flag",
            "choices": [
              "google",
              "brave"
            ]
          },
          {
            "name": "query",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "max_results",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 5
          }
        ],
        "needs": [
          {
            "verb": "net.dial",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "host",
                  "value": "www.googleapis.com"
                },
                "brave": {
                  "kind": "host",
                  "value": "api.search.brave.com"
                }
              }
            },
            "why": {
              "en": "Call only the selected image search provider's API."
            }
          },
          {
            "verb": "memory.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "self-ref",
                "value": "search"
              }
            },
            "why": {
              "en": "Remember the image search so the agent can recall what was looked up."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "name",
                  "value": "default/GOOGLE_SEARCH_API_KEY"
                },
                "brave": {
                  "kind": "name",
                  "value": "default/BRAVE_SEARCH_API_KEY"
                }
              }
            },
            "why": {
              "en": "Load only the selected image search provider's API key."
            }
          },
          {
            "verb": "secret.read",
            "scope": {
              "kind": "from-arg-map",
              "arg": "provider",
              "values": {
                "google": {
                  "kind": "name",
                  "value": "default/GOOGLE_SEARCH_ENGINE_ID"
                }
              }
            },
            "why": {
              "en": "Load the Google Custom Search engine id when Google is selected."
            },
            "when": {
              "kind": "arg-equals",
              "arg": "provider",
              "value": "google"
            }
          }
        ]
      }
    ]
  }
}
