{
  "id": "clipboard-manager",
  "version": "0.1.0",
  "name": {
    "en": "Clipboard Manager"
  },
  "summary": {
    "en": "Read, inspect, write, or clear Wayland clipboard selections"
  },
  "icon": "📋",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "clipboard-manager.status",
        "summary": {
          "en": "Inspect clipboard provider and types"
        },
        "args": [
          {
            "name": "primary",
            "kind": "bool",
            "required": false,
            "default": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "clipboard.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "selection"
              }
            },
            "why": {
              "en": "Inspect offered clipboard MIME types and provider capabilities."
            }
          }
        ]
      },
      {
        "name": "clipboard-manager.types",
        "summary": {
          "en": "List clipboard MIME types"
        },
        "args": [
          {
            "name": "primary",
            "kind": "bool",
            "required": false,
            "default": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "clipboard.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "selection"
              }
            },
            "why": {
              "en": "Read the MIME types currently offered by the selection owner."
            }
          }
        ]
      },
      {
        "name": "clipboard-manager.read",
        "summary": {
          "en": "Read clipboard content"
        },
        "args": [
          {
            "name": "mime",
            "kind": "name",
            "required": false
          },
          {
            "name": "primary",
            "kind": "bool",
            "required": false,
            "default": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "clipboard.read",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "selection"
              }
            },
            "why": {
              "en": "Read potentially sensitive clipboard bytes."
            }
          }
        ]
      },
      {
        "name": "clipboard-manager.write",
        "summary": {
          "en": "Write clipboard content from a file"
        },
        "args": [
          {
            "name": "source",
            "kind": "path",
            "required": true
          },
          {
            "name": "mime",
            "kind": "name",
            "required": false
          },
          {
            "name": "primary",
            "kind": "bool",
            "required": false,
            "default": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "clipboard.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "selection"
              }
            },
            "why": {
              "en": "Replace the current Wayland clipboard selection."
            }
          },
          {
            "verb": "fs.read",
            "scope": {
              "kind": "from-arg",
              "arg": "source"
            },
            "why": {
              "en": "Read the exact source file through a pinned descriptor."
            }
          }
        ]
      },
      {
        "name": "clipboard-manager.clear",
        "summary": {
          "en": "Clear the clipboard"
        },
        "args": [
          {
            "name": "confirm",
            "kind": "bool",
            "required": true,
            "choices": [
              true
            ],
            "binding": "flag"
          },
          {
            "name": "primary",
            "kind": "bool",
            "required": false,
            "default": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "clipboard.write",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "selection"
              }
            },
            "why": {
              "en": "Clear the current clipboard selection."
            }
          }
        ]
      }
    ]
  }
}
