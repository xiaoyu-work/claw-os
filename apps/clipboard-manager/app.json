{
  "id": "clipboard-manager",
  "version": "0.1.0",
  "name": {"en": "Clipboard Manager"},
  "summary": {"en": "Read, inspect, write, or clear Wayland clipboard selections"},
  "icon": "📋",
  "runtime": "python",
  "operations": {
    "status": {"label": {"en": "Inspect clipboard provider and types"}, "needs": [{"verb": "clipboard.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "selection"}}, "why": {"en": "Inspect offered clipboard MIME types and provider capabilities."}}]},
    "types": {"label": {"en": "List clipboard MIME types"}, "needs": [{"verb": "clipboard.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "selection"}}, "why": {"en": "Read the MIME types currently offered by the selection owner."}}]},
    "read": {"label": {"en": "Read clipboard content"}, "args": [{"name": "mime", "kind": "name", "required": false}], "needs": [{"verb": "clipboard.read", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "selection"}}, "why": {"en": "Read potentially sensitive clipboard bytes."}}]},
    "write": {"label": {"en": "Write clipboard content from a file"}, "args": [{"name": "source", "kind": "path", "required": true}, {"name": "mime", "kind": "name", "required": false}], "needs": [{"verb": "clipboard.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "selection"}}, "why": {"en": "Replace the current Wayland clipboard selection."}}, {"verb": "fs.read", "scope": {"kind": "from-arg", "arg": "source"}, "why": {"en": "Read the exact source file through a pinned descriptor."}}]},
    "clear": {"label": {"en": "Clear the clipboard"}, "args": [{"name": "--confirm", "kind": "bool", "required": true}], "needs": [{"verb": "clipboard.write", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "selection"}}, "why": {"en": "Clear the current clipboard selection."}}]}
  }
}
