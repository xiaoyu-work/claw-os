{
  "id": "security-center",
  "version": "0.1.0",
  "name": {
    "en": "Security Center"
  },
  "summary": {
    "en": "Analyze authentication, sudo, SSH, MAC policy, listening ports, and security events"
  },
  "icon": "🛡",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "security-center.summary",
        "summary": {
          "en": "Inspect all security evidence"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read sensitive system-wide security configuration and events."
            }
          }
        ]
      },
      {
        "name": "security-center.auth",
        "summary": {
          "en": "Inspect authentication events"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read login, SSH, PAM, root-session, and sudo authentication events."
            }
          }
        ]
      },
      {
        "name": "security-center.ssh",
        "summary": {
          "en": "Inspect effective SSH security"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read effective sshd configuration and service state."
            }
          }
        ]
      },
      {
        "name": "security-center.sudo",
        "summary": {
          "en": "Inspect sudo policy"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read and validate sudoers rules and permissions."
            }
          }
        ]
      },
      {
        "name": "security-center.mac",
        "summary": {
          "en": "Inspect AppArmor, SELinux, Secure Boot, and lockdown"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read mandatory-access-control and kernel trust state."
            }
          }
        ]
      },
      {
        "name": "security-center.ports",
        "summary": {
          "en": "Inspect listening ports and processes"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read process ownership for listening TCP and UDP sockets."
            }
          }
        ]
      },
      {
        "name": "security-center.events",
        "summary": {
          "en": "Inspect kernel security events"
        },
        "needs": [
          {
            "verb": "sys.security",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "audit"
              }
            },
            "why": {
              "en": "Read AppArmor/SELinux denials, audit, lockdown, module-signature, and network-security events."
            }
          }
        ]
      }
    ]
  }
}
