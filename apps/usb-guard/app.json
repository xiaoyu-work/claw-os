{
  "id": "usb-guard",
  "version": "0.1.0",
  "name": {
    "en": "USB Guard"
  },
  "summary": {
    "en": "Inventory, authorize, persistently block, unblock, and safely eject USB devices"
  },
  "icon": "🔌",
  "runtime": "python",
  "operations": {
    "status": {
      "label": {
        "en": "Inspect USB devices and block policy"
      },
      "needs": [
        {
          "verb": "sys.observe",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "usb"
            }
          },
          "why": {
            "en": "Read USB identity, authorization, block devices, and managed rules."
          }
        }
      ],
      "args": []
    },
    "authorize": {
      "label": {
        "en": "Authorize or deauthorize a current USB device"
      },
      "args": [
        {
          "name": "device",
          "kind": "name",
          "required": true
        },
        {
          "name": "state",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": false,
          "binding": "flag",
          "default": false
        }
      ],
      "needs": [
        {
          "verb": "device.usb",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Change this currently connected USB device's authorization state."
          }
        }
      ]
    },
    "block": {
      "label": {
        "en": "Persistently block a USB device"
      },
      "args": [
        {
          "name": "device",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "device.usb",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Create a vendor/product/serial udev block rule and deauthorize the device."
          }
        }
      ]
    },
    "unblock": {
      "label": {
        "en": "Remove a persistent USB block rule"
      },
      "args": [
        {
          "name": "rule_id",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "device.usb",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Remove one exact managed block rule and reauthorize a unique connected match."
          }
        }
      ]
    },
    "eject": {
      "label": {
        "en": "Safely eject USB storage"
      },
      "args": [
        {
          "name": "device",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "device.usb",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Power off whole USB disks after protected-mount and swap checks."
          }
        }
      ]
    },
    "restore": {
      "label": {
        "en": "Restore USB block policy"
      },
      "args": [
        {
          "name": "backup_token",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "device.usb",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Restore the previous persistent block policy if no newer revision exists."
          }
        }
      ]
    }
  }
}
