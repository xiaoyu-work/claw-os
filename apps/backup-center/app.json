{
  "id": "backup-center",
  "version": "0.1.0",
  "name": {
    "en": "Backup Center"
  },
  "summary": {
    "en": "Create, retain, inspect, forget, and restore local Restic user-data backups"
  },
  "icon": "🗄",
  "runtime": "python",
  "operations": {
    "init": {
      "label": {
        "en": "Initialize a Restic repository"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Initialize this exact mounted repository path."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Use the repository password without exposing it in argv."
          }
        }
      ]
    },
    "snapshots": {
      "label": {
        "en": "List Restic snapshots"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Read snapshot metadata from this repository."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    },
    "check": {
      "label": {
        "en": "Check Restic repository integrity"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Read and verify repository indexes and packs."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    },
    "backup": {
      "label": {
        "en": "Back up a source tree"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "source",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        },
        {
          "name": "tag",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Write backup data to this mounted repository."
          }
        },
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "source"
          },
          "why": {
            "en": "Recursively read the backup tree rooted at this exact path."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    },
    "restore": {
      "label": {
        "en": "Restore a snapshot to an empty destination"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "snapshot",
          "kind": "name",
          "required": true
        },
        {
          "name": "destination",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag",
          "choices": [
            true
          ]
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Read data from this repository."
          }
        },
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "destination"
          },
          "why": {
            "en": "Write restored data below this exact empty destination."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    },
    "forget": {
      "label": {
        "en": "Forget one snapshot"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "snapshot",
          "kind": "name",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag",
          "choices": [
            true
          ]
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Delete this snapshot reference from the repository."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    },
    "retention": {
      "label": {
        "en": "Apply retention and prune"
      },
      "args": [
        {
          "name": "repo",
          "kind": "path",
          "required": true
        },
        {
          "name": "credential",
          "kind": "name",
          "required": true
        },
        {
          "name": "keep_daily",
          "kind": "integer",
          "required": true
        },
        {
          "name": "keep_weekly",
          "kind": "integer",
          "required": true
        },
        {
          "name": "keep_monthly",
          "kind": "integer",
          "required": true
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag",
          "choices": [
            true
          ]
        }
      ],
      "needs": [
        {
          "verb": "data.backup",
          "scope": {
            "kind": "from-arg",
            "arg": "repo"
          },
          "why": {
            "en": "Delete expired snapshots and unreferenced data according to retention."
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg",
            "arg": "credential"
          },
          "why": {
            "en": "Unlock the repository."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
