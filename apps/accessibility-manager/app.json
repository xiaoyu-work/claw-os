{
  "id": "accessibility-manager",
  "version": "0.1.0",
  "name": {
    "en": "Accessibility Manager"
  },
  "summary": {
    "en": "Control COSMIC magnifier, screen filters, inversion, and AT-SPI screen-reader state"
  },
  "icon": "♿",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "accessibility-manager.status",
        "summary": {
          "en": "Inspect accessibility state"
        },
        "needs": [
          {
            "verb": "sys.observe",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "accessibility"
              }
            },
            "why": {
              "en": "Read COSMIC accessibility protocol and AT-SPI status."
            }
          }
        ]
      },
      {
        "name": "accessibility-manager.screen-reader",
        "summary": {
          "en": "Enable or disable screen reader"
        },
        "args": [
          {
            "name": "state",
            "kind": "name",
            "required": true,
            "choices": [
              "on",
              "off"
            ]
          }
        ],
        "needs": [
          {
            "verb": "ui.accessibility",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Change AT-SPI IsEnabled and ScreenReaderEnabled together."
            }
          }
        ]
      },
      {
        "name": "accessibility-manager.magnifier",
        "summary": {
          "en": "Enable or disable magnifier"
        },
        "args": [
          {
            "name": "state",
            "kind": "name",
            "required": true,
            "choices": [
              "on",
              "off"
            ]
          }
        ],
        "needs": [
          {
            "verb": "ui.accessibility",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Change the COSMIC compositor magnifier state."
            }
          }
        ]
      },
      {
        "name": "accessibility-manager.invert",
        "summary": {
          "en": "Enable or disable color inversion"
        },
        "args": [
          {
            "name": "state",
            "kind": "name",
            "required": true,
            "choices": [
              "on",
              "off"
            ]
          }
        ],
        "needs": [
          {
            "verb": "ui.accessibility",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Change COSMIC screen inversion while preserving the selected filter."
            }
          }
        ]
      },
      {
        "name": "accessibility-manager.filter",
        "summary": {
          "en": "Set color-vision filter"
        },
        "args": [
          {
            "name": "filter",
            "kind": "name",
            "required": true,
            "choices": [
              "off",
              "greyscale",
              "protanopia",
              "deuteranopia",
              "tritanopia"
            ]
          }
        ],
        "needs": [
          {
            "verb": "ui.accessibility",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "control"
              }
            },
            "why": {
              "en": "Set or disable the COSMIC greyscale/daltonization filter."
            }
          }
        ]
      }
    ]
  }
}
