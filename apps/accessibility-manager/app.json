{
  "id": "accessibility-manager",
  "version": "0.1.0",
  "name": {"en": "Accessibility Manager"},
  "summary": {"en": "Control COSMIC magnifier, screen filters, inversion, and AT-SPI screen-reader state"},
  "icon": "♿",
  "runtime": "python",
  "operations": {
    "status": {"label": {"en": "Inspect accessibility state"}, "needs": [{"verb": "sys.observe", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "accessibility"}}, "why": {"en": "Read COSMIC accessibility protocol and AT-SPI status."}}]},
    "screen-reader": {"label": {"en": "Enable or disable screen reader"}, "args": [{"name": "state", "kind": "name", "required": true}], "needs": [{"verb": "ui.accessibility", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "control"}}, "why": {"en": "Change AT-SPI IsEnabled and ScreenReaderEnabled together."}}]},
    "magnifier": {"label": {"en": "Enable or disable magnifier"}, "args": [{"name": "state", "kind": "name", "required": true}], "needs": [{"verb": "ui.accessibility", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "control"}}, "why": {"en": "Change the COSMIC compositor magnifier state."}}]},
    "invert": {"label": {"en": "Enable or disable color inversion"}, "args": [{"name": "state", "kind": "name", "required": true}], "needs": [{"verb": "ui.accessibility", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "control"}}, "why": {"en": "Change COSMIC screen inversion while preserving the selected filter."}}]},
    "filter": {"label": {"en": "Set color-vision filter"}, "args": [{"name": "filter", "kind": "name", "required": true}], "needs": [{"verb": "ui.accessibility", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "control"}}, "why": {"en": "Set or disable the COSMIC greyscale/daltonization filter."}}]}
  }
}
