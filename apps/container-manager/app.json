{
  "id": "container-manager",
  "version": "0.1.0",
  "name": {
    "en": "Container Manager"
  },
  "summary": {
    "en": "Inspect and control Docker, rootless/root Podman, and containerd workloads"
  },
  "icon": "📦",
  "runtime": "python",
  "operations": {
    "status": {
      "label": {
        "en": "Inspect all container runtimes"
      },
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read system and user container inventories."
          }
        }
      ]
    },
    "list": {
      "label": {
        "en": "List containers"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read container names, images, state, ports, and identifiers."
          }
        }
      ]
    },
    "inspect": {
      "label": {
        "en": "Inspect a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read full container configuration and runtime state."
          }
        }
      ]
    },
    "logs": {
      "label": {
        "en": "Read container logs"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "lines",
          "kind": "integer",
          "required": false,
          "default": 100,
          "binding": "positional"
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read potentially sensitive stdout/stderr retained for this container."
          }
        }
      ]
    },
    "processes": {
      "label": {
        "en": "List processes in a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read process state inside the selected container."
          }
        }
      ]
    },
    "stats": {
