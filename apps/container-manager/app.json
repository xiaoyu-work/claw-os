{
  "id": "container-manager",
  "version": "0.1.0",
  "name": {
    "en": "Container Manager"
  },
  "summary": {
    "en": "Inspect and control Docker, rootless/root Podman, and containerd workloads"
  },
  "icon": "📦",
  "runtime": "python",
  "operations": {
    "status": {
      "label": {
        "en": "Inspect all container runtimes"
      },
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read system and user container inventories."
          }
        }
      ]
    },
    "list": {
      "label": {
        "en": "List containers"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read container names, images, state, ports, and identifiers."
          }
        }
      ]
    },
    "inspect": {
      "label": {
        "en": "Inspect a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read full container configuration and runtime state."
          }
        }
      ]
    },
    "logs": {
      "label": {
        "en": "Read container logs"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        },
        {
          "name": "lines",
          "kind": "integer",
          "required": false,
          "default": 100
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read potentially sensitive stdout/stderr retained for this container."
          }
        }
      ]
    },
    "processes": {
      "label": {
        "en": "List processes in a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read process state inside the selected container."
          }
        }
      ]
    },
    "stats": {
      "label": {
        "en": "Read container resource statistics"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read CPU, memory, network, and block-I/O usage."
          }
        }
      ]
    },
    "namespaces": {
      "label": {
        "en": "Inspect container namespaces and cgroups"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read namespace inode identities, capabilities, seccomp, and cgroup membership."
          }
        }
      ]
    },
    "start": {
      "label": {
        "en": "Start a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Start the selected container."
          }
        }
      ]
    },
    "stop": {
      "label": {
        "en": "Stop a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Stop the selected container."
          }
        }
      ]
    },
    "restart": {
      "label": {
        "en": "Restart a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Restart the selected container."
          }
        }
      ]
    },
    "pause": {
      "label": {
        "en": "Pause a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Freeze the selected container workload."
          }
        }
      ]
    },
    "unpause": {
      "label": {
        "en": "Unpause a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Resume the selected paused container."
          }
        }
      ]
    },
    "kill": {
      "label": {
        "en": "Signal a container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "signal",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Send a bounded signal to the selected container."
          }
        }
      ]
    },
    "remove": {
      "label": {
        "en": "Remove a stopped container"
      },
      "args": [
        {
          "name": "runtime",
          "kind": "name",
          "required": true
        },
        {
          "name": "target",
          "kind": "name",
          "required": true
        },
        {
          "name": "namespace",
          "kind": "name",
          "required": false
        },
        {
          "name": "confirm",
          "kind": "bool",
          "required": true,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "control"
            }
          },
          "why": {
            "en": "Permanently remove container metadata without deleting volumes."
          }
        }
      ]
    }
  }
}
