      "needs": [
        {
          "verb": "sys.container",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "name",
              "value": "observe"
            }
          },
          "why": {
            "en": "Read CPU, memory, network, and block-I/O usage."
          }
        }
      ]
    },
    "namespaces": {
