{
  "id": "cosmic-player",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Media Player"
  },
  "summary": {
    "en": "Control whichever MPRIS2-compatible media player is on the session bus."
  },
  "icon": "🎵",
  "runtime": "binary",
  "mcp": {
    "entry": "/usr/bin/cosmic-player",
    "transport": "stdio",
    "lifecycle": "lazy",
    "tools": [
      {
        "name": "player.play",
        "summary": {
          "en": "Resume playback on the active MPRIS player."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.pause",
        "summary": {
          "en": "Pause the active MPRIS player."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.stop",
        "summary": {
          "en": "Stop playback on the active MPRIS player."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.next",
        "summary": {
          "en": "Skip to the next track."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.previous",
        "summary": {
          "en": "Skip to the previous track."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.toggle",
        "summary": {
          "en": "Toggle play and pause on the active MPRIS player."
        },
        "args": [],
        "needs": []
      },
      {
        "name": "player.status",
        "summary": {
          "en": "Return playback status and selected track metadata from the active MPRIS player."
        },
        "args": [],
        "needs": []
      }
    ]
  }
}
