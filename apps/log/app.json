{
  "id": "log",
  "version": "0.1.0",
  "name": {
    "en": "Activity Log"
  },
  "summary": {
    "en": "System audit log — every command is recorded automatically"
  },
  "icon": "📜",
  "runtime": "python",
  "operations": {
    "read": {
      "label": {
        "en": "Read recent log entries (filter by --app, --status)"
      },
      "needs": [
        {
          "verb": "data.log.read",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Read entries from the system audit log."
          }
        }
      ],
      "args": [
        {
          "name": "limit",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 20
        },
        {
          "name": "app",
          "kind": "text",
          "required": false,
          "binding": "flag"
        },
        {
          "name": "status",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ]
    },
    "tail": {
      "label": {
        "en": "Show last N log entries"
      },
      "needs": [
        {
          "verb": "data.log.read",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Read the most recent entries from the system audit log."
          }
        }
      ],
      "args": [
        {
          "name": "n",
          "kind": "integer",
          "required": false,
          "default": 10
        }
      ]
    },
    "search": {
      "label": {
        "en": "Search logs by keyword (filter by --app)"
      },
      "needs": [
        {
          "verb": "data.log.read",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Scan the system audit log for entries matching your query."
          }
        }
      ],
      "args": [
        {
          "name": "query",
          "kind": "text",
          "required": true,
          "repeatable": true
        },
        {
          "name": "limit",
          "kind": "integer",
          "required": false,
          "binding": "flag",
          "default": 20
        },
        {
          "name": "app",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ]
    },
    "write": {
      "label": {
        "en": "Write a manual log entry"
      },
      "needs": [
        {
          "verb": "data.log.write",
          "scope": {
            "kind": "wild"
          },
          "why": {
            "en": "Append a manual entry to the system audit log."
          }
        }
      ],
      "args": [
        {
          "name": "message",
          "kind": "text",
          "required": true,
          "repeatable": true
        },
        {
          "name": "level",
          "kind": "text",
          "required": false,
          "binding": "flag",
          "default": "info"
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
    "tools": [
      {
        "name": "log.read",
        "summary": {
          "en": "Read recent log entries (filter by --app, --status)"
        },
        "args": [
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "default": 20
          },
          {
            "name": "app",
            "kind": "text",
            "required": false
          },
          {
            "name": "status",
            "kind": "text",
            "required": false
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Read entries from the system audit log."
            }
          }
        ]
      },
      {
        "name": "log.tail",
        "summary": {
          "en": "Show last N log entries"
        },
        "args": [
          {
            "name": "n",
            "kind": "integer",
            "required": false,
            "default": 10
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Read the most recent entries from the system audit log."
            }
          }
        ]
      },
      {
        "name": "log.search",
        "summary": {
          "en": "Search logs by keyword (filter by --app)"
        },
        "args": [
          {
            "name": "query",
            "kind": "text",
            "required": true,
            "repeatable": true
          },
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "default": 20
          },
          {
            "name": "app",
            "kind": "text",
            "required": false
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Scan the system audit log for entries matching your query."
            }
          }
        ]
      },
      {
        "name": "log.write",
        "summary": {
          "en": "Write a manual log entry"
        },
        "args": [
          {
            "name": "message",
            "kind": "text",
            "required": true,
            "repeatable": true
          },
          {
            "name": "level",
            "kind": "text",
            "required": false,
            "default": "info"
          }
        ],
        "needs": [
          {
            "verb": "data.log.write",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Append a manual entry to the system audit log."
            }
          }
        ]
      }
    ]
  }
}
