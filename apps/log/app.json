{
  "id": "log",
  "version": "0.1.0",
  "name": {
    "en": "Activity Log"
  },
  "summary": {
    "en": "System audit log — every command is recorded automatically"
  },
  "icon": "📜",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "log.read",
        "summary": {
          "en": "Read recent log entries (filter by --app, --status)"
        },
        "args": [
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 20
          },
          {
            "name": "app",
            "kind": "text",
            "required": false,
            "binding": "flag"
          },
          {
            "name": "status",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "choices": [
              "ok",
              "error"
            ]
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Read entries from the system audit log."
            }
          }
        ]
      },
      {
        "name": "log.tail",
        "summary": {
          "en": "Show last N log entries"
        },
        "args": [
          {
            "name": "n",
            "kind": "integer",
            "required": false,
            "binding": "positional",
            "default": 10
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Read the most recent entries from the system audit log."
            }
          }
        ]
      },
      {
        "name": "log.search",
        "summary": {
          "en": "Search logs by keyword (filter by --app)"
        },
        "args": [
          {
            "name": "query",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "limit",
            "kind": "integer",
            "required": false,
            "binding": "flag",
            "default": 20
          },
          {
            "name": "app",
            "kind": "text",
            "required": false,
            "binding": "flag"
          }
        ],
        "needs": [
          {
            "verb": "data.log.read",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Scan the system audit log for entries matching your query."
            }
          }
        ]
      },
      {
        "name": "log.write",
        "summary": {
          "en": "Write a manual log entry"
        },
        "args": [
          {
            "name": "message",
            "kind": "text",
            "required": true,
            "binding": "positional"
          },
          {
            "name": "level",
            "kind": "text",
            "required": false,
            "binding": "flag",
            "choices": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "default": "info"
          }
        ],
        "needs": [
          {
            "verb": "data.log.write",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Append a manual entry to the system audit log."
            }
          }
        ]
      }
    ]
  }
}
