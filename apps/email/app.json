{
  "id": "email",
  "version": "0.1.0",
  "name": {
    "en": "Email"
  },
  "summary": {
    "en": "Email — send, search, and manage email via SMTP or Gmail/Outlook providers"
  },
  "icon": "✉️",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 100000
    },
    "safety": "standard",
    "origins": [
      "trusted"
    ]
  },
  "operations": {
    "send": {
      "label": {
        "en": "Send an email (--to, --subject, --body, --provider smtp|gmail|outlook)"
      },
      "args": [
        {
          "name": "provider",
          "kind": "name",
          "required": true,
          "binding": "flag",
          "choices": [
            "smtp",
            "gmail",
            "outlook"
          ]
        },
        {
          "name": "host",
          "kind": "host",
          "required": false,
          "binding": "flag",
          "required_when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "smtp"
          }
        },
        {
          "name": "to",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "subject",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "body",
          "kind": "text",
          "required": true,
          "binding": "flag"
        },
        {
          "name": "cc",
          "kind": "text",
          "required": false,
          "binding": "flag"
        }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": {
            "kind": "from-arg",
            "arg": "host"
          },
          "why": {
            "en": "Open a network connection to the SMTP server or provider API to deliver the message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "smtp"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "gmail.googleapis.com"
            }
          },
          "why": {
            "en": "Open a network connection to the SMTP server or provider API to deliver the message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "gmail"
          }
        },
        {
          "verb": "net.dial",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "host",
              "value": "graph.microsoft.com"
            }
          },
          "why": {
            "en": "Open a network connection to the SMTP server or provider API to deliver the message."
          },
          "when": {
            "kind": "arg-equals",
            "arg": "provider",
            "value": "outlook"
          }
        },
        {
          "verb": "secret.read",
          "scope": {
            "kind": "from-arg-map",
            "arg": "provider",
            "values": {
              "smtp": {
                "kind": "name",
                "value": "default/SMTP_PASSWORD"
              },
              "gmail": {
                "kind": "name",
                "value": "default/GOOGLE_ACCESS_TOKEN"
              },
              "outlook": {
                "kind": "name",
                "value": "default/MICROSOFT_ACCESS_TOKEN"
              }
            }
          },
          "why": {
            "en": "Read only the credential for the provider selected before dispatch."
          }
        },
        {
          "verb": "memory.write",
          "scope": {
            "kind": "fixed",
            "scope": {
              "kind": "self-ref",
              "value": "email"
            }
          },
          "why": {
            "en": "Remember the sent message so the agent can recall it later."
          }
        }
      ]
    },
