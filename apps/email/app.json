{
  "id": "email",
  "version": "0.1.0",
  "name": {
    "en": "Email"
  },
  "summary": {
    "en": "Email — send, search, and manage email via SMTP or Gmail/Outlook providers"
  },
  "icon": "✉️",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 100000
    },
    "models": ["claude-*", "gpt-4o*", "mock-model"],
    "safety": "standard",
    "origins": ["trusted"]
  },
  "operations": {
    "send": {
      "label": { "en": "Send an email (--to, --subject, --body, --provider smtp|gmail|outlook)" },
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Open a network connection to the SMTP server or provider API to deliver the message." }
        },
        {
          "verb": "secret.read",
          "scope": { "kind": "wild" },
          "why": { "en": "Read the provider credentials (SMTP password, OAuth token) needed to authenticate." }
        }
      ]
    },
    "search": {
      "label": { "en": "Search emails (--query, --max-results, --provider gmail|outlook)" },
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Call the provider's API to search your mailbox." }
        },
        {
          "verb": "secret.read",
          "scope": { "kind": "wild" },
          "why": { "en": "Read the provider OAuth token needed to authenticate." }
        }
      ]
    },
    "list": {
      "label": { "en": "List recent emails (--max-results, --unread, --provider gmail|outlook)" },
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Call the provider's API to list recent messages." }
        },
        {
          "verb": "secret.read",
          "scope": { "kind": "wild" },
          "why": { "en": "Read the provider OAuth token needed to authenticate." }
        }
      ]
    },
    "read": {
      "label": { "en": "Read a specific email by ID (--id, --provider gmail|outlook)" },
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Call the provider's API to fetch the message body." }
        },
        {
          "verb": "secret.read",
          "scope": { "kind": "wild" },
          "why": { "en": "Read the provider OAuth token needed to authenticate." }
        }
      ]
    },
    "draft": {
      "label": { "en": "Draft an email reply via the AI gate (--context, --style formal|casual|short). Does NOT send." },
      "needs": [
        {
          "verb": "ai.chat",
          "scope": {
            "kind": "fixed",
            "scope": { "kind": "name", "value": "claude-*" }
          },
          "why": { "en": "Send your context to a model so it can draft an email reply for you." }
        }
      ]
    }
  }
}
