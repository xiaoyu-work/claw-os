{
  "id": "crash-doctor",
  "version": "0.1.0",
  "name": {
    "en": "Crash Doctor"
  },
  "summary": {
    "en": "Correlate coredumps, OOM kills, segmentation faults, journals, and backtraces"
  },
  "icon": "💥",
  "runtime": "python",
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true
    },
    "tools": [
      {
        "name": "crash-doctor.recent",
        "summary": {
          "en": "List recent system coredumps"
        },
        "args": [
          {
            "name": "since_minutes",
            "kind": "integer",
            "binding": "positional",
            "required": false,
            "default": 60
          },
          {
            "name": "limit",
            "kind": "integer",
            "binding": "positional",
            "required": false,
            "default": 20
          }
        ],
        "needs": [
          {
            "verb": "sys.crash",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "system"
              }
            },
            "why": {
              "en": "Read sensitive system-wide coredump metadata."
            }
          }
        ]
      },
      {
        "name": "crash-doctor.diagnose",
        "summary": {
          "en": "Diagnose recent crashes"
        },
        "args": [
          {
            "name": "since_minutes",
            "kind": "integer",
            "binding": "positional",
            "required": false,
            "default": 60
          },
          {
            "name": "limit",
            "kind": "integer",
            "binding": "positional",
            "required": false,
            "default": 20
          }
        ],
        "needs": [
          {
            "verb": "sys.crash",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "system"
              }
            },
            "why": {
              "en": "Correlate system-wide coredumps with kernel and service journal events."
            }
          }
        ]
      },
      {
        "name": "crash-doctor.backtrace",
        "summary": {
          "en": "Inspect a coredump backtrace"
        },
        "args": [
          {
            "name": "id",
            "kind": "name",
            "binding": "positional",
            "required": true
          }
        ],
        "needs": [
          {
            "verb": "sys.crash",
            "scope": {
              "kind": "fixed",
              "scope": {
                "kind": "name",
                "value": "system"
              }
            },
            "why": {
              "en": "Extract and inspect a selected system coredump using a constrained debugger."
            }
          }
        ]
      }
    ]
  }
}
