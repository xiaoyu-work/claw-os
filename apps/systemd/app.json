{
  "id": "systemd",
  "version": "0.1.0",
  "name": {
    "en": "System Services"
  },
  "summary": {
    "en": "Inspect and control native systemd units through the privileged Claw OS broker"
  },
  "icon": "🛠",
  "runtime": "python",
  "operations": {
    "status": {
      "label": {
        "en": "Inspect a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.observe",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Read the unit's load, active, sub-state, and enablement state."
          }
        }
      ]
    },
    "start": {
      "label": {
        "en": "Start a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Start this native system service."
          }
        }
      ]
    },
    "stop": {
      "label": {
        "en": "Stop a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Stop this native system service."
          }
        }
      ]
    },
    "restart": {
      "label": {
        "en": "Restart a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Restart this native system service."
          }
        }
      ]
    },
    "reload": {
      "label": {
        "en": "Reload a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Ask this service to reload its configuration."
          }
        }
      ]
    },
    "enable": {
      "label": {
        "en": "Enable a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Enable this unit for future boots."
          }
        }
      ]
    },
    "disable": {
      "label": {
        "en": "Disable a systemd unit"
      },
      "args": [
        {
          "name": "unit",
          "kind": "name",
          "required": true
        }
      ],
      "needs": [
        {
          "verb": "sys.service",
          "scope": {
            "kind": "from-arg",
            "arg": "unit"
          },
          "why": {
            "en": "Disable this unit for future boots."
          }
        }
      ]
    }
  },
  "schema_version": 2,
  "mcp": {
    "entry": "server.py",
    "transport": "stdio",
    "lifecycle": "lazy",
    "access": {
      "system_agent": true,
      "apps": []
    },
