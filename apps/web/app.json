{
  "id": "web",
  "version": "0.2.0",
  "name": {
    "en": "Browser"
  },
  "summary": {
    "en": "Browser via cos-browser (vendored Obscura) — text/links/JSON output, JS rendering, optional CDP"
  },
  "icon": "🧭",
  "runtime": "python",
  "ai": {
    "budget": {
      "monthly_units": 200000
    },
    "safety": "strict",
    "origins": ["external-content"]
  },
  "operations": {
    "read": {
      "label": { "en": "Fetch URL, return {url, title, text, links} (or raw HTML / arbitrary --eval result)" },
      "args": [
        { "name": "url", "kind": "text", "required": true }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Open a network connection to the URL you asked to load." }
        }
      ]
    },
    "scrape": {
      "label": { "en": "Fetch many URLs in parallel" },
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Open network connections to each URL you asked to load." }
        }
      ]
    },
    "screenshot": {
      "label": { "en": "Capture a screenshot of a URL (shells out to chromium)" },
      "args": [
        { "name": "url",    "kind": "text", "required": true },
        { "name": "output", "kind": "path", "required": true }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Open a network connection to the URL you asked to capture." }
        },
        {
          "verb": "fs.write",
          "scope": { "kind": "from-arg", "arg": "output" },
          "why": { "en": "Save the screenshot to the path you specified." }
        }
      ]
    },
    "submit": {
      "label": { "en": "Submit form data (POST) via urllib" },
      "args": [
        { "name": "url", "kind": "text", "required": true }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "POST to the URL you asked to submit data to." }
        }
      ]
    },
    "summarize": {
      "label": { "en": "Fetch a URL and return a 3-line AI summary" },
      "args": [
        { "name": "url", "kind": "text", "required": true }
      ],
      "needs": [
        {
          "verb": "net.dial",
          "scope": { "kind": "wild" },
          "why": { "en": "Open a network connection to the URL so its text can be fetched." }
        },
        {
          "verb": "ai.chat.untrusted",
          "scope": {
            "kind": "fixed",
            "scope": { "kind": "name", "value": "claude-*" }
          },
          "why": { "en": "Send the fetched page text to a model so it can be summarised for you." }
        }
      ]
    }
  },
  "dependencies": {
    "binaries": [
      "cos-browser"
    ],
    "optional_binaries": [
      "chromium"
    ]
  }
}
