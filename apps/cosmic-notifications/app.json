{
  "id": "cosmic-notifications",
  "version": "0.1.0",
  "schema_version": 2,
  "name": {
    "en": "Notifications"
  },
  "summary": {
    "en": "Post and dismiss freedesktop notifications through the session D-Bus."
  },
  "icon": "🔔",
  "runtime": "binary",
  "mcp": {
    "entry": "/usr/bin/cosmic-notifications",
    "transport": "stdio",
    "lifecycle": "lazy",
    "tools": [
      {
        "name": "notify.post",
        "summary": {
          "en": "Show a freedesktop notification and return its assigned notification id."
        },
        "args": [
          {
            "name": "summary",
            "kind": "text",
            "required": true,
            "label": {
              "en": "Non-empty headline shown by the notification daemon."
            }
          },
          {
            "name": "body",
            "kind": "text",
            "required": false,
            "default": "",
            "label": {
              "en": "Optional body text shown below the summary."
            }
          },
          {
            "name": "app_name",
            "kind": "text",
            "required": false,
            "default": "Claw OS Agent",
            "label": {
              "en": "Sender name shown in the popup; empty or omitted uses Claw OS Agent."
            }
          },
          {
            "name": "icon",
            "kind": "text",
            "required": false,
            "default": "com.clawos.Notifications",
            "label": {
              "en": "Icon name or absolute path; omitted uses com.clawos.Notifications."
            }
          },
          {
            "name": "expire_ms",
            "kind": "integer",
            "required": false,
            "default": -1,
            "label": {
              "en": "Auto-dismiss timeout in milliseconds; -1 uses the daemon default and 0 never expires."
            }
          },
          {
            "name": "transient",
            "kind": "bool",
            "required": false,
            "default": false,
            "label": {
              "en": "Do not retain the popup in notification history."
            }
          }
        ],
        "needs": [
          {
            "verb": "ui.notify",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Send a desktop notification to the user."
            }
          }
        ]
      },
      {
        "name": "notify.close",
        "summary": {
          "en": "Dismiss a notification by the integer id returned from notify.post."
        },
        "args": [
          {
            "name": "id",
            "kind": "integer",
            "required": true,
            "label": {
              "en": "Notification id returned by notify.post."
            }
          }
        ],
        "needs": [
          {
            "verb": "ui.notify",
            "scope": {
              "kind": "wild"
            },
            "why": {
              "en": "Dismiss a desktop notification."
            }
          }
        ]
      }
    ]
  }
}
