{
  "id": "netdiag",
  "version": "0.1.0",
  "name": {"en": "Network Doctor"},
  "summary": {"en": "Diagnose local interfaces, routes, DNS, TCP reachability, and latency"},
  "icon": "🩺",
  "runtime": "python",
  "operations": {
    "interfaces": {
      "label": {"en": "Inspect network interfaces"},
      "needs": [{"verb": "sys.observe", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "network"}}, "why": {"en": "Read local interface state and counters."}}]
    },
    "routes": {
      "label": {"en": "Inspect network routes"},
      "needs": [{"verb": "sys.observe", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "network"}}, "why": {"en": "Read the kernel route table."}}]
    },
    "dns": {
      "label": {"en": "Resolve a network target"},
      "args": [{"name": "target", "kind": "host", "required": true}],
      "needs": [{"verb": "net.resolve", "scope": {"kind": "from-arg", "arg": "target"}, "why": {"en": "Resolve this exact host or host:port target."}}]
    },
    "tcp": {
      "label": {"en": "Test TCP reachability and latency"},
      "args": [
        {"name": "target", "kind": "host", "required": true},
        {"name": "--attempts", "kind": "number", "required": false},
        {"name": "--timeout", "kind": "number", "required": false}
      ],
      "needs": [
        {"verb": "net.resolve", "scope": {"kind": "from-arg", "arg": "target"}, "why": {"en": "Resolve this exact target once."}},
        {"verb": "net.dial", "scope": {"kind": "from-arg", "arg": "target"}, "why": {"en": "Open bounded TCP probes to the resolved addresses."}}
      ]
    },
    "diagnose": {
      "label": {"en": "Run staged network diagnosis"},
      "args": [{"name": "target", "kind": "host", "required": true}],
      "needs": [
        {"verb": "sys.observe", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "network"}}, "why": {"en": "Inspect interfaces and routes."}},
        {"verb": "net.resolve", "scope": {"kind": "from-arg", "arg": "target"}, "why": {"en": "Resolve this exact target once."}},
        {"verb": "net.dial", "scope": {"kind": "from-arg", "arg": "target"}, "why": {"en": "Test TCP reachability to the resolved target."}}
      ]
    }
  }
}
