{
  "id": "camera-manager",
  "version": "0.1.0",
  "name": {"en": "Camera Manager"},
  "summary": {"en": "Discover PipeWire cameras and capture bounded PNG/JPEG still images"},
  "icon": "📷",
  "runtime": "python",
  "operations": {
    "status": {"label": {"en": "List PipeWire camera nodes"}, "needs": [{"verb": "sys.observe", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "camera"}}, "why": {"en": "Read Video/Source nodes and portal/GStreamer availability."}}]},
    "capture": {"label": {"en": "Capture one still image"}, "args": [{"name": "node_id", "kind": "number", "required": true}, {"name": "expected_serial", "kind": "number", "required": true}, {"name": "destination", "kind": "path", "required": true}, {"name": "format", "kind": "name", "required": true}, {"name": "width", "kind": "number", "required": false, "default": 1280}, {"name": "height", "kind": "number", "required": false, "default": 720}], "needs": [{"verb": "device.camera", "scope": {"kind": "fixed", "scope": {"kind": "name", "value": "capture"}}, "why": {"en": "Activate the selected camera only if its PipeWire serial still matches."}}, {"verb": "fs.write", "scope": {"kind": "from-arg", "arg": "destination"}, "why": {"en": "Persist the image to this exact new path without overwriting."}}]}
  }
}
