{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-os.dev/wire/v1/ai.schema.json",
  "title": "AI request / reply",
  "description": "Shape returned by `cos ai chat`. The kernel derives the modality and capability verb from the request flags.",
  "type": "object",
  "required": ["text", "model", "provider", "verb", "usage", "budget", "review"],
  "additionalProperties": true,
  "properties": {
    "text": {
      "type": "string",
      "description": "Text result, or an empty string for vector/file-output modalities."
    },
    "model": {
      "type": "string",
      "description": "Provider model id actually used."
    },
    "provider": {
      "type": "string",
      "description": "Provider name actually used."
    },
    "verb": {
      "type": "string",
      "enum": [
        "ai.chat",
        "ai.chat.untrusted",
        "ai.embed",
        "ai.image.generate",
        "ai.image.analyze",
        "ai.vision.analyze",
        "ai.audio.tts",
        "ai.audio.stt",
        "ai.video.generate",
        "ai.video.analyze"
      ],
      "description": "Capability verb derived by the kernel for this call."
    },
    "embedding": {
      "type": "array",
      "items": {
        "type": "number",
        "x-rust-type": "f32",
        "x-go-type": "float32"
      },
      "description": "Embedding vector for ai.embed; omitted for other modalities."
    },
    "output_path": {
      "type": "string",
      "description": "Filesystem path containing a generated binary artifact."
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "units"],
      "additionalProperties": false,
      "description": "Token and unit accounting for this call.",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u32",
          "x-go-type": "uint32"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "x-rust-type": "u32",
          "x-go-type": "uint32"
        },
        "units": { "type": "integer", "minimum": 0 }
      }
    },
    "budget": {
      "type": "object",
      "required": ["period", "units_used", "units_cap"],
      "additionalProperties": false,
      "description": "App budget snapshot after the call.",
      "properties": {
        "period": { "type": "string" },
        "units_used": { "type": "integer", "minimum": 0 },
        "units_cap": { "type": "integer", "minimum": 0 }
      }
    },
    "review": {
      "type": "object",
      "required": ["safety", "prompt_redacted"],
      "additionalProperties": false,
      "description": "Safety policy actually applied by the kernel.",
      "properties": {
        "safety": {
          "type": "string",
          "enum": ["strict", "standard", "minimal"]
        },
        "prompt_redacted": { "type": "boolean" }
      }
    },
    "tool_calls": {
      "type": "array",
      "description": "Tool calls proposed by the model. The kernel does not execute them inline.",
      "items": { "$ref": "#/$defs/AiToolCall" }
    }
  },
  "$defs": {
    "AiToolCall": {
      "type": "object",
      "required": ["id", "name", "input"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "input": {}
      }
    }
  }
}
