{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-os.dev/wire/v1/budget_show.schema.json",
  "title": "AI budget show reply",
  "description": "Shape returned by `cos agent budget show <app>`.",
  "type": "object",
  "required": ["app", "period", "units_used"],
  "additionalProperties": false,
  "properties": {
    "app": { "type": "string" },
    "period": { "type": "string" },
    "units_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615,
      "x-rust-type": "u64",
      "x-go-type": "uint64",
      "x-ts-type": "number | bigint"
    }
  }
}
