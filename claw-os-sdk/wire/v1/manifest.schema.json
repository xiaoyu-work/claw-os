{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-os.dev/wire/v1/manifest.schema.json",
  "title": "App manifest (app.json)",
  "description": "The manifest every app under COS_APPS_DIR must provide. The kernel parses and validates this (core/src/caps/manifest.rs) to derive the app's operations, optional MCP session tools, optional desktop GUI surface, capability needs, and AI policy.",
  "type": "object",
  "required": ["id", "version", "name"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "Stable app identifier; must equal the directory name under COS_APPS_DIR." },
    "version": { "type": "string", "description": "Semantic version of the app." },
    "name": { "$ref": "#/$defs/localizedText", "description": "Human-friendly display name (localized; English required)." },
    "summary": { "$ref": "#/$defs/localizedText", "description": "One-line description (localized)." },
    "icon": { "type": "string", "description": "Emoji or icon name shown in launchers / the app store." },
    "runtime": { "type": "string", "enum": ["python", "node", "shell", "binary"], "description": "Which interpreter the bridge invokes for the entry point. Defaults to python." },
    "entry": { "type": "string", "description": "Entry file relative to the app dir. Defaults to the runtime's default (main.py / main.js / main.sh / main)." },
    "operations": {
      "type": "object",
      "description": "One-shot operations keyed by command name. Each is invokable as `cos app <id> <op>` and auto-exposed to the agent. Values conform to #/$defs/operation.",
      "additionalProperties": { "$ref": "#/$defs/operation" }
    },
    "ai": { "$ref": "#/$defs/aiPolicy", "description": "AI policy. Required iff any operation / session tool declares an ai.* need." },
    "session": { "$ref": "#/$defs/session", "description": "Optional long-lived MCP server exposing stateful, agent-driven tools." },
    "desktop": { "$ref": "#/$defs/desktop", "description": "Optional desktop GUI surface. Declaring it makes the app a launchable GUI; the installer generates a .desktop entry whose Exec routes through `cos app <id> --gui` so the GUI process is kernel-spawned and shares the app's identity, caps, consent, and audit." },
    "dependencies": { "type": "object", "additionalProperties": true, "description": "Free-form dependency declarations (e.g. {\"binaries\": [...]}) consumed by the bridge's resolver." }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "description": "Localized string map. The `en` key is required; other locales (zh-CN, ...) are optional fallbacks.",
      "required": ["en"],
      "additionalProperties": { "type": "string" },
      "properties": { "en": { "type": "string" } }
    },
    "operation": {
      "type": "object",
      "description": "A one-shot operation: its inputs and the capabilities it needs.",
      "required": ["label"],
      "additionalProperties": true,
      "properties": {
        "label": { "$ref": "#/$defs/localizedText" },
        "summary": { "$ref": "#/$defs/localizedText" },
        "stdin": { "type": "boolean", "description": "Forward piped caller input. Interactive stdin is always closed." },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/arg" },
          "description": "Declared input parameters; order is significant for the UI.",
          "not": {
            "allOf": [
              { "contains": { "$ref": "#/$defs/optionalPositionalGap" } },
              { "contains": { "$ref": "#/$defs/defaultedPositional" } }
            ]
          }
        },
        "needs": { "type": "array", "items": { "$ref": "#/$defs/need" }, "description": "Capability requirements checked before dispatch." }
      }
    },
    "arg": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": true,
      "allOf": [
        {
          "not": { "required": ["default", "default_from"] }
        },
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["default"] },
                { "required": ["default_from"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "kind": { "enum": ["path", "host", "name", "text"] } }, "required": ["kind"] },
          "then": { "properties": {
            "default": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
            "choices": { "items": { "type": "string" } }
          } }
        },
        {
          "if": { "properties": { "kind": { "const": "number" } }, "required": ["kind"] },
          "then": { "properties": {
            "default": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" } }] },
            "choices": { "items": { "type": "number" } }
          } }
        },
        {
          "if": { "properties": { "kind": { "const": "integer" } }, "required": ["kind"] },
          "then": { "properties": {
            "default": { "oneOf": [{ "type": "integer" }, { "type": "array", "items": { "type": "integer" } }] },
            "choices": { "items": { "type": "integer" } }
          } }
        },
        {
          "if": { "properties": { "kind": { "const": "bool" } }, "required": ["kind"] },
          "then": { "properties": {
            "default": { "type": "boolean" },
            "choices": { "items": { "type": "boolean" } }
          } }
        },
        {
          "if": { "properties": { "repeatable": { "const": true } }, "required": ["repeatable"] },
          "then": {
            "properties": {
              "default": { "type": "array" },
              "kind": { "not": { "const": "bool" } }
            },
            "not": { "anyOf": [{ "required": ["default_from"] }, { "required": ["trusted_resolver"] }] }
          },
          "else": { "properties": { "default": { "not": { "type": "array" } } } }
        },
        {
          "if": { "properties": { "positional_alias": { "const": true } }, "required": ["positional_alias"] },
          "then": {
            "properties": {
              "binding": { "const": "flag" },
              "required": { "const": false },
              "repeatable": { "const": false },
              "kind": { "not": { "const": "bool" } }
            },
            "required": ["binding"]
          }
        },
        {
          "if": { "required": ["trusted_resolver"] },
          "then": {
            "properties": {
              "binding": { "const": "flag" },
              "required": { "const": false }
            },
            "required": ["binding"],
            "not": {
              "anyOf": [
                { "required": ["default"] },
                { "required": ["default_from"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "trusted_resolver": { "const": "email-host" } }, "required": ["trusted_resolver"] },
          "then": { "properties": { "name": { "const": "host" }, "kind": { "const": "host" } } },
          "else": {
            "if": { "properties": { "trusted_resolver": { "const": "ntfy-server" } }, "required": ["trusted_resolver"] },
            "then": { "properties": { "name": { "const": "server" }, "kind": { "const": "text" } } },
            "else": {
              "if": { "required": ["trusted_resolver"] },
              "then": { "properties": { "name": { "const": "provider" }, "kind": { "const": "name" } } }
            }
          }
        }
      ],
      "properties": {
        "name": { "type": "string", "description": "Identifier referenced by from-arg scope bindings." },
        "kind": { "type": "string", "enum": ["path", "host", "name", "text", "number", "integer", "bool"], "description": "Value kind. path/host/name can populate a scope; text/number/integer/bool cannot." },
        "binding": { "type": "string", "enum": ["positional", "flag"], "description": "How one-shot CLI argv binds this value. Omitted booleans retain their historical flag form; every other omitted binding is positional." },
        "required": { "type": "boolean" },
        "repeatable": { "type": "boolean", "description": "Bind every occurrence in order and expose an array value. Repeatable positional args must be last; repeatable booleans are rejected." },
        "aliases": { "type": "array", "items": { "type": "string", "pattern": "^(-[A-Za-z0-9]|--[a-z][a-z0-9-]*)$" }, "uniqueItems": true, "description": "Additional short or long option spellings for the same effective argument." },
        "positional_alias": { "type": "boolean", "description": "Accept this optional flag argument as a surplus leading positional before the canonical positional grammar." },
        "choices": { "type": "array", "uniqueItems": true, "description": "Optional closed set of accepted scalar values." },
        "default": { "description": "Optional non-null default whose JSON type must match kind. Omit this property when there is no default." },
        "default_from": { "$ref": "#/$defs/argDefaultBinding", "description": "Derive an omitted string value from an earlier declared argument." },
        "trusted_resolver": { "type": "string", "enum": ["email-provider", "email-host", "calendar-provider", "ntfy-server"], "description": "Trusted pre-dispatch resolver, restricted by the kernel to its matching bundled app." },
        "label": { "$ref": "#/$defs/localizedText" }
      }
    },
    "positionalArg": {
      "anyOf": [
        {
          "properties": { "binding": { "const": "positional" } },
          "required": ["binding"]
        },
        {
          "properties": { "kind": { "not": { "const": "bool" } } },
          "not": { "required": ["binding"] }
        }
      ]
    },
    "optionalPositionalGap": {
      "allOf": [
        { "$ref": "#/$defs/positionalArg" },
        {
          "anyOf": [
            { "properties": { "required": { "const": false } }, "required": ["required"] },
            { "not": { "required": ["required"] } }
          ]
        },
        { "not": { "anyOf": [{ "required": ["default"] }, { "required": ["default_from"] }] } }
      ]
    },
    "defaultedPositional": {
      "allOf": [
        { "$ref": "#/$defs/positionalArg" },
        { "anyOf": [{ "required": ["default"] }, { "required": ["default_from"] }] }
      ]
    },
    "argDefaultBinding": {
      "type": "object",
      "required": ["arg"],
      "additionalProperties": false,
      "properties": {
        "arg": { "type": "string", "description": "Earlier declared string argument used as input." },
        "transform": { "type": "string", "enum": ["identity", "url-path-basename"], "default": "identity" },
        "prefix": { "type": "string", "default": "" },
        "fallback": { "type": "string", "description": "Safe fallback when the transform produces no value." }
      }
    },
    "need": {
      "type": "object",
      "description": "A single capability request: verb + scope binding + human reason.",
      "required": ["verb", "scope", "why"],
      "additionalProperties": true,
      "not": {
        "properties": { "verb": { "const": "ai.bypass" } },
        "required": ["verb"]
      },
      "properties": {
        "verb": {
          "type": "string",
          "description": "Capability verb. Must be a verb the kernel recognises (core/src/caps/verb.rs).",
          "enum": [
            "fs.read", "fs.write", "fs.delete", "fs.exec", "fs.watch", "fs.meta",
            "net.dial", "net.listen", "net.raw", "net.resolve", "net.manage", "net.firewall",
            "proc.spawn", "proc.signal", "proc.observe",
            "sys.observe", "sys.crash", "sys.container", "sys.config", "sys.events", "sys.identity", "sys.security", "sys.storage",
            "sys.service", "sys.package", "sys.mount", "sys.snapshot", "sys.time", "sys.power", "sys.kernel",
            "secret.read", "secret.write", "secret.grant",
            "agent.spawn", "agent.invoke", "agent.observe", "agent.delegate",
            "data.kv.read", "data.kv.write", "data.kv.delete", "data.db.read", "data.db.write", "data.log.read", "data.log.write", "data.inbox.read", "data.inbox.write", "data.backup",
            "memory.write", "memory.read",
            "ipc.publish", "ipc.subscribe", "ipc.invoke",
            "ui.notify", "ui.prompt", "ui.window", "ui.input", "ui.accessibility",
            "clipboard.read", "clipboard.write",
            "device.audio", "device.bluetooth", "device.media-route", "device.printer", "device.display", "device.camera", "device.microphone", "device.location", "device.sensor", "device.usb",
            "time.cron", "time.delay",
            "ai.chat", "ai.chat.untrusted", "ai.embed", "ai.image.generate", "ai.image.analyze", "ai.audio.tts", "ai.audio.stt", "ai.vision.analyze", "ai.video.generate", "ai.video.analyze", "ai.bypass",
            "desktop.launch", "desktop.window",
            "browser.tabs.read", "browser.nav", "browser.dom.read", "browser.dom.write", "browser.input.secret", "browser.eval"
          ]
        },
        "scope": { "$ref": "#/$defs/scopeBinding" },
        "when": { "$ref": "#/$defs/needCondition", "description": "Explicit condition under which this capability is required." },
        "why": { "$ref": "#/$defs/localizedText", "description": "Plain-language reason shown in the approval dialog." }
      }
    },
    "needCondition": {
      "type": "object",
      "required": ["kind", "arg"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "arg-present" } }, "required": ["kind"] },
          "then": { "not": { "required": ["value"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "arg-equals" } }, "required": ["kind"] },
          "then": { "required": ["value"] }
        }
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["arg-present", "arg-equals"] },
        "arg": { "type": "string" },
        "value": { "not": { "type": "null" } }
      }
    },
    "scopeBinding": {
      "type": "object",
      "description": "How an operation's scope is determined at invocation time. kind=from-arg reads a named arg at call time; kind=fixed hard-codes a scope; kind=wild is an explicit wildcard (no implicit '*').",
      "required": ["kind"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "from-arg" } }, "required": ["kind"] },
          "then": {
            "required": ["arg"],
            "not": { "anyOf": [{ "required": ["scope"] }, { "required": ["values"] }, { "required": ["wild_when"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "from-arg-map" } }, "required": ["kind"] },
          "then": {
            "required": ["arg", "values"],
            "not": { "anyOf": [{ "required": ["scope"] }, { "required": ["wild_when"] }, { "required": ["transform"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "from-arg-or-wild" } }, "required": ["kind"] },
          "then": {
            "required": ["arg", "wild_when"],
            "not": { "anyOf": [{ "required": ["scope"] }, { "required": ["values"] }, { "required": ["transform"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "fixed" } }, "required": ["kind"] },
          "then": {
            "required": ["scope"],
            "not": { "anyOf": [{ "required": ["arg"] }, { "required": ["values"] }, { "required": ["wild_when"] }, { "required": ["transform"] }] }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "wild" } }, "required": ["kind"] },
          "then": {
            "not": { "anyOf": [{ "required": ["arg"] }, { "required": ["scope"] }, { "required": ["values"] }, { "required": ["wild_when"] }, { "required": ["transform"] }] }
          }
        }
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["from-arg", "from-arg-map", "from-arg-or-wild", "fixed", "wild"] },
        "arg": { "type": "string", "description": "Arg name to bind from (kind=from-arg)." },
        "transform": { "type": "string", "enum": ["identity", "parent", "url-host"], "description": "Safe transformation applied after binding a scope source." },
        "values": { "type": "object", "additionalProperties": { "$ref": "#/$defs/scope" }, "description": "Explicit argument-value to scope mapping for kind=from-arg-map." },
        "wild_when": { "type": "string", "description": "Boolean argument that selects wildcard scope for kind=from-arg-or-wild." },
        "scope": { "$ref": "#/$defs/scope", "description": "Hard-coded scope (kind=fixed)." }
      }
    },
    "scope": {
      "type": "object",
      "description": "A concrete capability scope. value is a glob for path/host/name, the self-reference string for self-ref, and absent for wild.",
      "required": ["kind"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "path" } }, "required": ["kind"] },
          "then": {
            "required": ["value"],
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[^$]*$",
                "description": "Absolute or ~/ path glob; environment placeholders are not expanded."
              }
            }
          }
        }
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["path", "host", "name", "self-ref", "wild"] },
        "value": { "type": "string" }
      }
    },
    "aiPolicy": {
      "type": "object",
      "description": "Budget + safety envelope under which the app may exercise ai.* verbs. Apps never pick the model; the OS owns the provider.",
      "required": ["budget"],
      "additionalProperties": true,
      "properties": {
        "budget": { "$ref": "#/$defs/aiBudget" },
        "safety": { "type": "string", "enum": ["strict", "standard", "minimal"], "description": "Safety profile. Defaults to strict." },
        "origins": { "type": "array", "items": { "type": "string", "enum": ["trusted", "user-input", "external-content"] }, "description": "Prompt origins the app accepts. Defaults to [\"trusted\"]." },
        "tools": { "type": "array", "items": { "type": "string" }, "description": "Allowlist of kernel catalog tool names the app may expose to the model." }
      }
    },
    "aiBudget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "monthly_units": { "type": "integer", "minimum": 0, "description": "Abstract billing units per period. 0 disables enforcement." }
      }
    },
    "session": {
      "type": "object",
      "description": "Long-lived MCP server the app launches for stateful, agent-driven tool calls.",
      "additionalProperties": true,
      "properties": {
        "entry": { "type": "string", "description": "MCP server entry file relative to the app dir. Defaults to the runtime's server entry." },
        "transport": { "type": "string", "enum": ["stdio"], "description": "Wire protocol. Only stdio is supported today." },
        "tools": { "type": "array", "items": { "$ref": "#/$defs/sessionTool" }, "description": "Tools advertised through this session (authoritative allowlist)." }
      }
    },
    "sessionTool": {
      "type": "object",
      "description": "One MCP-callable tool. Mirrors operation: args + needs drive the model's view and the kernel's enforcement.",
      "required": ["name", "summary"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$", "description": "Globally unique tool name; convention <app_id>.<verb> (e.g. kv.get)." },
        "summary": { "$ref": "#/$defs/localizedText" },
        "args": {
          "type": "array",
          "not": {
            "allOf": [
              { "contains": { "$ref": "#/$defs/optionalPositionalGap" } },
              { "contains": { "$ref": "#/$defs/defaultedPositional" } }
            ]
          },
          "items": {
            "$ref": "#/$defs/arg",
            "not": {
              "anyOf": [
                { "required": ["default_from"] },
                { "required": ["trusted_resolver"] },
                { "required": ["aliases"] },
                { "required": ["positional_alias"] }
              ]
            }
          }
        },
        "needs": { "type": "array", "items": { "$ref": "#/$defs/need" } }
      }
    },
    "desktop": {
      "type": "object",
      "description": "Desktop GUI surface. Drives generation of /usr/share/applications/com.clawos.<Id>.desktop at install time.",
      "additionalProperties": true,
      "properties": {
        "exec": { "type": "string", "description": "Command/args appended after `cos app <id>` in the generated Exec line. Defaults to \"--gui\". The kernel always routes launch through `cos app` so the GUI inherits the app's identity." },
        "name": { "$ref": "#/$defs/localizedText", "description": "Display name for the launcher entry. Defaults to the manifest name." },
        "icon": { "type": "string", "description": "Icon name (XDG icon theme) or path for the .desktop Icon= field. Defaults to com.clawos.<Id>." },
        "categories": { "type": "array", "items": { "type": "string" }, "description": "XDG menu categories (e.g. [\"Utility\"]). ClawOS is always prepended." },
        "mime_types": { "type": "array", "items": { "type": "string" }, "description": "MIME types this app can open (generates MimeType= + file associations)." },
        "single_instance": { "type": "boolean", "description": "If true, the launcher reuses a running instance instead of spawning a new one." },
        "panel_applet": { "type": "boolean", "description": "If true, the GUI is intentionally hosted by cosmic-panel and may inherit its restricted Wayland socket and layout environment." }
      }
    }
  }
}
