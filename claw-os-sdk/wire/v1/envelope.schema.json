{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-os.dev/wire/v1/envelope.schema.json",
  "title": "Envelope",
  "description": "Common wrapper around every wire v1 reply requested with `cos --wire=1`.",
  "type": "object",
  "required": ["ok", "wire_version"],
  "additionalProperties": false,
  "properties": {
    "ok": { "type": "boolean", "description": "true iff the kernel accepted and dispatched the call." },
    "wire_version": { "type": "integer", "const": 1 },
    "audit_id": { "type": "string", "description": "Audit log entry id (ULID)." },
    "data": { "description": "Request-specific success payload. See the per-family schema for shape.", "type": "object" },
    "error": { "type": "string", "minLength": 1, "description": "Human-readable error summary. Present only when ok is false." },
    "code": { "type": "string", "minLength": 1, "description": "Stable error code from wire/v1/error_codes.md." },
    "detail": { "type": "object", "description": "Request-specific error payload." }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["ok", "wire_version", "data"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": true },
        "wire_version": { "type": "integer", "const": 1 },
        "audit_id": { "type": "string" },
        "data": { "type": "object" }
      }
    },
    {
      "type": "object",
      "required": ["ok", "wire_version", "error", "code"],
      "additionalProperties": false,
      "properties": {
        "ok": { "const": false },
        "wire_version": { "type": "integer", "const": 1 },
        "audit_id": { "type": "string" },
        "error": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "object" }
      }
    }
  ]
}
