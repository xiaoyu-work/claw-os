{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-os.dev/wire/v1/tool.schema.json",
  "title": "Catalog tool invocation reply",
  "description": "Shape returned by `cos ai tool <name> --app <id> --args '<json>'`.",
  "type": "object",
  "required": ["tool", "app_id", "status", "result"],
  "additionalProperties": true,
  "properties": {
    "tool": {
      "type": "string",
      "description": "Catalog tool name."
    },
    "app_id": {
      "type": "string",
      "description": "App identity under which the tool ran."
    },
    "status": {
      "type": "string",
      "enum": ["ok"],
      "description": "Execution status. Denials are returned as errors, not ToolResult values."
    },
    "result": {
      "description": "Tool-specific JSON result."
    }
  }
}
