+use super::ExitFrontend;
+
+const THREAD_ID: &str = "12345678-1234-8123-8123-123456789abc";
+
+fn upstream_command() -> Vec<String> {
+    ["codex", "--remote", "unix:///run/cos-ui/retired.sock"]
+        .into_iter()
+        .map(str::to_string)
+        .collect()
+}
+
+#[test]
+fn claw_hint_resumes_conversation_without_the_private_endpoint() {
+    let frontend = ExitFrontend::from_marker(Some("1"));
+    assert_eq!(
+        frontend.reconnect_command(upstream_command(), THREAD_ID),
+        ["cos", "agent", "chat", "--session", THREAD_ID].map(str::to_string),
+    );
+}
+
+#[test]
+fn absent_or_other_marker_preserves_upstream_remote_command() {
+    for marker in [None, Some("0"), Some("true"), Some(" 1")] {
+        let frontend = ExitFrontend::from_marker(marker);
+        assert_eq!(
+            frontend.reconnect_command(upstream_command(), THREAD_ID),
+            [
+                "codex",
+                "--remote",
+                "unix:///run/cos-ui/retired.sock",
+                "resume",
+                THREAD_ID
+            ]
+            .map(str::to_string),
+        );
+    }
+}
+
+#[test]
+fn plain_session_hints_keep_codex_unless_explicitly_marked() {
+    let base = vec!["codex".to_string()];
+    assert_eq!(
+        ExitFrontend::Codex.reconnect_command(base.clone(), THREAD_ID),
+        ["codex", "resume", THREAD_ID].map(str::to_string),
+    );
+    assert_eq!(
+        ExitFrontend::Claw.reconnect_command(base, THREAD_ID),
+        ["cos", "agent", "chat", "--session", THREAD_ID].map(str::to_string),
+    );
+}
+
+#[test]
+fn claw_stop_hint_uses_resume_then_escape() {
+    assert_eq!(
+        ExitFrontend::Claw.stop_message("cos agent chat --session ID", "retired socket", "press X"),
+        "Stop the current turn: resume this conversation with cos agent chat --session ID, then press Esc.",
+    );
+}
+
+#[test]
+fn unflagged_stop_hint_preserves_formatted_command_and_keymap() {
+    assert_eq!(
+        ExitFrontend::Codex.stop_message(
+            "unused",
+            "\u{1b}[36mcodex agents\u{1b}[39m",
+            "press Ctrl+X"
+        ),
+        "Stop the current turn: run \u{1b}[36mcodex agents\u{1b}[39m, select this task, and press Ctrl+X.",
+    );
+}
