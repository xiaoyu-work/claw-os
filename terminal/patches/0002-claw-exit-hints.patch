@@ -0,0 +1,50 @@
+//! Claw OS presentation policy for exit hints; never backend or authority selection.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ExitFrontend {
+    Codex,
+    Claw,
+}
+
+impl ExitFrontend {
+    pub(crate) fn from_marker(marker: Option<&str>) -> Self {
+        match marker {
+            Some("1") => Self::Claw,
+            _ => Self::Codex,
+        }
+    }
+
+    pub(crate) fn reconnect_command(
+        self,
+        mut upstream: Vec<String>,
+        thread_id: &str,
+    ) -> Vec<String> {
+        match self {
+            Self::Codex => {
+                upstream.extend(["resume".to_string(), thread_id.to_string()]);
+                upstream
+            }
+            Self::Claw => ["cos", "agent", "chat", "--session", thread_id]
+                .into_iter()
+                .map(str::to_string)
+                .collect(),
+        }
+    }
+
+    pub(crate) fn stop_message(self, resume: &str, agents: &str, shortcut: &str) -> String {
+        match self {
+            Self::Codex => {
+                format!("Stop the current turn: run {agents}, select this task, and {shortcut}.")
+            }
+            Self::Claw => {
+                format!(
+                    "Stop the current turn: resume this conversation with {resume}, then press Esc."
+                )
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "frontend_tests.rs"]
+mod tests;
