    "expected_findings": ["failed-systemd-units", "journal-errors"]
  },
  {
    "name": "oom-crash",
    "args": ["--domain", "crash", "the app was killed"],
    "responses": {
      "coredumps": {"count": 1, "coredumps": [{"exe": "/usr/bin/demo"}]},
      "journal": {"count": 1, "entries": [{"message": "demo exited"}]},
      "dmesg": {
        "entries": [{"raw": "Out of memory: Killed process 42 (demo)"}],
        "count": 1
      },
      "resources": {
        "memory": {"total_mb": 16000, "available_mb": 9000},
        "disk": {"total_mb": 100000, "free_mb": 60000}
      }
    },
    "expected_domain": "crash",
    "expected_status": "warn",
    "expected_findings": ["recent-coredumps", "kernel-oom"]
  },
  {
