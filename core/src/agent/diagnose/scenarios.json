[
  {
    "name": "critical-memory-pressure",
    "args": ["--quick", "--domain", "performance", "system is out of memory"],
    "responses": {
      "resources": {
        "memory": {"total_mb": 16000, "available_mb": 700},
        "disk": {"total_mb": 100000, "free_mb": 60000}
      },
      "loadavg": {"load_per_core_1min": 0.6},
      "top:cpu": {"processes": []},
      "top:mem": {"processes": [{"pid": 42, "name": "worker", "rss_mb": 12000}]},
      "cgroup": {},
      "sensors": {}
    },
    "expected_domain": "performance",
    "expected_status": "critical",
    "expected_findings": ["memory-critical"],
    "forbidden_findings": ["disk-critical"]
  },
  {
    "name": "critical-disk-space",
    "args": ["--quick", "--domain", "storage", "disk is full"],
    "responses": {
      "resources": {
        "memory": {"total_mb": 16000, "available_mb": 8000},
        "disk": {"total_mb": 100000, "free_mb": 4000}
      },
      "mounts": {"mounts": []}
    },
    "expected_domain": "storage",
    "expected_status": "critical",
    "expected_findings": ["disk-critical"],
    "forbidden_findings": ["memory-critical"]
  },
  {
    "name": "cpu-saturation",
    "args": ["--quick", "--domain", "performance", "computer is slow"],
    "responses": {
      "resources": {
        "memory": {"total_mb": 16000, "available_mb": 8000},
        "disk": {"total_mb": 100000, "free_mb": 60000}
      },
      "loadavg": {"load_per_core_1min": 2.4},
      "top:cpu": {
        "processes": [{"pid": 900, "name": "renderer", "cpu_percent": 175.0, "rss_mb": 900}]
      },
      "top:mem": {"processes": []},
      "cgroup": {},
      "sensors": {}
    },
    "expected_domain": "performance",
    "expected_status": "critical",
    "expected_findings": ["load-critical", "cpu-hot-process"]
  },
  {
    "name": "failed-systemd-service",
    "args": ["--domain", "service", "the service will not start"],
    "responses": {
      "failed_units": {"count": 2, "units": [{"unit": "demo.service"}]},
